# =====================================================================
# Repository root: ignore everything by default.
# Stray files dropped at the root (test logs, scratch output, etc.) must
# NOT be accidentally committed. Only the project files/dirs explicitly
# un-ignored below are tracked. To track a new top-level entry, add an
# explicit `!/<name>` (files) or `!/<name>/` (dirs) line here.
# =====================================================================
/*
!/.gitignore
!/.github/
!/.claude/
!/LICENSE
!/NOTICE
!/README.md
!/README.zh.md
!/VERSIONS.md
!/progress.md
!/pyproject.toml
!/tianluo.example.yaml
!/tianluo.yaml
!/docs/
!/scripts/
!/tianluo/
!/tianluo/
!/src/
!/tests/

# --- Global ignore patterns (apply at any depth) ---
node_modules/
.DS_Store
*.swp
*.swo
__pycache__/
*.pyc
.pytest_cache/
.worktrees/
.collab/
*.egg-info/
human-calls/
issues.md
prompts/
# But the built-in preset prompts shipped as package data MUST be tracked
# (the broad `prompts/` rule above would otherwise swallow them, so the
# root-cause doc-sync fix could never be committed/shipped).
!/src/tianluo/templates/prompts/

# There used to be a bare `e2e` rule here, matching *any* path component named
# `e2e`. It was removed because it swallowed the e2e subsystem's source package
# and its tests wholesale — they could never be committed, and the wheel would
# have shipped without the framework code the extra is explicitly NOT supposed
# to gate. Scratch `e2e/` directories at the repo root stay ignored by the `/*`
# rule at the top of this file, so nothing was lost. These two whitelists are
# kept as an explicit guard: they pin the intent, so re-adding a broad `e2e`
# rule cannot silently untrack the subsystem again.
!/src/tianluo/e2e/
!/tests/e2e/
materials

# tianluo runtime dir (post-rename layout): ignore runtime content,
# whitelist committed artifacts. Mirrors the legacy /tianluo/* block below so
# `luo migrate run rename-to-tianluo` on this repo needs no gitignore edit.
/tianluo/*
!/tianluo/code-index.md
!/tianluo/charter.md
!/tianluo/issues/
!/tianluo/scripts/
!/tianluo/prompts/
# Flow-authored e2e content (services topology, build steps, scenarios and the
# baseline screenshots tier-2 diffs compare against). It is a committed asset
# like charter/issues, not runtime state: without this whitelist `luo e2e
# bootstrap` on this very repository would write files git silently refuses to
# track, and a baseline image could never enter version control at all.
!/tianluo/e2e/
!/tianluo/version-rules.md
!/tianluo/version-intents/

# SE3: ignore runtime content, whitelist committed artifacts (legacy layout)
/tianluo/*
!/tianluo/code-index.md
!/tianluo/charter.md
!/tianluo/issues/
!/tianluo/scripts/
!/tianluo/prompts/
!/tianluo/e2e/
!/tianluo/version-rules.md
# Version-reconcile intent metadata: written by a worktree session's commit
# step and committed on the flow branch so the merge-side reconcile step can
# read every merged-in branch's intent from master. Must be tracked, unlike
# the rest of tianluo/state runtime content that /tianluo/* ignores.
!/tianluo/version-intents/
tmp*.prompt

# SE3 session file
.claude/.session.json

# tianluo local/live project config (not checked in; tianluo.example.yaml
# is the shipped reference). Legacy se3.* names honoured through 12.x.
tianluo.local.yaml
tianluo.local.yaml
src/tianluo/__pycache__/
*.egg-info/

# Userspace-installed system libraries for the headless-browser acceptance
# test (populated by scripts/install_browser_test_libs.sh on no-root hosts).
.browser-libs/
