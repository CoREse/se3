#!/usr/bin/env python3
"""SE3 Version Script Interface.

This script provides a unified interface for version management operations.
It supports three commands: get, bump, and set.

Output contract:
  - Success: print version string to stdout (e.g., "1.2.3"), exit code 0
  - Failure: print error message to stderr, exit code 1

Usage:
  python version.py get
  python version.py bump --type minor
  python version.py set --version 1.2.3
"""

import argparse
import re
import sys


def read_version() -> str:
    """Read the current version from the project's version source.

    TODO: Implement this function for your project.
    Read the version from the single authoritative source (e.g., pyproject.toml,
    package.json, Cargo.toml, etc.) and return it as a string.

    Returns:
        Version string (e.g., "1.2.3")

    Raises:
        RuntimeError: If version cannot be read
    """
    raise NotImplementedError("read_version() must be implemented for your project")


def write_version(version: str) -> None:
    """Write the version to the project's version source.

    TODO: Implement this function for your project.
    Write the version to the single authoritative source.

    Args:
        version: Version string to write (e.g., "1.2.3")

    Raises:
        RuntimeError: If version cannot be written
    """
    raise NotImplementedError("write_version() must be implemented for your project")


def bump_version(current: str, bump_type: str) -> str:
    """Calculate the next version based on bump type.

    Args:
        current: Current version string (e.g., "1.2.3")
        bump_type: One of "major", "minor", "patch"

    Returns:
        New version string
    """
    match = re.match(r'^(\d+)\.(\d+)\.(\d+)', current)
    if not match:
        raise ValueError(f"Invalid version format: {current}")

    major, minor, patch = int(match.group(1)), int(match.group(2)), int(match.group(3))

    if bump_type == "major":
        major += 1
        minor = 0
        patch = 0
    elif bump_type == "minor":
        minor += 1
        patch = 0
    elif bump_type == "patch":
        patch += 1
    else:
        raise ValueError(f"Invalid bump type: {bump_type}. Must be major, minor, or patch")

    return f"{major}.{minor}.{patch}"


def cmd_get(args: argparse.Namespace) -> None:
    """Handle the 'get' command."""
    try:
        version = read_version()
        print(version)
    except Exception as e:
        print(f"Error reading version: {e}", file=sys.stderr)
        sys.exit(1)


def cmd_bump(args: argparse.Namespace) -> None:
    """Handle the 'bump' command."""
    try:
        current = read_version()
        new_version = bump_version(current, args.type)
        write_version(new_version)
        print(new_version)
    except Exception as e:
        print(f"Error bumping version: {e}", file=sys.stderr)
        sys.exit(1)


def cmd_set(args: argparse.Namespace) -> None:
    """Handle the 'set' command."""
    try:
        write_version(args.version)
        print(args.version)
    except Exception as e:
        print(f"Error setting version: {e}", file=sys.stderr)
        sys.exit(1)


def main() -> None:
    parser = argparse.ArgumentParser(description="SE3 Version Management Script")
    subparsers = parser.add_subparsers(dest="command", required=True)

    # get command
    subparsers.add_parser("get", help="Get current version")

    # bump command
    bump_parser = subparsers.add_parser("bump", help="Bump version")
    bump_parser.add_argument(
        "--type", required=True, choices=["major", "minor", "patch"],
        help="Type of version bump"
    )

    # set command
    set_parser = subparsers.add_parser("set", help="Set version explicitly")
    set_parser.add_argument(
        "--version", required=True,
        help="Version string to set (e.g., 1.2.3)"
    )

    args = parser.parse_args()

    if args.command == "get":
        cmd_get(args)
    elif args.command == "bump":
        cmd_bump(args)
    elif args.command == "set":
        cmd_set(args)


if __name__ == "__main__":
    main()
