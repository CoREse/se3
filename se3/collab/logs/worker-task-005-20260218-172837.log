{"type":"user","message":{"role":"user","content":[{"tool_use_id":"tool_3cioxRZoKNGw3mc84ZH3YIMm","type":"tool_result","content":"     1→\"\"\"SE 3.0 CLI - Main entry point for se3 commands.\"\"\"\n     2→\n     3→import json\n     4→from pathlib import Path\n     5→from typing import Optional\n     6→\n     7→import typer\n     8→\n     9→from . import __version__, SE3_FRAMEWORK_VERSION\n    10→\n    11→def get_framework_version() -> str:\n    12→    \"\"\"Get current framework version from single source of truth (direct file read for git worktree compatibility).\"\"\"\n    13→    import os\n    14→    from pathlib import Path\n    15→    import re\n    16→\n    17→    # Get the path to __init__.py in the current working tree\n    18→    init_file = Path(__file__).parent / \"__init__.py\"\n    19→    if not init_file.exists():\n    20→        raise FileNotFoundError(f\"Cannot find se3_tools __init__.py at {init_file}\")\n    21→\n    22→    with open(init_file, \"r\", encoding=\"utf-8\") as f:\n    23→        content = f.read()\n    24→\n    25→    match = re.search(r'SE3_FRAMEWORK_VERSION\\s*=\\s*\"([\\d]+\\.[\\d]+\\.[\\d]+)\"', content)\n    26→    if not match:\n    27→        raise ValueError(\"Cannot find SE3_FRAMEWORK_VERSION definition in __init__.py\")\n    28→\n    29→    return match.group(1)\n    30→from .commands import lint, status, sync, verify, update, collab, commit\n    31→from .commands.update import get_installed_se3_version\n    32→from .commands.init import initialize_project\n    33→\n    34→app = typer.Typer(\n    35→    name=\"se3\",\n    36→    help=\"SE 3.0 framework CLI tools\",\n    37→    invoke_without_command=True,\n    38→)\n    39→\n    40→def _version_callback(value: bool):\n    41→    \"\"\"Handle --version flag.\"\"\"\n    42→    if value:\n    43→        typer.echo(f\"se3 CLI version: {__version__}\")\n    44→        typer.echo(f\"SE3 Framework version: {get_framework_version()}\")\n    45→        try:\n    46→            installed = get_installed_se3_version()\n    47→            if installed != \"0.0.0\":\n    48→                typer.echo(f\"Project SE3 version: {installed}\")\n    49→        except Exception:\n    50→            pass\n    51→        raise typer.Exit()\n    52→\n    53→@app.callback()\n    54→def main(\n    55→    ctx: typer.Context,\n    56→    version: bool = typer.Option(\n    57→        False, \"--version\", \"-v\", help=\"Show version information\", callback=_version_callback, is_eager=True\n    58→    ),\n    59→):\n    60→    \"\"\"SE 3.0 framework CLI tools.\"\"\"\n    61→    if ctx.invoked_subcommand is None:\n    62→        typer.echo(ctx.get_help())\n    63→        raise typer.Exit()\n    64→\n    65→\n    66→# Register direct commands\n    67→@app.command(name=\"init\")\n    68→def init_cmd(\n    69→    force: bool = typer.Option(False, \"--force\", \"-f\", help=\"Reinitialize even if already initialized\"),\n    70→    offline: bool = typer.Option(False, \"--offline\", \"-o\", help=\"Use local templates without network\"),\n    71→    with_config: bool = typer.Option(False, \"--with-config\", \"-c\", help=\"Create se3.config.yaml\"),\n    72→    se3_version: str = typer.Option(SE3_FRAMEWORK_VERSION, \"--se3-version\", \"-v\", help=\"Specify SE3 version to use\"),\n    73→):\n    74→    \"\"\"Initialize a new SE 3.0 project.\"\"\"\n    75→    try:\n    76→        initialize_project(force, offline, with_config, se3_version)\n    77→    except Exception as e:\n    78→        typer.echo(\n    79→            typer.style(\n    80→                f\"Error during initialization: {str(e)}\",\n    81→                fg=typer.colors.RED,\n    82→            )\n    83→        )\n    84→        raise typer.Exit(1)\n    85→\n    86→# Register sub-typer commands (complex multi-command tools)\n    87→app.add_typer(lint.app, name=\"lint\", help=\"Lint OpenSpec files\")\n    88→app.add_typer(status.app, name=\"status\", help=\"Check project status\")\n    89→app.add_typer(sync.app, name=\"sync\", help=\"Sync output files\")\n    90→app.add_typer(verify.app, name=\"verify\", help=\"Verify spec coverage\")\n    91→app.add_typer(update.app, name=\"update\", help=\"Update SE 3.0 framework to latest version\")\n    92→app.add_typer(collab.app, name=\"collab\", help=\"Manage git-worktree multi-agent collaboration\")\n    93→app.add_typer(commit.app, name=\"commit\", help=\"Commit changes with SE3 verification\")\n    94→\n    95→# Register direct commands (simple single-command tools with positional args)\n    96→# These are registered as direct commands to avoid sub-typer nesting issues\n    97→@app.command(name=\"start\")\n    98→def start_cmd(\n    99→    format: str = typer.Option(\"text\", \"--format\", \"-f\", help=\"Output format (text or json)\"),\n   100→    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n   101→):\n   102→    \"\"\"Start an SE3 session — compute state and return actions for the agent.\"\"\"\n   103→    from .commands.start import run_session_start, print_text_report, print_json_report\n   104→    import json\n   105→    state = run_session_start(project_root)\n   106→    if format == \"json\":\n   107→        print_json_report(state)\n   108→    else:\n   109→        print_text_report(state)\n   110→    raise typer.Exit(code=0 if not state.get(\"actions\") else 1)\n   111→\n   112→@app.command(name=\"work\")\n   113→def work_cmd(\n   114→    change_name: Optional[str] = typer.Argument(None, help=\"Name of the change to work on\"),\n   115→    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n   116→    new: Optional[str] = typer.Option(None, \"--new\", help=\"Create new change with workflow type (bugfix/feature/review/directive)\"),\n   117→    advance: bool = typer.Option(False, \"--advance\", \"-a\", help=\"Mark current step complete and advance to next\"),\n   118→    format: str = typer.Option(\"text\", \"--format\", \"-f\", help=\"Output format (text or json)\"),\n   119→):\n   120→    \"\"\"Start or continue working on a change — the SDD workflow driver.\"\"\"\n   121→    from .commands.work import run_work, print_text_report, print_json_report\n   122→    result = run_work(project_root, change_name, new, advance)\n   123→    if format == \"json\":\n   124→        print_json_report(result)\n   125→    else:\n   126→        print_text_report(result)\n   127→    raise typer.Exit(code=0 if result.get(\"change\") else 1)\n   128→\n   129→@app.command(name=\"done\")\n   130→def done_cmd(\n   131→    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n   132→    format: str = typer.Option(\"text\", \"--format\", \"-f\", help=\"Output format (text or json)\"),\n   133→):\n   134→    \"\"\"End an SE3 session — compute shutdown actions for the agent.\"\"\"\n   135→    from .commands.done import run_session_done, print_text_report, print_json_report\n   136→    state = run_session_done(project_root)\n   137→    if format == \"json\":\n   138→        print_json_report(state)\n   139→    else:\n   140→        print_text_report(state)\n   141→    raise typer.Exit(code=0)\n   142→\n   143→def _full_cycle_cmd_impl(\n   144→    description: str,\n   145→    project_root: str,\n   146→    quick: bool,\n   147→    format: str,\n   148→):\n   149→    \"\"\"Implementation of full-cycle command.\"\"\"\n   150→    from .commands.fullcycle import run_full_cycle, print_text_report as fullcycle_print_text, print_json_report as fullcycle_print_json\n   151→    result = run_full_cycle(description, project_root, quick)\n   152→    if format == \"json\":\n   153→        fullcycle_print_json(result)\n   154→    else:\n   155→        fullcycle_print_text(result)\n   156→    raise typer.Exit(code=0 if result.get(\"success\") else 1)\n   157→\n   158→\n   159→@app.command(name=\"full-cycle\")\n   160→def full_cycle_cmd(\n   161→    description: str = typer.Argument(..., help=\"Description of the work to do\"),\n   162→    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n   163→    quick: bool = typer.Option(False, \"--quick\", \"-q\", help=\"Quick mode - skip formal change creation, use 'small' workflow\"),\n   164→    format: str = typer.Option(\"text\", \"--format\", \"-f\", help=\"Output format (text or json)\"),\n   165→):\n   166→    \"\"\"Run the complete start-work-done workflow in one command.\n   167→\n   168→    This command streamlines simple/quick tasks by combining:\n   169→    1. se3 start - Initialize the session\n   170→    2. se3 work --new - Create a change for the work\n   171→    3. Implementation (performed by agent)\n   172→    4. se3 done - Complete the session\n   173→\n   174→    Examples:\n   175→        se3 full-cycle \"fix login bug\"\n   176→        se3 full-cycle \"add user profile page\" --quick\n   177→        se3 full-cycle \"update documentation\" -q --json\n   178→    \"\"\"\n   179→    _full_cycle_cmd_impl(description, project_root, quick, format)\n   180→\n   181→\n   182→@app.command(name=\"fc\")\n   183→def fc_cmd(\n   184→    description: str = typer.Argument(..., help=\"Description of the work to do\"),\n   185→    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n   186→    quick: bool = typer.Option(False, \"--quick\", \"-q\", help=\"Quick mode - skip formal change creation, use 'small' workflow\"),\n   187→    format: str = typer.Option(\"text\", \"--format\", \"-f\", help=\"Output format (text or json)\"),\n   188→):\n   189→    \"\"\"Alias for 'full-cycle' - Run the complete start-work-done workflow in one command.\"\"\"\n   190→    _full_cycle_cmd_impl(description, project_root, quick, format)\n   191→\n   192→# Register handoff as a direct command (not a sub-typer)\n   193→@app.command(name=\"handoff\")\n   194→def handoff_cmd(\n   195→    message: Optional[str] = typer.Argument(None, help=\"Handoff message describing what was done\"),\n   196→    project_root: Optional[str] = typer.Option(None, \"--project-root\", \"-p\", help=\"Project root directory\"),\n   197→    dry_run: bool = typer.Option(False, \"--dry-run\", help=\"Preview what would happen without executing\"),\n   198→    skip_commit: bool = typer.Option(False, \"--skip-commit\", help=\"Skip automatic commit (use with caution)\"),\n   199→):\n   200→    \"\"\"Handoff control to human — enforcing SE3 commit-before-handoff rule.\"\"\"\n   201→    from .commands.handoff import handoff\n   202→    handoff(message=message, project_root=project_root, dry_run=dry_run, skip_commit=skip_commit)\n   203→\n   204→\n   205→@app.command(name=\"claude-cmd\")\n   206→def claude_cmd(\n   207→    all_cmds: bool = typer.Option(False, \"--all\", help=\"Output all commands as JSON sorted by priority\"),\n   208→    next_after: Optional[str] = typer.Option(None, \"--next\", help=\"Output the next command after the given one\"),\n   209→    project_root: Optional[str] = typer.Option(None, \"--project-root\", \"-p\", help=\"Project root directory\"),\n   210→):\n   211→    \"\"\"Show configured Claude commands by priority.\n   212→\n   213→    Used by bash scripts to resolve which Claude command to use.\n   214→    \"\"\"\n   215→    from .config import load_claude_commands\n   216→\n   217→    root = Path(project_root) if project_root else Path.cwd()\n   218→    commands = load_claude_commands(root)\n   219→\n   220→    if all_cmds:\n   221→        typer.echo(json.dumps(commands))\n   222→    elif next_after:\n   223→        found = False\n   224→        for i, entry in enumerate(commands):\n   225→            if entry[\"cmd\"] == next_after:\n   226→                if i + 1 < len(commands):\n   227→                    typer.echo(commands[i + 1][\"cmd\"])\n   228→                else:\n   229→                    typer.echo(\"\")  # No next command\n   230→                found = True\n   231→                break\n   232→        if not found:\n   233→            typer.echo(\"\")  # Command not in list\n   234→    else:\n   235→        # Default: output highest-priority command\n   236→        typer.echo(commands[0][\"cmd\"])\n   237→\n   238→\n   239→if __name__ == \"__main__\":\n   240→    app()\n   241→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"fda141f5-a3a9-4f60-9302-36b25383cb2b","uuid":"4598462d-6a60-402e-acc7-49b54d5c377a","tool_use_result":{"type":"text","file":{"filePath":"/data/cre/workspace/se3.0/.worktrees/human-input-methods/tools/se3_tools/cli.py","content":"\"\"\"SE 3.0 CLI - Main entry point for se3 commands.\"\"\"\n\nimport json\nfrom pathlib import Path\nfrom typing import Optional\n\nimport typer\n\nfrom . import __version__, SE3_FRAMEWORK_VERSION\n\ndef get_framework_version() -> str:\n    \"\"\"Get current framework version from single source of truth (direct file read for git worktree compatibility).\"\"\"\n    import os\n    from pathlib import Path\n    import re\n\n    # Get the path to __init__.py in the current working tree\n    init_file = Path(__file__).parent / \"__init__.py\"\n    if not init_file.exists():\n        raise FileNotFoundError(f\"Cannot find se3_tools __init__.py at {init_file}\")\n\n    with open(init_file, \"r\", encoding=\"utf-8\") as f:\n        content = f.read()\n\n    match = re.search(r'SE3_FRAMEWORK_VERSION\\s*=\\s*\"([\\d]+\\.[\\d]+\\.[\\d]+)\"', content)\n    if not match:\n        raise ValueError(\"Cannot find SE3_FRAMEWORK_VERSION definition in __init__.py\")\n\n    return match.group(1)\nfrom .commands import lint, status, sync, verify, update, collab, commit\nfrom .commands.update import get_installed_se3_version\nfrom .commands.init import initialize_project\n\napp = typer.Typer(\n    name=\"se3\",\n    help=\"SE 3.0 framework CLI tools\",\n    invoke_without_command=True,\n)\n\ndef _version_callback(value: bool):\n    \"\"\"Handle --version flag.\"\"\"\n    if value:\n        typer.echo(f\"se3 CLI version: {__version__}\")\n        typer.echo(f\"SE3 Framework version: {get_framework_version()}\")\n        try:\n            installed = get_installed_se3_version()\n            if installed != \"0.0.0\":\n                typer.echo(f\"Project SE3 version: {installed}\")\n        except Exception:\n            pass\n        raise typer.Exit()\n\n@app.callback()\ndef main(\n    ctx: typer.Context,\n    version: bool = typer.Option(\n        False, \"--version\", \"-v\", help=\"Show version information\", callback=_version_callback, is_eager=True\n    ),\n):\n    \"\"\"SE 3.0 framework CLI tools.\"\"\"\n    if ctx.invoked_subcommand is None:\n        typer.echo(ctx.get_help())\n        raise typer.Exit()\n\n\n# Register direct commands\n@app.command(name=\"init\")\ndef init_cmd(\n    force: bool = typer.Option(False, \"--force\", \"-f\", help=\"Reinitialize even if already initialized\"),\n    offline: bool = typer.Option(False, \"--offline\", \"-o\", help=\"Use local templates without network\"),\n    with_config: bool = typer.Option(False, \"--with-config\", \"-c\", help=\"Create se3.config.yaml\"),\n    se3_version: str = typer.Option(SE3_FRAMEWORK_VERSION, \"--se3-version\", \"-v\", help=\"Specify SE3 version to use\"),\n):\n    \"\"\"Initialize a new SE 3.0 project.\"\"\"\n    try:\n        initialize_project(force, offline, with_config, se3_version)\n    except Exception as e:\n        typer.echo(\n            typer.style(\n                f\"Error during initialization: {str(e)}\",\n                fg=typer.colors.RED,\n            )\n        )\n        raise typer.Exit(1)\n\n# Register sub-typer commands (complex multi-command tools)\napp.add_typer(lint.app, name=\"lint\", help=\"Lint OpenSpec files\")\napp.add_typer(status.app, name=\"status\", help=\"Check project status\")\napp.add_typer(sync.app, name=\"sync\", help=\"Sync output files\")\napp.add_typer(verify.app, name=\"verify\", help=\"Verify spec coverage\")\napp.add_typer(update.app, name=\"update\", help=\"Update SE 3.0 framework to latest version\")\napp.add_typer(collab.app, name=\"collab\", help=\"Manage git-worktree multi-agent collaboration\")\napp.add_typer(commit.app, name=\"commit\", help=\"Commit changes with SE3 verification\")\n\n# Register direct commands (simple single-command tools with positional args)\n# These are registered as direct commands to avoid sub-typer nesting issues\n@app.command(name=\"start\")\ndef start_cmd(\n    format: str = typer.Option(\"text\", \"--format\", \"-f\", help=\"Output format (text or json)\"),\n    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n):\n    \"\"\"Start an SE3 session — compute state and return actions for the agent.\"\"\"\n    from .commands.start import run_session_start, print_text_report, print_json_report\n    import json\n    state = run_session_start(project_root)\n    if format == \"json\":\n        print_json_report(state)\n    else:\n        print_text_report(state)\n    raise typer.Exit(code=0 if not state.get(\"actions\") else 1)\n\n@app.command(name=\"work\")\ndef work_cmd(\n    change_name: Optional[str] = typer.Argument(None, help=\"Name of the change to work on\"),\n    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n    new: Optional[str] = typer.Option(None, \"--new\", help=\"Create new change with workflow type (bugfix/feature/review/directive)\"),\n    advance: bool = typer.Option(False, \"--advance\", \"-a\", help=\"Mark current step complete and advance to next\"),\n    format: str = typer.Option(\"text\", \"--format\", \"-f\", help=\"Output format (text or json)\"),\n):\n    \"\"\"Start or continue working on a change — the SDD workflow driver.\"\"\"\n    from .commands.work import run_work, print_text_report, print_json_report\n    result = run_work(project_root, change_name, new, advance)\n    if format == \"json\":\n        print_json_report(result)\n    else:\n        print_text_report(result)\n    raise typer.Exit(code=0 if result.get(\"change\") else 1)\n\n@app.command(name=\"done\")\ndef done_cmd(\n    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n    format: str = typer.Option(\"text\", \"--format\", \"-f\", help=\"Output format (text or json)\"),\n):\n    \"\"\"End an SE3 session — compute shutdown actions for the agent.\"\"\"\n    from .commands.done import run_session_done, print_text_report, print_json_report\n    state = run_session_done(project_root)\n    if format == \"json\":\n        print_json_report(state)\n    else:\n        print_text_report(state)\n    raise typer.Exit(code=0)\n\ndef _full_cycle_cmd_impl(\n    description: str,\n    project_root: str,\n    quick: bool,\n    format: str,\n):\n    \"\"\"Implementation of full-cycle command.\"\"\"\n    from .commands.fullcycle import run_full_cycle, print_text_report as fullcycle_print_text, print_json_report as fullcycle_print_json\n    result = run_full_cycle(description, project_root, quick)\n    if format == \"json\":\n        fullcycle_print_json(result)\n    else:\n        fullcycle_print_text(result)\n    raise typer.Exit(code=0 if result.get(\"success\") else 1)\n\n\n@app.command(name=\"full-cycle\")\ndef full_cycle_cmd(\n    description: str = typer.Argument(..., help=\"Description of the work to do\"),\n    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n    quick: bool = typer.Option(False, \"--quick\", \"-q\", help=\"Quick mode - skip formal change creation, use 'small' workflow\"),\n    format: str = typer.Option(\"text\", \"--format\", \"-f\", help=\"Output format (text or json)\"),\n):\n    \"\"\"Run the complete start-work-done workflow in one command.\n\n    This command streamlines simple/quick tasks by combining:\n    1. se3 start - Initialize the session\n    2. se3 work --new - Create a change for the work\n    3. Implementation (performed by agent)\n    4. se3 done - Complete the session\n\n    Examples:\n        se3 full-cycle \"fix login bug\"\n        se3 full-cycle \"add user profile page\" --quick\n        se3 full-cycle \"update documentation\" -q --json\n    \"\"\"\n    _full_cycle_cmd_impl(description, project_root, quick, format)\n\n\n@app.command(name=\"fc\")\ndef fc_cmd(\n    description: str = typer.Argument(..., help=\"Description of the work to do\"),\n    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n    quick: bool = typer.Option(False, \"--quick\", \"-q\", help=\"Quick mode - skip formal change creation, use 'small' workflow\"),\n    format: str = typer.Option(\"text\", \"--format\", \"-f\", help=\"Output format (text or json)\"),\n):\n    \"\"\"Alias for 'full-cycle' - Run the complete start-work-done workflow in one command.\"\"\"\n    _full_cycle_cmd_impl(description, project_root, quick, format)\n\n# Register handoff as a direct command (not a sub-typer)\n@app.command(name=\"handoff\")\ndef handoff_cmd(\n    message: Optional[str] = typer.Argument(None, help=\"Handoff message describing what was done\"),\n    project_root: Optional[str] = typer.Option(None, \"--project-root\", \"-p\", help=\"Project root directory\"),\n    dry_run: bool = typer.Option(False, \"--dry-run\", help=\"Preview what would happen without executing\"),\n    skip_commit: bool = typer.Option(False, \"--skip-commit\", help=\"Skip automatic commit (use with caution)\"),\n):\n    \"\"\"Handoff control to human — enforcing SE3 commit-before-handoff rule.\"\"\"\n    from .commands.handoff import handoff\n    handoff(message=message, project_root=project_root, dry_run=dry_run, skip_commit=skip_commit)\n\n\n@app.command(name=\"claude-cmd\")\ndef claude_cmd(\n    all_cmds: bool = typer.Option(False, \"--all\", help=\"Output all commands as JSON sorted by priority\"),\n    next_after: Optional[str] = typer.Option(None, \"--next\", help=\"Output the next command after the given one\"),\n    project_root: Optional[str] = typer.Option(None, \"--project-root\", \"-p\", help=\"Project root directory\"),\n):\n    \"\"\"Show configured Claude commands by priority.\n\n    Used by bash scripts to resolve which Claude command to use.\n    \"\"\"\n    from .config import load_claude_commands\n\n    root = Path(project_root) if project_root else Path.cwd()\n    commands = load_claude_commands(root)\n\n    if all_cmds:\n        typer.echo(json.dumps(commands))\n    elif next_after:\n        found = False\n        for i, entry in enumerate(commands):\n            if entry[\"cmd\"] == next_after:\n                if i + 1 < len(commands):\n                    typer.echo(commands[i + 1][\"cmd\"])\n                else:\n                    typer.echo(\"\")  # No next command\n                found = True\n                break\n        if not found:\n            typer.echo(\"\")  # Command not in list\n    else:\n        # Default: output highest-priority command\n        typer.echo(commands[0][\"cmd\"])\n\n\nif __name__ == \"__main__\":\n    app()\n","numLines":241,"startLine":1,"totalLines":241}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"tool_Dsn2hkmbwNwbfhRdWP5Nx20e","type":"tool_result","content":"     1→\"\"\"Unified configuration loading for SE3.\n     2→\n     3→Supports two-level config:\n     4→- Global: ~/.se3/config.yaml (shared across all projects)\n     5→- Project: se3.config.yaml (project-specific, overrides global)\n     6→\"\"\"\n     7→\n     8→from pathlib import Path\n     9→from typing import Any, Dict, List, Optional\n    10→\n    11→\n    12→def load_global_config() -> Dict[str, Any]:\n    13→    \"\"\"Load global config from ~/.se3/config.yaml.\"\"\"\n    14→    config_file = Path.home() / \".se3\" / \"config.yaml\"\n    15→    if config_file.exists():\n    16→        try:\n    17→            import yaml\n    18→            with open(config_file) as f:\n    19→                return yaml.safe_load(f) or {}\n    20→        except Exception:\n    21→            pass\n    22→    return {}\n    23→\n    24→\n    25→def load_project_config(project_root: Path) -> Dict[str, Any]:\n    26→    \"\"\"Load project config from se3.config.yaml.\"\"\"\n    27→    config_file = project_root / \"se3.config.yaml\"\n    28→    if config_file.exists():\n    29→        try:\n    30→            import yaml\n    31→            with open(config_file) as f:\n    32→                return yaml.safe_load(f) or {}\n    33→        except Exception as e:\n    34→            import sys\n    35→            print(f\"[se3-config] Warning: Failed to parse {config_file}: {e}\", file=sys.stderr)\n    36→            pass\n    37→    return {}\n    38→\n    39→\n    40→def merge_configs(global_cfg: Dict[str, Any], project_cfg: Dict[str, Any]) -> Dict[str, Any]:\n    41→    \"\"\"Merge global and project configs. Project-level overrides global.\n    42→\n    43→    Top-level keys from project_cfg replace global_cfg entirely (no deep merge).\n    44→    \"\"\"\n    45→    merged = dict(global_cfg)\n    46→    merged.update(project_cfg)\n    47→    return merged\n    48→\n    49→\n    50→def load_claude_commands(project_root: Optional[Path] = None) -> List[Dict[str, Any]]:\n    51→    \"\"\"Load and sort claude commands from config.\n    52→\n    53→    Resolution order:\n    54→    1. Project se3.config.yaml claude_commands (if present, replaces global)\n    55→    2. Global ~/.se3/config.yaml claude_commands\n    56→    3. Default: [{cmd: \"claude\", priority: 0}]\n    57→\n    58→    Returns list sorted by priority descending, then list order.\n    59→    \"\"\"\n    60→    global_cfg = load_global_config()\n    61→    project_cfg = load_project_config(project_root) if project_root else {}\n    62→\n    63→    # Project-level claude_commands fully overrides global\n    64→    commands = project_cfg.get(\"claude_commands\") or global_cfg.get(\"claude_commands\")\n    65→\n    66→    if not commands:\n    67→        return [{\"cmd\": \"claude\", \"priority\": 0}]\n    68→\n    69→    # Normalize: ensure each entry has cmd and priority\n    70→    normalized = []\n    71→    for entry in commands:\n    72→        if isinstance(entry, str):\n    73→            normalized.append({\"cmd\": entry, \"priority\": 0})\n    74→        elif isinstance(entry, dict):\n    75→            normalized.append({\n    76→                \"cmd\": entry.get(\"cmd\", \"claude\"),\n    77→                \"priority\": entry.get(\"priority\", 0),\n    78→            })\n    79→\n    80→    if not normalized:\n    81→        return [{\"cmd\": \"claude\", \"priority\": 0}]\n    82→\n    83→    # Sort by priority descending (higher first), stable sort preserves list order for ties\n    84→    normalized.sort(key=lambda x: -x[\"priority\"])\n    85→\n    86→    return normalized\n    87→\n    88→\n    89→def load_human_call_config(project_root: Optional[Path] = None) -> Dict[str, Any]:\n    90→    \"\"\"Load human call configuration from config.\n    91→\n    92→    Resolution order:\n    93→    1. Project se3.config.yaml human_call (if present, overrides global)\n    94→    2. Global ~/.se3/config.yaml human_call\n    95→    3. Default values\n    96→\n    97→    Returns dict with:\n    98→        - language: Language code (default: \"en\")\n    99→        - timeout_days: Async call timeout in days (default: 7)\n   100→        - directory: Human calls directory (default: \"human-calls\")\n   101→    \"\"\"\n   102→    global_cfg = load_global_config()\n   103→    project_cfg = load_project_config(project_root) if project_root else {}\n   104→\n   105→    # Merge human_call configs: project overrides global\n   106→    global_hc = global_cfg.get(\"human_call\", {})\n   107→    project_hc = project_cfg.get(\"human_call\", {})\n   108→\n   109→    merged = dict(global_hc)\n   110→    merged.update(project_hc)\n   111→\n   112→    return {\n   113→        \"language\": merged.get(\"language\", \"en\"),\n   114→        \"timeout_days\": merged.get(\"timeout_days\", 7),\n   115→        \"directory\": merged.get(\"directory\", \"human-calls\"),\n   116→    }\n   117→\n   118→\n   119→def get_language_labels(language: str) -> Dict[str, str]:\n   120→    \"\"\"Get human call template labels for a given language.\n   121→\n   122→    Args:\n   123→        language: Language code (e.g., \"en\", \"zh-CN\", \"zh-TW\")\n   124→\n   125→    Returns dict with localized labels for human call templates.\n   126→    \"\"\"\n   127→    # Normalize language code\n   128→    lang_lower = language.lower()\n   129→\n   130→    # Chinese variants (zh-CN, zh-TW, zh-HK, zh, etc.)\n   131→    if lang_lower.startswith(\"zh\"):\n   132→        return {\n   133→            \"type\": \"类型\",\n   134→            \"urgency\": \"紧急程度\",\n   135→            \"context\": \"上下文\",\n   136→            \"tasks\": \"当前任务状态\",\n   137→            \"response\": \"回复\",\n   138→            \"prompt\": \"<!-- 人类：请在下方输入您的回复 -->\",\n   139→            \"request_prefix\": \"请求\",\n   140→            \"source\": \"来源\",\n   141→        }\n   142→\n   143→    # Default to English\n   144→    return {\n   145→        \"type\": \"Type\",\n   146→        \"urgency\": \"Urgency\",\n   147→        \"context\": \"Context\",\n   148→        \"tasks\": \"Current Task States\",\n   149→        \"response\": \"Response\",\n   150→        \"prompt\": \"<!-- Human: write your response below -->\",\n   151→        \"request_prefix\": \"Request\",\n   152→        \"source\": \"Source\",\n   153→    }\n   154→\n   155→\n   156→def is_chinese_language(language: str) -> bool:\n   157→    \"\"\"Check if the language code is a Chinese variant.\n   158→\n   159→    Args:\n   160→        language: Language code (e.g., \"zh-CN\", \"zh-TW\", \"en-US\")\n   161→\n   162→    Returns True if the language is a Chinese variant.\n   163→    \"\"\"\n   164→    return language.lower().startswith(\"zh\")\n   165→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"fda141f5-a3a9-4f60-9302-36b25383cb2b","uuid":"638c98d0-9435-4d80-88a6-e762aba1c466","tool_use_result":{"type":"text","file":{"filePath":"/data/cre/workspace/se3.0/.worktrees/human-input-methods/tools/se3_tools/config.py","content":"\"\"\"Unified configuration loading for SE3.\n\nSupports two-level config:\n- Global: ~/.se3/config.yaml (shared across all projects)\n- Project: se3.config.yaml (project-specific, overrides global)\n\"\"\"\n\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional\n\n\ndef load_global_config() -> Dict[str, Any]:\n    \"\"\"Load global config from ~/.se3/config.yaml.\"\"\"\n    config_file = Path.home() / \".se3\" / \"config.yaml\"\n    if config_file.exists():\n        try:\n            import yaml\n            with open(config_file) as f:\n                return yaml.safe_load(f) or {}\n        except Exception:\n            pass\n    return {}\n\n\ndef load_project_config(project_root: Path) -> Dict[str, Any]:\n    \"\"\"Load project config from se3.config.yaml.\"\"\"\n    config_file = project_root / \"se3.config.yaml\"\n    if config_file.exists():\n        try:\n            import yaml\n            with open(config_file) as f:\n                return yaml.safe_load(f) or {}\n        except Exception as e:\n            import sys\n            print(f\"[se3-config] Warning: Failed to parse {config_file}: {e}\", file=sys.stderr)\n            pass\n    return {}\n\n\ndef merge_configs(global_cfg: Dict[str, Any], project_cfg: Dict[str, Any]) -> Dict[str, Any]:\n    \"\"\"Merge global and project configs. Project-level overrides global.\n\n    Top-level keys from project_cfg replace global_cfg entirely (no deep merge).\n    \"\"\"\n    merged = dict(global_cfg)\n    merged.update(project_cfg)\n    return merged\n\n\ndef load_claude_commands(project_root: Optional[Path] = None) -> List[Dict[str, Any]]:\n    \"\"\"Load and sort claude commands from config.\n\n    Resolution order:\n    1. Project se3.config.yaml claude_commands (if present, replaces global)\n    2. Global ~/.se3/config.yaml claude_commands\n    3. Default: [{cmd: \"claude\", priority: 0}]\n\n    Returns list sorted by priority descending, then list order.\n    \"\"\"\n    global_cfg = load_global_config()\n    project_cfg = load_project_config(project_root) if project_root else {}\n\n    # Project-level claude_commands fully overrides global\n    commands = project_cfg.get(\"claude_commands\") or global_cfg.get(\"claude_commands\")\n\n    if not commands:\n        return [{\"cmd\": \"claude\", \"priority\": 0}]\n\n    # Normalize: ensure each entry has cmd and priority\n    normalized = []\n    for entry in commands:\n        if isinstance(entry, str):\n            normalized.append({\"cmd\": entry, \"priority\": 0})\n        elif isinstance(entry, dict):\n            normalized.append({\n                \"cmd\": entry.get(\"cmd\", \"claude\"),\n                \"priority\": entry.get(\"priority\", 0),\n            })\n\n    if not normalized:\n        return [{\"cmd\": \"claude\", \"priority\": 0}]\n\n    # Sort by priority descending (higher first), stable sort preserves list order for ties\n    normalized.sort(key=lambda x: -x[\"priority\"])\n\n    return normalized\n\n\ndef load_human_call_config(project_root: Optional[Path] = None) -> Dict[str, Any]:\n    \"\"\"Load human call configuration from config.\n\n    Resolution order:\n    1. Project se3.config.yaml human_call (if present, overrides global)\n    2. Global ~/.se3/config.yaml human_call\n    3. Default values\n\n    Returns dict with:\n        - language: Language code (default: \"en\")\n        - timeout_days: Async call timeout in days (default: 7)\n        - directory: Human calls directory (default: \"human-calls\")\n    \"\"\"\n    global_cfg = load_global_config()\n    project_cfg = load_project_config(project_root) if project_root else {}\n\n    # Merge human_call configs: project overrides global\n    global_hc = global_cfg.get(\"human_call\", {})\n    project_hc = project_cfg.get(\"human_call\", {})\n\n    merged = dict(global_hc)\n    merged.update(project_hc)\n\n    return {\n        \"language\": merged.get(\"language\", \"en\"),\n        \"timeout_days\": merged.get(\"timeout_days\", 7),\n        \"directory\": merged.get(\"directory\", \"human-calls\"),\n    }\n\n\ndef get_language_labels(language: str) -> Dict[str, str]:\n    \"\"\"Get human call template labels for a given language.\n\n    Args:\n        language: Language code (e.g., \"en\", \"zh-CN\", \"zh-TW\")\n\n    Returns dict with localized labels for human call templates.\n    \"\"\"\n    # Normalize language code\n    lang_lower = language.lower()\n\n    # Chinese variants (zh-CN, zh-TW, zh-HK, zh, etc.)\n    if lang_lower.startswith(\"zh\"):\n        return {\n            \"type\": \"类型\",\n            \"urgency\": \"紧急程度\",\n            \"context\": \"上下文\",\n            \"tasks\": \"当前任务状态\",\n            \"response\": \"回复\",\n            \"prompt\": \"<!-- 人类：请在下方输入您的回复 -->\",\n            \"request_prefix\": \"请求\",\n            \"source\": \"来源\",\n        }\n\n    # Default to English\n    return {\n        \"type\": \"Type\",\n        \"urgency\": \"Urgency\",\n        \"context\": \"Context\",\n        \"tasks\": \"Current Task States\",\n        \"response\": \"Response\",\n        \"prompt\": \"<!-- Human: write your response below -->\",\n        \"request_prefix\": \"Request\",\n        \"source\": \"Source\",\n    }\n\n\ndef is_chinese_language(language: str) -> bool:\n    \"\"\"Check if the language code is a Chinese variant.\n\n    Args:\n        language: Language code (e.g., \"zh-CN\", \"zh-TW\", \"en-US\")\n\n    Returns True if the language is a Chinese variant.\n    \"\"\"\n    return language.lower().startswith(\"zh\")\n","numLines":165,"startLine":1,"totalLines":165}}}
