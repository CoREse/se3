03→                    \"message\": f\"Scenario '{scenario_title}' is missing THEN clause\",\n   104→                })\n   105→\n   106→    return results\n   107→\n   108→\n   109→def run_lint(path: str) -> int:\n   110→    \"\"\"\n   111→    Run lint on all specs in the given path.\n   112→\n   113→    Args:\n   114→        path: Base path to search for specs\n   115→\n   116→    Returns:\n   117→        Exit code (0=success, 1=errors, 2=runtime error)\n   118→    \"\"\"\n   119→    try:\n   120→        spec_files = discover_specs(path)\n   121→    except Exception as e:\n   122→        print(f\"Error discovering specs: {e}\")\n   123→        return 2\n   124→\n   125→    if not spec_files:\n   126→        print(f\"No spec files found in {path}\")\n   127→        return 0\n   128→\n   129→    all_results = []\n   130→\n   131→    for spec_file in spec_files:\n   132→        results = validate_spec(spec_file)\n   133→        all_results.extend(results)\n   134→\n   135→    # Print results\n   136→    if all_results:\n   137→        print(f\"Found {len(all_results)} issue(s):\\n\")\n   138→        for result in all_results:\n   139→            level = result[\"level\"].upper()\n   140→            file_path = result[\"file\"]\n   141→            line = result[\"line\"]\n   142→            message = result[\"message\"]\n   143→            print(f\"{level}: {file_path}:{line}: {message}\")\n   144→    else:\n   145→        print(f\"All {len(spec_files)} spec(s) passed validation.\")\n   146→\n   147→    return get_exit_code(all_results)\n   148→\n   149→\n   150→@app.callback()\n   151→def lint(path: str = \".\"):\n   152→    \"\"\"Lint OpenSpec files in the given path.\"\"\"\n   153→    exit_code = run_lint(path)\n   154→    raise typer.Exit(code=exit_code)\n   155→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve