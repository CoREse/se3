{"type":"user","message":{"role":"user","content":[{"tool_use_id":"tool_YGj8oDxhQfMKEos0eHUNpJym","type":"tool_result","content":"     1→\"\"\"Status diagnostics command for SE 3.0 tools.\n     2→\n     3→Computes project status in real-time from:\n     4→- git status / git log (uncommitted changes, recent activity)\n     5→- openspec/changes/ (active changes)\n     6→- .collab/ (collaboration session state)\n     7→- human-calls/ (pending/responded requests)\n     8→\n     9→No longer depends on status.md — all state is computed live.\n    10→\"\"\"\n    11→\n    12→# Verify: status-diagnostics/Compute git status\n    13→# Verify: status-diagnostics/Detect active changes\n    14→# Verify: status-diagnostics/Unprocessed response\n    15→# Verify: status-diagnostics/Long-pending call\n    16→# Verify: status-diagnostics/Healthy project\n    17→# Verify: status-diagnostics/Issues found\n    18→\n    19→import json\n    20→import subprocess\n    21→from pathlib import Path\n    22→from typing import List, Dict, Any, Optional\n    23→from datetime import datetime\n    24→\n    25→from ..utils import discover_changes\n    26→from ..human_calls import HumanCallStore\n    27→\n    28→import typer\n    29→\n    30→app = typer.Typer(invoke_without_command=True)\n    31→\n    32→\n    33→def compute_git_status(project_root: Path) -> Dict[str, Any]:\n    34→    \"\"\"Compute current git state.\n    35→\n    36→    Returns dict with branch, uncommitted changes count, last commit info.\n    37→    \"\"\"\n    38→    info = {\n    39→        \"branch\": \"unknown\",\n    40→        \"uncommitted_count\": 0,\n    41→        \"uncommitted_details\": \"\",\n    42→        \"last_commits\": [],\n    43→    }\n    44→\n    45→    # Branch\n    46→    result = subprocess.run(\n    47→        [\"git\", \"branch\", \"--show-current\"],\n    48→        cwd=project_root, capture_output=True, text=True\n    49→    )\n    50→    if result.returncode == 0:\n    51→        info[\"branch\"] = result.stdout.strip() or \"(detached HEAD)\"\n    52→\n    53→    # Uncommitted changes\n    54→    result = subprocess.run(\n    55→        [\"git\", \"status\", \"--porcelain\"],\n    56→        cwd=project_root, capture_output=True, text=True\n    57→    )\n    58→    if result.returncode == 0 and result.stdout.strip():\n    59→        lines = result.stdout.strip().split(\"\\n\")\n    60→        info[\"uncommitted_count\"] = len(lines)\n    61→        info[\"uncommitted_details\"] = result.stdout.strip()\n    62→\n    63→    # Recent commits\n    64→    result = subprocess.run(\n    65→        [\"git\", \"log\", \"--oneline\", \"-5\"],\n    66→        cwd=project_root, capture_output=True, text=True\n    67→    )\n    68→    if result.returncode == 0 and result.stdout.strip():\n    69→        info[\"last_commits\"] = result.stdout.strip().split(\"\\n\")\n    70→\n    71→    return info\n    72→\n    73→\n    74→def compute_active_changes(project_root: Path) -> List[str]:\n    75→    \"\"\"Find active (non-archived) openspec changes.\"\"\"\n    76→    changes_dir = project_root / \"openspec\" / \"changes\"\n    77→    if not changes_dir.exists():\n    78→        return []\n    79→\n    80→    active = []\n    81→    for item in changes_dir.iterdir():\n    82→        if item.is_dir() and item.name != \"archive\":\n    83→            active.append(item.name)\n    84→    return sorted(active)\n    85→\n    86→\n    87→def compute_collab_status(project_root: Path) -> Optional[Dict[str, Any]]:\n    88→    \"\"\"Compute collaboration session status from .collab/ files.\"\"\"\n    89→    collab_dir = project_root / \".collab\"\n    90→    config_file = collab_dir / \"config.json\"\n    91→\n    92→    if not config_file.exists():\n    93→        return None\n    94→\n    95→    try:\n    96→        config = json.loads(config_file.read_text())\n    97→    except (json.JSONDecodeError, OSError):\n    98→        return {\"status\": \"error\", \"message\": \"Cannot read .collab/config.json\"}\n    99→\n   100→    result = {\n   101→        \"status\": config.get(\"status\", \"unknown\"),\n   102→        \"objective\": config.get(\"objective\", \"\"),\n   103→        \"session_id\": config.get(\"session_id\", \"\"),\n   104→        \"tasks\": [],\n   105→    }\n   106→\n   107→    tasks_dir = collab_dir / \"tasks\"\n   108→    if tasks_dir.exists():\n   109→        for tf in sorted(tasks_dir.glob(\"task-*.json\")):\n   110→            try:\n   111→                task = json.loads(tf.read_text())\n   112→                result[\"tasks\"].append({\n   113→                    \"id\": task.get(\"id\", tf.stem),\n   114→                    \"status\": task.get(\"status\", \"unknown\"),\n   115→                    \"title\": task.get(\"title\", \"\"),\n   116→                })\n   117→            except (json.JSONDecodeError, OSError):\n   118→                continue\n   119→\n   120→    return result\n   121→\n   122→\n   123→def check_human_calls(project_root: Path, timeout_days: int = 7) -> List[Dict[str, Any]]:\n   124→    \"\"\"Check human-calls directory for pending/responded files.\"\"\"\n   125→    issues = []\n   126→    calls_dir = project_root / \"human-calls\"\n   127→\n   128→    if not calls_dir.exists():\n   129→        return issues\n   130→\n   131→    store = HumanCallStore(calls_dir)\n   132→\n   133→    # Stale calls\n   134→    stale_calls = store.get_stale_calls(timeout_days)\n   135→    for call in stale_calls:\n   136→        issues.append({\n   137→            'severity': 'warning',\n   138→            'check': 'human_calls',\n   139→            'message': f\"Long-pending human call: {call.file_path.name} ({call.created.strftime('%Y-%m-%d')})\",\n   140→            'suggestion': \"Follow up on the pending request or close it\"\n   141→        })\n   142→\n   143→    # Fresh pending\n   144→    all_pending = store.get_pending_calls()\n   145→    fresh_pending = [c for c in all_pending if c not in stale_calls]\n   146→    for call in fresh_pending:\n   147→        issues.append({\n   148→            'severity': 'info',\n   149→            'check': 'human_calls',\n   150→            'message': f\"Pending human call: {call.file_path.name}\",\n   151→            'suggestion': \"Awaiting human response\"\n   152→        })\n   153→\n   154→    # Responded\n   155→    responded_calls = store.get_responded_calls()\n   156→    for call in responded_calls:\n   157→        is_valid, reason = store.validate_response(call)\n   158→        if is_valid:\n   159→            issues.append({\n   160→                'severity': 'warning',\n   161→                'check': 'human_calls',\n   162→                'message': f\"Unprocessed response: {call.file_path.name}\",\n   163→                'suggestion': \"Process the response and update the call status\"\n   164→            })\n   165→        else:\n   166→            issues.append({\n   167→                'severity': 'info',\n   168→                'check': 'human_calls',\n   169→                'message': f\"Incomplete response in {call.file_path.name}: {reason}\",\n   170→                'suggestion': \"Wait for human to complete their response\"\n   171→            })\n   172→\n   173→    return issues\n   174→\n   175→\n   176→def run_diagnostics(project_root: str = \".\") -> Dict[str, Any]:\n   177→    \"\"\"Run all diagnostics by computing live state.\n   178→\n   179→    Returns dict with computed status and diagnostic issues.\n   180→    \"\"\"\n   181→    root = Path(project_root).resolve()\n   182→    issues = []\n   183→\n   184→    # Compute live state\n   185→    git_info = compute_git_status(root)\n   186→    active_changes = compute_active_changes(root)\n   187→    collab = compute_collab_status(root)\n   188→\n   189→    # Build computed status\n   190→    status = {\n   191→        \"branch\": git_info[\"branch\"],\n   192→        \"uncommitted_changes\": git_info[\"uncommitted_count\"],\n   193→        \"active_changes\": active_changes,\n   194→        \"collab\": collab,\n   195→        \"last_commits\": git_info[\"last_commits\"],\n   196→    }\n   197→\n   198→    # Diagnostics: uncommitted changes\n   199→    if git_info[\"uncommitted_count\"] > 0:\n   200→        issues.append({\n   201→            'severity': 'info',\n   202→            'check': 'git_status',\n   203→            'message': f\"{git_info['uncommitted_count']} uncommitted change(s) in working directory\",\n   204→            'suggestion': \"Run 'se3 commit' to commit changes\"\n   205→        })\n   206→\n   207→    # Diagnostics: collab session issues\n   208→    if collab and collab.get(\"status\") == \"active\":\n   209→        failed = [t for t in collab.get(\"tasks\", []) if t[\"status\"] in (\"failed\", \"escalated\")]\n   210→        blocked = [t for t in collab.get(\"tasks\", []) if t[\"status\"] == \"blocked\"]\n   211→        if failed:\n   212→            issues.append({\n   213→                'severity': 'warning',\n   214→                'check': 'collab_tasks',\n   215→                'message': f\"{len(failed)} failed/escalated collab task(s): {', '.join(t['id'] for t in failed)}\",\n   216→                'suggestion': \"Review failed tasks and retry or escalate\"\n   217→            })\n   218→        if blocked:\n   219→            issues.append({\n   220→                'severity': 'warning',\n   221→                'check': 'collab_tasks',\n   222→                'message': f\"{len(blocked)} blocked collab task(s): {', '.join(t['id'] for t in blocked)}\",\n   223→                'suggestion': \"Check blocked_reason in task files\"\n   224→            })\n   225→\n   226→    # Diagnostics: human calls\n   227→    issues.extend(check_human_calls(root))\n   228→\n   229→    # Count by severity\n   230→    errors = [i for i in issues if i['severity'] == 'error']\n   231→    warnings = [i for i in issues if i['severity'] == 'warning']\n   232→    infos = [i for i in issues if i['severity'] == 'info']\n   233→\n   234→    return {\n   235→        'healthy': len(errors) == 0 and len(warnings) == 0,\n   236→        'status': status,\n   237→        'issues': issues,\n   238→        'summary': {\n   239→            'errors': len(errors),\n   240→            'warnings': len(warnings),\n   241→            'info': len(infos)\n   242→        }\n   243→    }\n   244→\n   245→\n   246→def print_text_report(results: Dict[str, Any]) -> None:\n   247→    \"\"\"Print a human-readable status report computed from live state.\"\"\"\n   248→    print(f\"\\n{'=' * 60}\")\n   249→    print(\"SE 3.0 Project Status\")\n   250→    print(f\"{'=' * 60}\")\n   251→\n   252→    status = results['status']\n   253→\n   254→    # Git info\n   255→    print(f\"\\nBranch: {status.get('branch', 'N/A')}\")\n   256→    uncommitted = status.get('uncommitted_changes', 0)\n   257→    if uncommitted > 0:\n   258→        print(f\"Uncommitted Changes: {uncommitted}\")\n   259→    else:\n   260→        print(f\"Working Tree: clean\")\n   261→\n   262→    # Active changes\n   263→    changes = status.get('active_changes', [])\n   264→    if changes:\n   265→        print(f\"\\nActive Changes:\")\n   266→        for c in changes:\n   267→            print(f\"  - {c}\")\n   268→    else:\n   269→        print(f\"\\nActive Changes: (none)\")\n   270→\n   271→    # Collab status\n   272→    collab = status.get('collab')\n   273→    if collab:\n   274→        print(f\"\\nCollab Session: {collab.get('status', 'unknown')}\")\n   275→        print(f\"  Objective: {collab.get('objective', 'N/A')}\")\n   276→        tasks = collab.get('tasks', [])\n   277→        if tasks:\n   278→            for t in tasks:\n   279→                print(f\"  - {t['id']}: {t['status']} — {t['title']}\")\n   280→\n   281→    # Recent activity\n   282→    commits = status.get('last_commits', [])\n   283→    if commits:\n   284→        print(f\"\\nRecent Commits:\")\n   285→        for c in commits:\n   286→            print(f\"  {c}\")\n   287→\n   288→    # Diagnostic issues\n   289→    print(f\"\\n{'-' * 60}\")\n   290→    print(\"Diagnostics:\")\n   291→    print(f\"{'-' * 60}\")\n   292→\n   293→    if results['healthy'] and not results['issues']:\n   294→        print(\"\\n  All diagnostics passed\")\n   295→    else:\n   296→        for issue in results['issues']:\n   297→            icon = 'x' if issue['severity'] == 'error' else '!' if issue['severity'] == 'warning' else 'i'\n   298→            print(f\"\\n  [{icon}] [{issue['severity'].upper()}] {issue['check']}\")\n   299→            print(f\"      {issue['message']}\")\n   300→            print(f\"      Suggestion: {issue['suggestion']}\")\n   301→\n   302→    summary = results['summary']\n   303→    print(f\"\\n{'-' * 60}\")\n   304→    print(f\"Summary: {summary['errors']} errors, {summary['warnings']} warnings, {summary['info']} info\")\n   305→    print(f\"{'=' * 60}\\n\")\n   306→\n   307→\n   308→def print_json_report(results: Dict[str, Any]) -> None:\n   309→    \"\"\"Print JSON diagnostic report.\"\"\"\n   310→    print(json.dumps(results, indent=2, default=str))\n   311→\n   312→\n   313→def main(format: str = \"text\", project_root: str = \".\") -> int:\n   314→    \"\"\"Main entry point for status command.\"\"\"\n   315→    results = run_diagnostics(project_root)\n   316→\n   317→    if format == \"json\":\n   318→        print_json_report(results)\n   319→    else:\n   320→        print_text_report(results)\n   321→\n   322→    return 0 if results['healthy'] else 1\n   323→\n   324→\n   325→@app.callback()\n   326→def status(\n   327→    format: str = typer.Option(\"text\", \"--format\", \"-f\", help=\"Output format (text or json)\"),\n   328→    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n   329→):\n   330→    \"\"\"Check project status and run diagnostics (computed live, no status.md needed).\"\"\"\n   331→    exit_code = main(format, project_root)\n   332→    raise typer.Exit(code=exit_code)\n   333→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"e569dacb-b70b-4c90-930f-0ca840cf5264","uuid":"4c8d5ab2-9b98-4633-9f51-e36980ab7b22","tool_use_result":{"type":"text","file":{"filePath":"/data/cre/workspace/se3.0/.worktrees/verify-openspec-commands/tools/se3_tools/commands/status.py","content":"\"\"\"Status diagnostics command for SE 3.0 tools.\n\nComputes project status in real-time from:\n- git status / git log (uncommitted changes, recent activity)\n- openspec/changes/ (active changes)\n- .collab/ (collaboration session state)\n- human-calls/ (pending/responded requests)\n\nNo longer depends on status.md — all state is computed live.\n\"\"\"\n\n# Verify: status-diagnostics/Compute git status\n# Verify: status-diagnostics/Detect active changes\n# Verify: status-diagnostics/Unprocessed response\n# Verify: status-diagnostics/Long-pending call\n# Verify: status-diagnostics/Healthy project\n# Verify: status-diagnostics/Issues found\n\nimport json\nimport subprocess\nfrom pathlib import Path\nfrom typing import List, Dict, Any, Optional\nfrom datetime import datetime\n\nfrom ..utils import discover_changes\nfrom ..human_calls import HumanCallStore\n\nimport typer\n\napp = typer.Typer(invoke_without_command=True)\n\n\ndef compute_git_status(project_root: Path) -> Dict[str, Any]:\n    \"\"\"Compute current git state.\n\n    Returns dict with branch, uncommitted changes count, last commit info.\n    \"\"\"\n    info = {\n        \"branch\": \"unknown\",\n        \"uncommitted_count\": 0,\n        \"uncommitted_details\": \"\",\n        \"last_commits\": [],\n    }\n\n    # Branch\n    result = subprocess.run(\n        [\"git\", \"branch\", \"--show-current\"],\n        cwd=project_root, capture_output=True, text=True\n    )\n    if result.returncode == 0:\n        info[\"branch\"] = result.stdout.strip() or \"(detached HEAD)\"\n\n    # Uncommitted changes\n    result = subprocess.run(\n        [\"git\", \"status\", \"--porcelain\"],\n        cwd=project_root, capture_output=True, text=True\n    )\n    if result.returncode == 0 and result.stdout.strip():\n        lines = result.stdout.strip().split(\"\\n\")\n        info[\"uncommitted_count\"] = len(lines)\n        info[\"uncommitted_details\"] = result.stdout.strip()\n\n    # Recent commits\n    result = subprocess.run(\n        [\"git\", \"log\", \"--oneline\", \"-5\"],\n        cwd=project_root, capture_output=True, text=True\n    )\n    if result.returncode == 0 and result.stdout.strip():\n        info[\"last_commits\"] = result.stdout.strip().split(\"\\n\")\n\n    return info\n\n\ndef compute_active_changes(project_root: Path) -> List[str]:\n    \"\"\"Find active (non-archived) openspec changes.\"\"\"\n    changes_dir = project_root / \"openspec\" / \"changes\"\n    if not changes_dir.exists():\n        return []\n\n    active = []\n    for item in changes_dir.iterdir():\n        if item.is_dir() and item.name != \"archive\":\n            active.append(item.name)\n    return sorted(active)\n\n\ndef compute_collab_status(project_root: Path) -> Optional[Dict[str, Any]]:\n    \"\"\"Compute collaboration session status from .collab/ files.\"\"\"\n    collab_dir = project_root / \".collab\"\n    config_file = collab_dir / \"config.json\"\n\n    if not config_file.exists():\n        return None\n\n    try:\n        config = json.loads(config_file.read_text())\n    except (json.JSONDecodeError, OSError):\n        return {\"status\": \"error\", \"message\": \"Cannot read .collab/config.json\"}\n\n    result = {\n        \"status\": config.get(\"status\", \"unknown\"),\n        \"objective\": config.get(\"objective\", \"\"),\n        \"session_id\": config.get(\"session_id\", \"\"),\n        \"tasks\": [],\n    }\n\n    tasks_dir = collab_dir / \"tasks\"\n    if tasks_dir.exists():\n        for tf in sorted(tasks_dir.glob(\"task-*.json\")):\n            try:\n                task = json.loads(tf.read_text())\n                result[\"tasks\"].append({\n                    \"id\": task.get(\"id\", tf.stem),\n                    \"status\": task.get(\"status\", \"unknown\"),\n                    \"title\": task.get(\"title\", \"\"),\n                })\n            except (json.JSONDecodeError, OSError):\n                continue\n\n    return result\n\n\ndef check_human_calls(project_root: Path, timeout_days: int = 7) -> List[Dict[str, Any]]:\n    \"\"\"Check human-calls directory for pending/responded files.\"\"\"\n    issues = []\n    calls_dir = project_root / \"human-calls\"\n\n    if not calls_dir.exists():\n        return issues\n\n    store = HumanCallStore(calls_dir)\n\n    # Stale calls\n    stale_calls = store.get_stale_calls(timeout_days)\n    for call in stale_calls:\n        issues.append({\n            'severity': 'warning',\n            'check': 'human_calls',\n            'message': f\"Long-pending human call: {call.file_path.name} ({call.created.strftime('%Y-%m-%d')})\",\n            'suggestion': \"Follow up on the pending request or close it\"\n        })\n\n    # Fresh pending\n    all_pending = store.get_pending_calls()\n    fresh_pending = [c for c in all_pending if c not in stale_calls]\n    for call in fresh_pending:\n        issues.append({\n            'severity': 'info',\n            'check': 'human_calls',\n            'message': f\"Pending human call: {call.file_path.name}\",\n            'suggestion': \"Awaiting human response\"\n        })\n\n    # Responded\n    responded_calls = store.get_responded_calls()\n    for call in responded_calls:\n        is_valid, reason = store.validate_response(call)\n        if is_valid:\n            issues.append({\n                'severity': 'warning',\n                'check': 'human_calls',\n                'message': f\"Unprocessed response: {call.file_path.name}\",\n                'suggestion': \"Process the response and update the call status\"\n            })\n        else:\n            issues.append({\n                'severity': 'info',\n                'check': 'human_calls',\n                'message': f\"Incomplete response in {call.file_path.name}: {reason}\",\n                'suggestion': \"Wait for human to complete their response\"\n            })\n\n    return issues\n\n\ndef run_diagnostics(project_root: str = \".\") -> Dict[str, Any]:\n    \"\"\"Run all diagnostics by computing live state.\n\n    Returns dict with computed status and diagnostic issues.\n    \"\"\"\n    root = Path(project_root).resolve()\n    issues = []\n\n    # Compute live state\n    git_info = compute_git_status(root)\n    active_changes = compute_active_changes(root)\n    collab = compute_collab_status(root)\n\n    # Build computed status\n    status = {\n        \"branch\": git_info[\"branch\"],\n        \"uncommitted_changes\": git_info[\"uncommitted_count\"],\n        \"active_changes\": active_changes,\n        \"collab\": collab,\n        \"last_commits\": git_info[\"last_commits\"],\n    }\n\n    # Diagnostics: uncommitted changes\n    if git_info[\"uncommitted_count\"] > 0:\n        issues.append({\n            'severity': 'info',\n            'check': 'git_status',\n            'message': f\"{git_info['uncommitted_count']} uncommitted change(s) in working directory\",\n            'suggestion': \"Run 'se3 commit' to commit changes\"\n        })\n\n    # Diagnostics: collab session issues\n    if collab and collab.get(\"status\") == \"active\":\n        failed = [t for t in collab.get(\"tasks\", []) if t[\"status\"] in (\"failed\", \"escalated\")]\n        blocked = [t for t in collab.get(\"tasks\", []) if t[\"status\"] == \"blocked\"]\n        if failed:\n            issues.append({\n                'severity': 'warning',\n                'check': 'collab_tasks',\n                'message': f\"{len(failed)} failed/escalated collab task(s): {', '.join(t['id'] for t in failed)}\",\n                'suggestion': \"Review failed tasks and retry or escalate\"\n            })\n        if blocked:\n            issues.append({\n                'severity': 'warning',\n                'check': 'collab_tasks',\n                'message': f\"{len(blocked)} blocked collab task(s): {', '.join(t['id'] for t in blocked)}\",\n                'suggestion': \"Check blocked_reason in task files\"\n            })\n\n    # Diagnostics: human calls\n    issues.extend(check_human_calls(root))\n\n    # Count by severity\n    errors = [i for i in issues if i['severity'] == 'error']\n    warnings = [i for i in issues if i['severity'] == 'warning']\n    infos = [i for i in issues if i['severity'] == 'info']\n\n    return {\n        'healthy': len(errors) == 0 and len(warnings) == 0,\n        'status': status,\n        'issues': issues,\n        'summary': {\n            'errors': len(errors),\n            'warnings': len(warnings),\n            'info': len(infos)\n        }\n    }\n\n\ndef print_text_report(results: Dict[str, Any]) -> None:\n    \"\"\"Print a human-readable status report computed from live state.\"\"\"\n    print(f\"\\n{'=' * 60}\")\n    print(\"SE 3.0 Project Status\")\n    print(f\"{'=' * 60}\")\n\n    status = results['status']\n\n    # Git info\n    print(f\"\\nBranch: {status.get('branch', 'N/A')}\")\n    uncommitted = status.get('uncommitted_changes', 0)\n    if uncommitted > 0:\n        print(f\"Uncommitted Changes: {uncommitted}\")\n    else:\n        print(f\"Working Tree: clean\")\n\n    # Active changes\n    changes = status.get('active_changes', [])\n    if changes:\n        print(f\"\\nActive Changes:\")\n        for c in changes:\n            print(f\"  - {c}\")\n    else:\n        print(f\"\\nActive Changes: (none)\")\n\n    # Collab status\n    collab = status.get('collab')\n    if collab:\n        print(f\"\\nCollab Session: {collab.get('status', 'unknown')}\")\n        print(f\"  Objective: {collab.get('objective', 'N/A')}\")\n        tasks = collab.get('tasks', [])\n        if tasks:\n            for t in tasks:\n                print(f\"  - {t['id']}: {t['status']} — {t['title']}\")\n\n    # Recent activity\n    commits = status.get('last_commits', [])\n    if commits:\n        print(f\"\\nRecent Commits:\")\n        for c in commits:\n            print(f\"  {c}\")\n\n    # Diagnostic issues\n    print(f\"\\n{'-' * 60}\")\n    print(\"Diagnostics:\")\n    print(f\"{'-' * 60}\")\n\n    if results['healthy'] and not results['issues']:\n        print(\"\\n  All diagnostics passed\")\n    else:\n        for issue in results['issues']:\n            icon = 'x' if issue['severity'] == 'error' else '!' if issue['severity'] == 'warning' else 'i'\n            print(f\"\\n  [{icon}] [{issue['severity'].upper()}] {issue['check']}\")\n            print(f\"      {issue['message']}\")\n            print(f\"      Suggestion: {issue['suggestion']}\")\n\n    summary = results['summary']\n    print(f\"\\n{'-' * 60}\")\n    print(f\"Summary: {summary['errors']} errors, {summary['warnings']} warnings, {summary['info']} info\")\n    print(f\"{'=' * 60}\\n\")\n\n\ndef print_json_report(results: Dict[str, Any]) -> None:\n    \"\"\"Print JSON diagnostic report.\"\"\"\n    print(json.dumps(results, indent=2, default=str))\n\n\ndef main(format: str = \"text\", project_root: str = \".\") -> int:\n    \"\"\"Main entry point for status command.\"\"\"\n    results = run_diagnostics(project_root)\n\n    if format == \"json\":\n        print_json_report(results)\n    else:\n        print_text_report(results)\n\n    return 0 if results['healthy'] else 1\n\n\n@app.callback()\ndef status(\n    format: str = typer.Option(\"text\", \"--format\", \"-f\", help=\"Output format (text or json)\"),\n    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n):\n    \"\"\"Check project status and run diagnostics (computed live, no status.md needed).\"\"\"\n    exit_code = main(format, project_root)\n    raise typer.Exit(code=exit_code)\n","numLines":333,"startLine":1,"totalLines":333}}}
