{"type":"user","message":{"role":"user","content":[{"tool_use_id":"tool_NWbdQT5p9uPyAtWbfpOtX24S","type":"tool_result","content":"     1→\"\"\"SE 3.0 CLI - Main entry point for se3 commands.\"\"\"\n     2→\n     3→import json\n     4→from pathlib import Path\n     5→from typing import Optional\n     6→\n     7→import typer\n     8→\n     9→from . import __version__, SE3_FRAMEWORK_VERSION\n    10→\n    11→def get_framework_version() -> str:\n    12→    \"\"\"Get current framework version from single source of truth (direct file read for git worktree compatibility).\"\"\"\n    13→    import os\n    14→    from pathlib import Path\n    15→    import re\n    16→\n    17→    # Get the path to __init__.py in the current working tree\n    18→    init_file = Path(__file__).parent / \"__init__.py\"\n    19→    if not init_file.exists():\n    20→        raise FileNotFoundError(f\"Cannot find se3_tools __init__.py at {init_file}\")\n    21→\n    22→    with open(init_file, \"r\", encoding=\"utf-8\") as f:\n    23→        content = f.read()\n    24→\n    25→    match = re.search(r'SE3_FRAMEWORK_VERSION\\s*=\\s*\"([\\d]+\\.[\\d]+\\.[\\d]+)\"', content)\n    26→    if not match:\n    27→        raise ValueError(\"Cannot find SE3_FRAMEWORK_VERSION definition in __init__.py\")\n    28→\n    29→    return match.group(1)\n    30→from .commands import lint, status, sync, verify, update, collab, commit, openspec, human_calls_cmd, human_input\n    31→from .commands.update import get_installed_se3_version\n    32→from .commands.init import initialize_project\n    33→\n    34→app = typer.Typer(\n    35→    name=\"se3\",\n    36→    help=\"SE 3.0 framework CLI tools\",\n    37→    invoke_without_command=True,\n    38→)\n    39→\n    40→def _version_callback(value: bool):\n    41→    \"\"\"Handle --version flag.\"\"\"\n    42→    if value:\n    43→        typer.echo(f\"se3 CLI version: {__version__}\")\n    44→        typer.echo(f\"SE3 Framework version: {get_framework_version()}\")\n    45→        try:\n    46→            installed = get_installed_se3_version()\n    47→            if installed != \"0.0.0\":\n    48→                typer.echo(f\"Project SE3 version: {installed}\")\n    49→        except Exception:\n    50→            pass\n    51→        raise typer.Exit()\n    52→\n    53→@app.callback()\n    54→def main(\n    55→    ctx: typer.Context,\n    56→    version: bool = typer.Option(\n    57→        False, \"--version\", \"-v\", help=\"Show version information\", callback=_version_callback, is_eager=True\n    58→    ),\n    59→):\n    60→    \"\"\"SE 3.0 framework CLI tools.\"\"\"\n    61→    if ctx.invoked_subcommand is None:\n    62→        typer.echo(ctx.get_help())\n    63→        raise typer.Exit()\n    64→\n    65→\n    66→# Register direct commands\n    67→@app.command(name=\"init\")\n    68→def init_cmd(\n    69→    force: bool = typer.Option(False, \"--force\", \"-f\", help=\"Reinitialize even if already initialized\"),\n    70→    offline: bool = typer.Option(False, \"--offline\", \"-o\", help=\"Use local templates without network\"),\n    71→    with_config: bool = typer.Option(False, \"--with-config\", \"-c\", help=\"Create se3.config.yaml\"),\n    72→    se3_version: str = typer.Option(SE3_FRAMEWORK_VERSION, \"--se3-version\", \"-v\", help=\"Specify SE3 version to use\"),\n    73→):\n    74→    \"\"\"Initialize a new SE 3.0 project.\"\"\"\n    75→    try:\n    76→        initialize_project(force, offline, with_config, se3_version)\n    77→    except Exception as e:\n    78→        typer.echo(\n    79→            typer.style(\n    80→                f\"Error during initialization: {str(e)}\",\n    81→                fg=typer.colors.RED,\n    82→            )\n    83→        )\n    84→        raise typer.Exit(1)\n    85→\n    86→# Register sub-typer commands (complex multi-command tools)\n    87→app.add_typer(lint.app, name=\"lint\", help=\"Lint OpenSpec files\")\n    88→app.add_typer(status.app, name=\"status\", help=\"Check project status\")\n    89→app.add_typer(sync.app, name=\"sync\", help=\"Sync output files\")\n    90→app.add_typer(verify.app, name=\"verify\", help=\"Verify spec coverage\")\n    91→app.add_typer(update.app, name=\"update\", help=\"Update SE 3.0 framework to latest version\")\n    92→app.add_typer(collab.app, name=\"collab\", help=\"Manage git-worktree multi-agent collaboration\")\n    93→app.add_typer(commit.app, name=\"commit\", help=\"Commit changes with SE3 verification\")\n    94→app.add_typer(openspec.app, name=\"openspec\", help=\"Manage OpenSpec directory and specs\")\n    95→app.add_typer(human_calls_cmd.app, name=\"human-calls\", help=\"Manage human calls\")\n    96→app.add_typer(human_input.app, name=\"human\", help=\"Manage human input\")\n    97→\n    98→# Register direct commands (simple single-command tools with positional args)\n    99→# These are registered as direct commands to avoid sub-typer nesting issues\n   100→@app.command(name=\"start\")\n   101→def start_cmd(\n   102→    format: str = typer.Option(\"text\", \"--format\", \"-f\", help=\"Output format (text or json)\"),\n   103→    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n   104→):\n   105→    \"\"\"Start an SE3 session — compute state and return actions for the agent.\"\"\"\n   106→    from .commands.start import run_session_start, print_text_report, print_json_report\n   107→    import json\n   108→    state = run_session_start(project_root)\n   109→    if format == \"json\":\n   110→        print_json_report(state)\n   111→    else:\n   112→        print_text_report(state)\n   113→    raise typer.Exit(code=0 if not state.get(\"actions\") else 1)\n   114→\n   115→@app.command(name=\"work\")\n   116→def work_cmd(\n   117→    change_name: Optional[str] = typer.Argument(None, help=\"Name of the change to work on\"),\n   118→    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the pro