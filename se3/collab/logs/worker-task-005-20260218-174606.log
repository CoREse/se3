{"type":"user","message":{"role":"user","content":[{"tool_use_id":"tool_SfxJVBAFzMXwqaButj74iC6G","type":"tool_result","content":"     1→\"\"\"Human input command for SE 3.0 tools.\n     2→\n     3→Provides CLI for file-based human input:\n     4→- se3 human input --file <path>  : Read and process an input file\n     5→- se3 human input --list         : List pending input files\n     6→- se3 human input --read <id>    : Read a specific input by ID\n     7→\"\"\"\n     8→\n     9→import json\n    10→from pathlib import Path\n    11→from typing import Optional, List, Dict, Any\n    12→\n    13→import typer\n    14→\n    15→from ..human_input import HumanInputStore, InputStatus, discover_human_inputs\n    16→\n    17→app = typer.Typer(help=\"Human input file management\")\n    18→\n    19→\n    20→def format_input_list(inputs: List[Any], format_type: str = \"text\") -> str:\n    21→    \"\"\"Format a list of inputs for display.\"\"\"\n    22→    if format_type == \"json\":\n    23→        return json.dumps([inp.to_dict() for inp in inputs], indent=2, default=str)\n    24→\n    25→    if not inputs:\n    26→        return \"No pending input files.\"\n    27→\n    28→    lines = []\n    29→    lines.append(f\"\\n{'=' * 60}\")\n    30→    lines.append(\"Pending Human Inputs\")\n    31→    lines.append(f\"{'=' * 60}\")\n    32→\n    33→    for inp in inputs:\n    34→        lines.append(f\"\\nID: {inp.id}\")\n    35→        lines.append(f\"Title: {inp.title}\")\n    36→        lines.append(f\"Created: {inp.created.strftime('%Y-%m-%d %H:%M:%S')}\")\n    37→        lines.append(f\"Status: {inp.status.value}\")\n    38→        if inp.context:\n    39→            preview = inp.context[:100].replace('\\n', ' ')\n    40→            if len(inp.context) > 100:\n    41→                preview += \"...\"\n    42→            lines.append(f\"Context: {preview}\")\n    43→        lines.append(\"-\" * 40)\n    44→\n    45→    return \"\\n\".join(lines)\n    46→\n    47→\n    48→def format_input_detail(inp: Any, format_type: str = \"text\") -> str:\n    49→    \"\"\"Format a single input for display.\"\"\"\n    50→    if format_type == \"json\":\n    51→        return json.dumps(inp.to_dict(), indent=2, default=str)\n    52→\n    53→    lines = []\n    54→    lines.append(f\"\\n{'=' * 60}\")\n    55→    lines.append(f\"Human Input: {inp.id}\")\n    56→    lines.append(f\"{'=' * 60}\")\n    57→    lines.append(f\"\\nTitle: {inp.title}\")\n    58→    lines.append(f\"Created: {inp.created.strftime('%Y-%m-%d %H:%M:%S')}\")\n    59→    lines.append(f\"Status: {inp.status.value}\")\n    60→\n    61→    if inp.context:\n    62→        lines.append(f\"\\n## Context\\n{inp.context}\")\n    63→\n    64→    if inp.request:\n    65→        lines.append(f\"\\n## Request\\n{inp.request}\")\n    66→\n    67→    if inp.response:\n    68→        lines.append(f\"\\n## Response\\n{inp.response}\")\n    69→        if inp.response_timestamp:\n    70→            lines.append(f\"\\n(Response written: {inp.response_timestamp.strftime('%Y-%m-%d %H:%M:%S')})\")\n    71→\n    72→    lines.append(f\"\\n{'=' * 60}\\n\")\n    73→    return \"\\n\".join(lines)\n    74→\n    75→\n    76→@app.callback(invoke_without_command=True)\n    77→def main(\n    78→    ctx: typer.Context,\n    79→    file_path: Optional[str] = typer.Option(\n    80→        None, \"--file\", \"-f\",\n    81→        help=\"Path to input file to read and process\"\n    82→    ),\n    83→    list_pending: bool = typer.Option(\n    84→        False, \"--list\", \"-l\",\n    85→        help=\"List pending input files\"\n    86→    ),\n    87→    read_id: Optional[str] = typer.Option(\n    88→        None, \"--read\", \"-r\",\n    89→        help=\"Read a specific input by ID\"\n    90→    ),\n    91→    archive: bool = typer.Option(\n    92→        True, \"--archive/--no-archive\",\n    93→        help=\"Archive input file after processing (default: True)\"\n    94→    ),\n    95→    inputs_dir: str = typer.Option(\n    96→        \"human-inputs\", \"--inputs-dir\", \"-d\",\n    97→        help=\"Directory containing input files\"\n    98→    ),\n    99→    format_type: str = typer.Option(\n   100→        \"text\", \"--format\",\n   101→        help=\"Output format (text or json)\"\n   102→    ),\n   103→):\n   104→    \"\"\"Manage human input files.\n   105→\n   106→    Examples:\n   107→        se3 human input --list                    # List pending inputs\n   108→        se3 human input --file path/to/input.md   # Process an input file\n   109→        se3 human input --read <id>               # Read a specific input\n   110→    \"\"\"\n   111→    if ctx.invoked_subcommand is not None:\n   112→        return\n   113→\n   114→    store = HumanInputStore(Path(inputs_dir))\n   115→\n   116→    # List pending inputs\n   117→    if list_pending:\n   118→        inputs = store.get_pending_inputs()\n   119→        output = format_input_list(inputs, format_type)\n   120→        typer.echo(output)\n   121→        raise typer.Exit(code=0 if not inputs else 1)\n   122→\n   123→    # Read specific input\n   124→    if read_id:\n   125→        inp = store.get_input(read_id)\n   126→        if not inp:\n   127→            typer.echo(f\"Error: Input '{read_id}' not found\", err=True)\n   128→            raise typer.Exit(code=1)\n   129→        output = format_input_detail(inp, format_type)\n   130→        typer.echo(output)\n   131→        raise typer.Exit(code=0)\n   132→\n   133→    # Process input file\n   134→    if file_path:\n   135→        path = Path(file_path)\n   136→        if not path.exists():\n   137→            typer.echo(f\"Error: File not found: {file_path}\", err=True)\n   138→            raise typer.Exit(code=1)\n   139→\n   140→        inp = store.read_input_file(path)\n   141→        if not inp:\n   142→            typer.echo(f\"Error: Failed to parse input file: {file_path}\", err=True)\n   143→            raise typer.Exit(code=1)\n   144→\n   145→        # Display the input\n   146→        output = format_input_detail(inp, format_type)\n   147→        typer.echo(output)\n   148→\n   149→        # If the file is outside the inputs_dir, copy it there for tracking\n   150→        if path.parent != store.inputs_dir:\n   151→            # Copy to inputs_dir\n   152→            dest_path = store.inputs_dir / path.name\n   153→            counter = 1\n   154→            while dest_path.exists():\n   155→                stem = path.stem\n   156→                if counter > 1:\n   157→                    stem = f\"{path.stem}_{counter}\"\n   158→                dest_path = store.inputs_dir / f\"{stem}{path.suffix}\"\n   159→                counter += 1\n   160→\n   161→            import shutil\n   162→            shutil.copy2(str(path), str(dest_path))\n   163→            typer.echo(f\"\\n[Copied to {dest_path}]\")\n   164→\n   165→            # Re-parse from the new location\n   166→            inp = store.read_input_file(dest_path)\n   167→\n   168→        raise typer.Exit(code=0)\n   169→\n   170→    # No options provided, show help\n   171→    typer.echo(ctx.get_help())\n   172→    raise typer.Exit()\n   173→\n   174→\n   175→@app.command(name=\"template\")\n   176→def create_template(\n   177→    title: str = typer.Argument(..., help=\"Title for the input\"),\n   178→    context: str = typer.Option(\"\", \"--context\", \"-c\", help=\"Context for the input\"),\n   179→    request: str = typer.Option(\"\", \"--request\", \"-r\", help=\"Request content\"),\n   180→    inputs_dir: str = typer.Option(\"human-inputs\", \"--inputs-dir\", \"-d\", help=\"Directory for input files\"),\n   181→):\n   182→    \"\"\"Create a new input file template.\n   183→\n   184→    Example:\n   185→        se3 human input template \"My Request\" --context \"Some context\" --request \"Do this\"\n   186→    \"\"\"\n   187→    store = HumanInputStore(Path(inputs_dir))\n   188→    filepath = store.create_input_template(title, context, request)\n   189→    typer.echo(f\"Created input template: {filepath}\")\n   190→    raise typer.Exit(code=0)\n   191→\n   192→\n   193→@app.command(name=\"respond\")\n   194→def respond(\n   195→    input_id: str = typer.Argument(..., help=\"Input ID to respond to\"),\n   196→    response: str = typer.Argument(..., help=\"Response content\"),\n   197→    inputs_dir: str = typer.Option(\"human-inputs\", \"--inputs-dir\", \"-d\", help=\"Directory containing input files\"),\n   198→    archive_after: bool = typer.Option(True, \"--archive/--no-archive\", help=\"Archive after responding\"),\n   199→):\n   200→    \"\"\"Write a response to an input file.\n   201→\n   202→    Example:\n   203→        se3 human input respond <id> \"This is my response\"\n   204→    \"\"\"\n   205→    store = HumanInputStore(Path(inputs_dir))\n   206→\n   207→    inp = store.get_input(input_id)\n   208→    if not inp:\n   209→        typer.echo(f\"Error: Input '{input_id}' not found\", err=True)\n   210→        raise typer.Exit(code=1)\n   211→\n   212→    success = store.write_response(input_id, response)\n   213→    if not success:\n   214→        typer.echo(f\"Error: Failed to write response\", err=True)\n   215→        raise typer.Exit(code=1)\n   216→\n   217→    typer.echo(f\"Response written to {input_id}\")\n   218→\n   219→    if archive_after:\n   220→        if store.archive_input(input_id):\n   221→            typer.echo(f\"Archived {input_id}\")\n   222→        else:\n   223→            typer.echo(f\"Warning: Failed to archive {input_id}\", err=True)\n   224→\n   225→    raise typer.Exit(code=0)\n   226→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"69efb05e-bf98-4f4c-9bcd-7c6193285013","uuid":"95fb48b4-61b3-4ffe-b89c-824f2f6086ee","tool_use_result":{"type":"text","file":{"filePath":"/data/cre/workspace/se3.0/.worktrees/human-input-methods/tools/se3_tools/commands/human_input.py","content":"\"\"\"Human input command for SE 3.0 tools.\n\nProvides CLI for file-based human input:\n- se3 human input --file <path>  : Read and process an input file\n- se3 human input --list         : List pending input files\n- se3 human input --read <id>    : Read a specific input by ID\n\"\"\"\n\nimport json\nfrom pathlib import Path\nfrom typing import Optional, List, Dict, Any\n\nimport typer\n\nfrom ..human_input import HumanInputStore, InputStatus, discover_human_inputs\n\napp = typer.Typer(help=\"Human input file management\")\n\n\ndef format_input_list(inputs: List[Any], format_type: str = \"text\") -> str:\n    \"\"\"Format a list of inputs for display.\"\"\"\n    if format_type == \"json\":\n        return json.dumps([inp.to_dict() for inp in inputs], indent=2, default=str)\n\n    if not inputs:\n        return \"No pending input files.\"\n\n    lines = []\n    lines.append(f\"\\n{'=' * 60}\")\n    lines.append(\"Pending Human Inputs\")\n    lines.append(f\"{'=' * 60}\")\n\n    for inp in inputs:\n        lines.append(f\"\\nID: {inp.id}\")\n        lines.append(f\"Title: {inp.title}\")\n        lines.append(f\"Created: {inp.created.strftime('%Y-%m-%d %H:%M:%S')}\")\n        lines.append(f\"Status: {inp.status.value}\")\n        if inp.context:\n            preview = inp.context[:100].replace('\\n', ' ')\n            if len(inp.context) > 100:\n                preview += \"...\"\n            lines.append(f\"Context: {preview}\")\n        lines.append(\"-\" * 40)\n\n    return \"\\n\".join(lines)\n\n\ndef format_input_detail(inp: Any, format_type: str = \"text\") -> str:\n    \"\"\"Format a single input for display.\"\"\"\n    if format_type == \"json\":\n        return json.dumps(inp.to_dict(), indent=2, default=str)\n\n    lines = []\n    lines.append(f\"\\n{'=' * 60}\")\n    lines.append(f\"Human Input: {inp.id}\")\n    lines.append(f\"{'=' * 60}\")\n    lines.append(f\"\\nTitle: {inp.title}\")\n    lines.append(f\"Created: {inp.created.strftime('%Y-%m-%d %H:%M:%S')}\")\n    lines.append(f\"Status: {inp.status.value}\")\n\n    if inp.context:\n        lines.append(f\"\\n## Context\\n{inp.context}\")\n\n    if inp.request:\n        lines.append(f\"\\n## Request\\n{inp.request}\")\n\n    if inp.response:\n        lines.append(f\"\\n## Response\\n{inp.response}\")\n        if inp.response_timestamp:\n            lines.append(f\"\\n(Response written: {inp.response_timestamp.strftime('%Y-%m-%d %H:%M:%S')})\")\n\n    lines.append(f\"\\n{'=' * 60}\\n\")\n    return \"\\n\".join(lines)\n\n\n@app.callback(invoke_without_command=True)\ndef main(\n    ctx: typer.Context,\n    file_path: Optional[str] = typer.Option(\n        None, \"--file\", \"-f\",\n        help=\"Path to input file to read and process\"\n    ),\n    list_pending: bool = typer.Option(\n        False, \"--list\", \"-l\",\n        help=\"List pending input files\"\n    ),\n    read_id: Optional[str] = typer.Option(\n        None, \"--read\", \"-r\",\n        help=\"Read a specific input by ID\"\n    ),\n    archive: bool = typer.Option(\n        True, \"--archive/--no-archive\",\n        help=\"Archive input file after processing (default: True)\"\n    ),\n    inputs_dir: str = typer.Option(\n        \"human-inputs\", \"--inputs-dir\", \"-d\",\n        help=\"Directory containing input files\"\n    ),\n    format_type: str = typer.Option(\n        \"text\", \"--format\",\n        help=\"Output format (text or json)\"\n    ),\n):\n    \"\"\"Manage human input files.\n\n    Examples:\n        se3 human input --list                    # List pending inputs\n        se3 human input --file path/to/input.md   # Process an input file\n        se3 human input --read <id>               # Read a specific input\n    \"\"\"\n    if ctx.invoked_subcommand is not None:\n        return\n\n    store = HumanInputStore(Path(inputs_dir))\n\n    # List pending inputs\n    if list_pending:\n        inputs = store.get_pending_inputs()\n        output = format_input_list(inputs, format_type)\n        typer.echo(output)\n        raise typer.Exit(code=0 if not inputs else 1)\n\n    # Read specific input\n    if read_id:\n        inp = store.get_input(read_id)\n        if not inp:\n            typer.echo(f\"Error: Input '{read_id}' not found\", err=True)\n            raise typer.Exit(code=1)\n        output = format_input_detail(inp, format_type)\n        typer.echo(output)\n        raise typer.Exit(code=0)\n\n    # Process input file\n    if file_path:\n        path = Path(file_path)\n        if not path.exists():\n            typer.echo(f\"Error: File not found: {file_path}\", err=True)\n            raise typer.Exit(code=1)\n\n        inp = store.read_input_file(path)\n        if not inp:\n            typer.echo(f\"Error: Failed to parse input file: {file_path}\", err=True)\n            raise typer.Exit(code=1)\n\n        # Display the input\n        output = format_input_detail(inp, format_type)\n        typer.echo(output)\n\n        # If the file is outside the inputs_dir, copy it there for tracking\n        if path.parent != store.inputs_dir:\n            # Copy to inputs_dir\n            dest_path = store.inputs_dir / path.name\n            counter = 1\n            while dest_path.exists():\n                stem = path.stem\n                if counter > 1:\n                    stem = f\"{path.stem}_{counter}\"\n                dest_path = store.inputs_dir / f\"{stem}{path.suffix}\"\n                counter += 1\n\n            import shutil\n            shutil.copy2(str(path), str(dest_path))\n            typer.echo(f\"\\n[Copied to {dest_path}]\")\n\n            # Re-parse from the new location\n            inp = store.read_input_file(dest_path)\n\n        raise typer.Exit(code=0)\n\n    # No options provided, show help\n    typer.echo(ctx.get_help())\n    raise typer.Exit()\n\n\n@app.command(name=\"template\")\ndef create_template(\n    title: str = typer.Argument(..., help=\"Title for the input\"),\n    context: str = typer.Option(\"\", \"--context\", \"-c\", help=\"Context for the input\"),\n    request: str = typer.Option(\"\", \"--request\", \"-r\", help=\"Request content\"),\n    inputs_dir: str = typer.Option(\"human-inputs\", \"--inputs-dir\", \"-d\", help=\"Directory for input files\"),\n):\n    \"\"\"Create a new input file template.\n\n    Example:\n        se3 human input template \"My Request\" --context \"Some context\" --request \"Do this\"\n    \"\"\"\n    store = HumanInputStore(Path(inputs_dir))\n    filepath = store.create_input_template(title, context, request)\n    typer.echo(f\"Created input template: {filepath}\")\n    raise typer.Exit(code=0)\n\n\n@app.command(name=\"respond\")\ndef respond(\n    input_id: str = typer.Argument(..., help=\"Input ID to respond to\"),\n    response: str = typer.Argument(..., help=\"Response content\"),\n    inputs_dir: str = typer.Option(\"human-inputs\", \"--inputs-dir\", \"-d\", help=\"Directory containing input files\"),\n    archive_after: bool = typer.Option(True, \"--archive/--no-archive\", help=\"Archive after responding\"),\n):\n    \"\"\"Write a response to an input file.\n\n    Example:\n        se3 human input respond <id> \"This is my response\"\n    \"\"\"\n    store = HumanInputStore(Path(inputs_dir))\n\n    inp = store.get_input(input_id)\n    if not inp:\n        typer.echo(f\"Error: Input '{input_id}' not found\", err=True)\n        raise typer.Exit(code=1)\n\n    success = store.write_response(input_id, response)\n    if not success:\n        typer.echo(f\"Error: Failed to write response\", err=True)\n        raise typer.Exit(code=1)\n\n    typer.echo(f\"Response written to {input_id}\")\n\n    if archive_after:\n        if store.archive_input(input_id):\n            typer.echo(f\"Archived {input_id}\")\n        else:\n            typer.echo(f\"Warning: Failed to archive {input_id}\", err=True)\n\n    raise typer.Exit(code=0)\n","numLines":226,"startLine":1,"totalLines":226}}}
