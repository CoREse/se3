{"type":"user","message":{"role":"user","content":[{"tool_use_id":"tool_OgDb9aM632fGXivYeZWIjSmr","type":"tool_result","content":"     1→\"\"\"Archive completed human calls command for SE3.\"\"\"\n     2→\n     3→from pathlib import Path\n     4→from typing import Optional\n     5→\n     6→import typer\n     7→\n     8→from ..human_calls import HumanCallStore\n     9→\n    10→app = typer.Typer(name=\"archive-calls\", help=\"Archive completed human calls\")\n    11→\n    12→\n    13→def _get_calls_dir(project_root: Path) -> Path:\n    14→    \"\"\"Get the human-calls directory path.\"\"\"\n    15→    # Try common locations\n    16→    calls_dir = project_root / \"human-calls\"\n    17→    if calls_dir.exists():\n    18→        return calls_dir\n    19→\n    20→    # Check if there's a .claude directory structure\n    21→    claude_calls = project_root / \".claude\" / \"human-calls\"\n    22→    if claude_calls.exists():\n    23→        return claude_calls\n    24→\n    25→    # Default to human-calls in project root\n    26→    return calls_dir\n    27→\n    28→\n    29→@app.callback(invoke_without_command=True)\n    30→def archive_calls(\n    31→    dry_run: bool = typer.Option(False, \"--dry-run\", \"-n\", help=\"Preview what would be archived without moving files\"),\n    32→    days: int = typer.Option(30, \"--days\", \"-d\", help=\"Archive calls completed more than N days ago\"),\n    33→    all_completed: bool = typer.Option(False, \"--all-completed\", \"-a\", help=\"Archive all completed calls regardless of age\"),\n    34→    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n    35→    show_stats: bool = typer.Option(False, \"--stats\", \"-s\", help=\"Show archive statistics after archiving\"),\n    36→):\n    37→    \"\"\"Archive completed/expired human calls to the archive directory.\n    38→\n    39→    By default, archives calls completed more than 30 days ago.\n    40→    Archived calls are moved to human-calls/archive/.\n    41→\n    42→    Examples:\n    43→        se3 archive-calls                    # Archive calls > 30 days old\n    44→        se3 archive-calls --days 7           # Archive calls > 7 days old\n    45→        se3 archive-calls --dry-run          # Preview what would be archived\n    46→        se3 archive-calls --all-completed    # Archive all completed calls\n    47→        se3 archive-calls --stats            # Show statistics after archiving\n    48→    \"\"\"\n    49→    root = Path(project_root).resolve()\n    50→    calls_dir = _get_calls_dir(root)\n    51→\n    52→    if not calls_dir.exists():\n    53→        typer.echo(\n    54→            typer.style(\n    55→                f\"Error: Human calls directory not found at {calls_dir}\",\n    56→                fg=typer.colors.RED,\n    57→            )\n    58→        )\n    59→        raise typer.Exit(1)\n    60→\n    61→    store = HumanCallStore(calls_dir)\n    62→\n    63→    # Show current archive stats if requested\n    64→    if show_stats:\n    65→        stats = store.get_archive_stats()\n    66→        typer.echo(typer.style(\"Current Archive Statistics:\", fg=typer.colors.BLUE, bold=True))\n    67→        typer.echo(f\"  Total archived: {stats['total_archived']}\")\n    68→        if stats['by_status']['completed'] > 0:\n    69→            typer.echo(f\"  Completed: {stats['by_status']['completed']}\")\n    70→        if stats['by_status']['expired'] > 0:\n    71→            typer.echo(f\"  Expired: {stats['by_status']['expired']}\")\n    72→        if stats['oldest_archive']:\n    73→            typer.echo(f\"  Oldest: {stats['oldest_archive'][:10]}\")\n    74→        typer.echo()\n    75→\n    76→    # Determine what to archive\n    77→    if all_completed:\n    78→        typer.echo(typer.style(\"Archiving all completed/expired calls...\", fg=typer.colors.YELLOW))\n    79→    else:\n    80→        typer.echo(typer.style(f\"Archiving calls completed more than {days} days ago...\", fg=typer.colors.YELLOW))\n    81→\n    82→    if dry_run:\n    83→        typer.echo(typer.style(\"[DRY RUN] No files will be moved\", fg=typer.colors.CYAN))\n    84→\n    85→    # Perform archiving\n    86→    archived = store.archive_completed_calls(\n    87→        days_old=days,\n    88→        dry_run=dry_run,\n    89→        all_completed=all_completed\n    90→    )\n    91→\n    92→    if not archived:\n    93→        typer.echo(typer.style(\"No calls to archive.\", fg=typer.colors.GREEN))\n    94→        raise typer.Exit(0)\n    95→\n    96→    # Display results\n    97→    typer.echo()\n    98→    if dry_run:\n    99→        typer.echo(typer.style(f\"Would archive {len(archived)} call(s):\", fg=typer.colors.CYAN))\n   100→    else:\n   101→        typer.echo(typer.style(f\"Archived {len(archived)} call(s):\", fg=typer.colors.GREEN))\n   102→\n   103→    for info in archived:\n   104→        status_color = typer.colors.GREEN if info['status'] == 'completed' else typer.colors.YELLOW\n   105→        typer.echo(f\"  • {info['title'][:50]}\")\n   106→        typer.echo(f\"    Status: {typer.style(info['status'], fg=status_color)}\")\n   107→        if dry_run:\n   108→            typer.echo(f\"    Would move: {Path(info['file_path']).name}\")\n   109→        else:\n   110→            typer.echo(f\"    Archived to: {Path(info['archive_path']).name}\")\n   111→        typer.echo()\n   112→\n   113→    # Show updated stats if archiving actually happened\n   114→    if not dry_run and show_stats:\n   115→        stats = store.get_archive_stats()\n   116→        typer.echo(typer.style(\"Updated Archive Statistics:\", fg=typer.colors.BLUE, bold=True))\n   117→        typer.echo(f\"  Total archived: {stats['total_archived']}\")\n   118→        typer.echo(f\"  Archive location: {stats['archive_dir']}\")\n   119→\n   120→    raise typer.Exit(0)\n   121→\n   122→\n   123→@app.command(name=\"stats\")\n   124→def archive_stats(\n   125→    project_root: str =