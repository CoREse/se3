56→    else:\n   157→        fullcycle_print_text(result)\n   158→    raise typer.Exit(code=0 if result.get(\"success\") else 1)\n   159→\n   160→\n   161→@app.command(name=\"full-cycle\")\n   162→def full_cycle_cmd(\n   163→    description: str = typer.Argument(..., help=\"Description of the work to do\"),\n   164→    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n   165→    quick: bool = typer.Option(False, \"--quick\", \"-q\", help=\"Quick mode - skip formal change creation, use 'small' workflow\"),\n   166→    format: str = typer.Option(\"text\", \"--format\", \"-f\", help=\"Output format (text or json)\"),\n   167→):\n   168→    \"\"\"Run the complete start-work-done workflow in one command.\n   169→\n   170→    This command streamlines simple/quick tasks by combining:\n   171→    1. se3 start - Initialize the session\n   172→    2. se3 work --new - Create a change for the work\n   173→    3. Implementation (performed by agent)\n   174→    4. se3 done - Complete the session\n   175→\n   176→    Examples:\n   177→        se3 full-cycle \"fix login bug\"\n   178→        se3 full-cycle \"add user profile page\" --quick\n   179→        se3 full-cycle \"update documentation\" -q --json\n   180→    \"\"\"\n   181→    _full_cycle_cmd_impl(description, project_root, quick, format)\n   182→\n   183→\n   184→@app.command(name=\"fc\")\n   185→def fc_cmd(\n   186→    description: str = typer.Argument(..., help=\"Description of the work to do\"),\n   187→    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n   188→    quick: bool = typer.Option(False, \"--quick\", \"-q\", help=\"Quick mode - skip formal change creation, use 'small' workflow\"),\n   189→    format: str = typer.Option(\"text\", \"--format\", \"-f\", help=\"Output format (text or json)\"),\n   190→):\n   191→    \"\"\"Alias for 'full-cycle' - Run the complete start-work-done workflow in one command.\"\"\"\n   192→    _full_cycle_cmd_impl(description, project_root, quick, format)\n   193→\n   194→# Register handoff as a direct command (not a sub-typer)\n   195→@app.command(name=\"handoff\")\n   196→def handoff_cmd(\n   197→    message: Optional[str] = typer.Argument(None, help=\"Handoff message describing what was done\"),\n   198→    project_root: Optional[str] = typer.Option(None, \"--project-root\", \"-p\", help=\"Project root directory\"),\n   199→    dry_run: bool = typer.Option(False, \"--dry-run\", help=\"Preview what would happen without executing\"),\n   200→    skip_commit: bool = typer.Option(False, \"--skip-commit\", help=\"Skip automatic commit (use with caution)\"),\n   201→):\n   202→    \"\"\"Handoff control to human — enforcing SE3 commit-before-handoff rule.\"\"\"\n   203→    from .commands.handoff import handoff\n   204→    handoff(message=message, project_root=project_root, dry_run=dry_run, skip_commit=skip_commit)\n   205→\n   206→\n   207→@app.command(name=\"claude-cmd\")\n   208→def claude_cmd(\n   209→    all_cmds: bool = typer.Option(False, \"--all\", help=\"Output all commands as JSON sorted by priority\"),\n   210→    next_after: Optional[str] = typer.Option(None, \"--next\", help=\"Output the next command after the given one\"),\n   211→    project_root: Optional[str] = typer.Option(None, \"--project-root\", \"-p\", help=\"Project root directory\"),\n   212→):\n   213→    \"\"\"Show configured Claude commands by priority.\n   214→\n   215→    Used by bash scripts to resolve which Claude command to use.\n   216→    \"\"\"\n   217→    from .config import load_claude_commands\n   218→\n   219→    root = Path(project_root) if project_root else Path.cwd()\n   220→    commands = load_claude_commands(root)\n   221→\n   222→    if all_cmds:\n   223→        typer.echo(json.dumps(commands))\n   224→    elif next_after:\n   225→        found = False\n   226→        for i, entry in enumerate(commands):\n   227→            if entry[\"cmd\"] == next_after:\n   228→                if i + 1 < len(commands):\n   229→                    typer.echo(commands[i + 1][\"cmd\"])\n   230→                else:\n   231→                    typer.echo(\"\")  # No next command\n   232→                found = True\n   233→                break\n   234→        if not found:\n   235→            typer.echo(\"\")  # Command not in list\n   236→    else:\n   237→        # Default: output highest-priority command\n   238→        typer.echo(commands[0][\"cmd\"])\n   239→\n   240→\n   241→if __name__ == \"__main__\":\n   242→    app()\n   243→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"8924aa60-cb07-4b2b-b7ff-204f57b06f02","uuid":"df25920e-2688-41f1-a363-16142daaf268","tool_use_result":{"type":"text","file":{"filePath":"/data/cre/workspace/se3.0/tools/se3_tools/cli.py","content":"\"\"\"SE 3.0 CLI - Main entry point for se3 commands.\"\"\"\n\nimport json\nfrom pathlib import Path\nfrom typing import Optional\n\nimport typer\n\nfrom . import __version__, SE3_FRAMEWORK_VERSION\n\ndef get_framework_version() -> str:\n    \"\"\"Get current framework version from single source of truth (direct file read for git worktree compatibility).\"\"\"\n    import os\n    from pathlib import Path\n    import re\n\n    # Get the path to __init__.py in the current working tree\n    init_file = Path(__file__).parent / \"__init__.py\"\n    if not init_file.exists():\n        raise FileNotFoundError(f\"Cannot find se3_tools __init__.py at {init_file}\")\n\n    with open(init_file, \"r\", encoding=\"utf-8\") as f:\n        content = f.read()\n\n    match = re.search(r'SE3_FRAMEWORK_VERSION\\s*=\\s*\"([\\d]+\\.[\\d]+\\.[\\d]+)\"', content)\n    if not match:\n        raise ValueError(\"Cannot find SE3_FRAMEWORK_VERSION definition in __init__.py\")\n\n    return match.group(1)\nfrom .commands import lint, status, sync, verify, update, collab, commit, openspec, human_calls_cmd\nfrom .commands.update import get_installed_se3_version\nfrom .commands.init import initialize_project\n\napp = typer.Typer(\n    name=\"se3\",\n    help=\"SE 3.0 framework CLI tools\",\n    invoke_without_command=True,\n)\n\ndef _version_callback(value: bool):\n    \"\"\"Handle --version flag.\"\"\"\n    if value:\n        typer.echo(f\"se3 CLI version: {__version__}\")\n        typer.echo(f\"SE3 Framework version: {get_framework_version()}\")\n        try:\n            installed = get_installed_se3_version()\n            if installed != \"0.0.0\":\n                typer.echo(f\"Project SE3 version: {installed}\")\n        except Exception:\n            pass\n        raise typer.Exit()\n\n@app.callback()\ndef main(\n    ctx: typer.Context,\n    version: bool = typer.Option(\n        False, \"--version\", \"-v\", help=\"Show version information\", callback=_version_callback, is_eager=True\n    ),\n):\n    \"\"\"SE 3.0 framework CLI tools.\"\"\"\n    if ctx.invoked_subcommand is None:\n        typer.echo(ctx.get_help())\n        raise typer.Exit()\n\n\n# Register direct commands\n@app.command(name=\"init\")\ndef init_cmd(\n    force: bool = typer.Option(False, \"--force\", \"-f\", help=\"Reinitialize even if already initialized\"),\n    offline: bool = typer.Option(False, \"--offline\", \"-o\", help=\"Use local templates without network\"),\n    with_config: bool = typer.Option(False, \"--with-config\", \"-c\", help=\"Create se3.config.yaml\"),\n    se3_version: str = typer.Option(SE3_FRAMEWORK_VERSION, \"--se3-version\", \"-v\", help=\"Specify SE3 version to use\"),\n):\n    \"\"\"Initialize a new SE 3.0 project.\"\"\"\n    try:\n        initialize_project(force, offline, with_config, se3_version)\n    except Exception as e:\n        typer.echo(\n            typer.style(\n                f\"Error during initialization: {str(e)}\",\n                fg=typer.colors.RED,\n            )\n        )\n        raise typer.Exit(1)\n\n# Register sub-typer commands (complex multi-command tools)\napp.add_typer(lint.app, name=\"lint\", help=\"Lint OpenSpec files\")\napp.add_typer(status.app, name=\"status\", help=\"Check project status\")\napp.add_typer(sync.app, name=\"sync\", help=\"Sync output files\")\napp.add_typer(verify.app, name=\"verify\", help=\"Verify spec coverage\")\napp.add_typer(update.app, name=\"update\", help=\"Update SE 3.0 framework to latest version\")\napp.add_typer(collab.app, name=\"collab\", help=\"Manage git-worktree multi-agent collaboration\")\napp.add_typer(commit.app, name=\"commit\", help=\"Commit changes with SE3 verification\")\napp.add_typer(openspec.app, name=\"openspec\", help=\"Manage OpenSpec directory and specs\")\napp.add_typer(human_calls_cmd.app, name=\"human-calls\", help=\"Manage human calls\")\n\n# Register direct commands (simple single-command tools with positional args)\n# These are registered as direct commands to avoid sub-typer nesting issues\n@app.command(name=\"start\")\ndef start_cmd(\n    format: str = typer.Option(\"text\", \"--format\", \"-f\", help=\"Output format (text or json)\"),\n    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n):\n    \"\"\"Start an SE3 session — compute state and return actions for the agent.\"\"\"\n    from .commands.start import run_session_start, print_text_report, print_json_report\n    import json\n    state = run_session_start(project_root)\n    if format == \"json\":\n        print_json_report(state)\n    else:\n        print_text_report(state)\n    raise typer.Exit(code=0 if not state.get(\"actions\") else 1)\n\n@app.command(name=\"work\")\ndef work_cmd(\n    change_name: Optional[str] = typer.Argument(None, help=\"Name of the change to work on\"),\n    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n    new: Optional[str] = typer.Option(None, \"--new\", help=\"Create new change with workflow type (bugfix/feature/review/directive)\"),\n    advance: bool = typer.Option(False, \"--advance\", \"-a\", help=\"Mark current step complete and advance to next\"),\n    format: str = typer.Option(\"text\", \"--format\", \"-f\", help=\"Output format (text or json)\"),\n):\n    \"\"\"Start or continue working on a change — the SDD workflow driver.\"\"\"\n    from .commands.work import run_work, print_text_report, print_json_report\n    result = run_work(project_root, change_name, new, advance)\n    if format == \"json\":\n        print_json_report(result)\n    else:\n        print_text_report(result)\n    raise typer.Exit(code=0 if result.get(\"change\") else 1)\n\n@app.command(name=\"done\")\ndef done_cmd(\n    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n    format: str = typer.Option(\"text\", \"--format\", \"-f\", help=\"Output format (text or json)\"),\n):\n    \"\"\"End an SE3 session — compute shutdown actions for the agent.\"\"\"\n    from .commands.done import run_session_done, print_text_report, print_json_report\n    state = run_session_done(project_root)\n    if format == \"json\":\n        print_json_report(state)\n    else:\n        print_text_report(state)\n    raise typer.Exit(code=0)\n\ndef _full_cycle_cmd_impl(\n    description: str,\n    project_root: str,\n    quick: bool,\n    format: str,\n):\n    \"\"\"Implementation of full-cycle command.\"\"\"\n    from .commands.fullcycle import run_full_cycle, print_text_report as fullcycle_print_text, print_json_report as fullcycle_print_json\n    result = run_full_cycle(description, project_root, quick)\n    if format == \"json\":\n        fullcycle_print_json(result)\n    else:\n        fullcycle_print_text(result)\n    raise typer.Exit(code=0 if result.get(\"success\") else 1)\n\n\n@app.command(name=\"full-cycle\")\ndef full_cycle_cmd(\n    description: str = typer.Argument(..., help=\"Description of the work to do\"),\n    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n    quick: bool = typer.Option(False, \"--quick\", \"-q\", help=\"Quick mode - skip formal change creation, use 'small' workflow\"),\n    format: str = typer.Option(\"text\", \"--format\", \"-f\", help=\"Output format (text or json)\"),\n):\n    \"\"\"Run the complete start-work-done workflow in one command.\n\n    This command streamlines simple/quick tasks by combining:\n    1. se3 start - Initialize the session\n    2. se3 work --new - Create a change for the work\n    3. Implementation (performed by agent)\n    4. se3 done - Complete the session\n\n    Examples:\n        se3 full-cycle \"fix login bug\"\n        se3 full-cycle \"add user profile page\" --quick\n        se3 full-cycle \"update documentation\" -q --json\n    \"\"\"\n    _full_cycle_cmd_impl(description, project_root, quick, format)\n\n\n@app.command(name=\"fc\")\ndef fc_cmd(\n    description: str = typer.Argument(..., help=\"Description of the work to do\"),\n    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n    quick: bool = typer.Option(False, \"--quick\", \"-q\", help=\"Quick mode - skip formal change creation, use 'small' workflow\"),\n    format: str = typer.Option(\"text\", \"--format\", \"-f\", help=\"Output format (text or json)\"),\n):\n    \"\"\"Alias for 'full-cycle' - Run the complete start-work-done workflow in one command.\"\"\"\n    _full_cycle_cmd_impl(description, project_root, quick, format)\n\n# Register handoff as a direct command (not a sub-typer)\n@app.command(name=\"handoff\")\ndef handoff_cmd(\n    message: Optional[str] = typer.Argument(None, help=\"Handoff message describing what was done\"),\n    project_root: Optional[str] = typer.Option(None, \"--project-root\", \"-p\", help=\"Project root directory\"),\n    dry_run: bool = typer.Option(False, \"--dry-run\", help=\"Preview what would happen without executing\"),\n    skip_commit: bool = typer.Option(False, \"--skip-commit\", help=\"Skip automatic commit (use with caution)\"),\n):\n    \"\"\"Handoff control to human — enforcing SE3 commit-before-handoff rule.\"\"\"\n    from .commands.handoff import handoff\n    handoff(message=message, project_root=project_root, dry_run=dry_run, skip_commit=skip_commit)\n\n\n@app.command(name=\"claude-cmd\")\ndef claude_cmd(\n    all_cmds: bool = typer.Option(False, \"--all\", help=\"Output all commands as JSON sorted by priority\"),\n    next_after: Optional[str] = typer.Option(None, \"--next\", help=\"Output the next command after the given one\"),\n    project_root: Optional[str] = typer.Option(None, \"--project-root\", \"-p\", help=\"Project root directory\"),\n):\n    \"\"\"Show configured Claude commands by priority.\n\n    Used by bash scripts to resolve which Claude command to use.\n    \"\"\"\n    from .config import load_claude_commands\n\n    root = Path(project_root) if project_root else Path.cwd()\n    commands = load_claude_commands(root)\n\n    if all_cmds:\n        typer.echo(json.dumps(commands))\n    elif next_after:\n        found = False\n        for i, entry in enumerate(commands):\n            if entry[\"cmd\"] == next_after:\n                if i + 1 < len(commands):\n                    typer.echo(commands[i + 1][\"cmd\"])\n                else:\n                    typer.echo(\"\")  # No next command\n                found = True\n                break\n        if not found:\n            typer.echo(\"\")  # Command not in list\n    else:\n        # Default: output highest-priority command\n        typer.echo(commands[0][\"cmd\"])\n\n\nif __name__ == \"__main__\":\n    app()\n","numLines":243,"startLine":1,"totalLines":243}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"tool_Nt0xy0A7vZkucBg5IPHfMIHl","type":"tool_result","content":"     1→\"\"\"Human calls detection and processing module for SE 3.0.\n     2→\n     3→Provides optimized human call file handling with:\n     4→- Structured storage format with frontmatter\n     5→- Efficient change-based detection using file timestamps\n     6→- Response integrity validation\n     7→- Multi-language support\n     8→\"\"\"\n     9→\n    10→import re\n    11→import os\n    12→import json\n    13→from dataclasses import dataclass, field, asdict\n    14→from datetime import datetime, timedelta, timezone\n    15→from enum import Enum\n    16→from pathlib import Path\n    17→from typing import Dict, List, Optional, Any, Callable, Set, Tuple\n    18→import hashlib\n    19→\n    20→\n    21→class CallStatus(Enum):\n    22→    \"\"\"Human call status states.\"\"\"\n    23→    PENDING = \"pending\"\n    24→    RESPONDED = \"responded\"\n    25→    PROCESSING = \"processing\"\n    26→    COMPLETED = \"completed\"\n    27→    EXPIRED = \"expired\"\n    28→\n    29→\n    30→class CallType(Enum):\n    31→    \"\"\"Human call types.\"\"\"\n    32→    DECISION = \"decision\"\n    33→    ACTION = \"action\"\n    34→    INFORMATION = \"information\"\n    35→    ESCALATION = \"escalation\"\n    36→\n    37→\n    38→class CallPriority(Enum):\n    39→    \"\"\"Human call priority levels.\"\"\"\n    40→    LOW = \"low\"\n    41→    MEDIUM = \"medium\"\n    42→    HIGH = \"high\"\n    43→    CRITICAL = \"critical\"\n    44→\n    45→\n    46→@dataclass\n    47→class HumanCall:\n    48→    \"\"\"Represents a human call with metadata and content.\n    49→\n    50→    Attributes:\n    51→        id: Unique identifier for the call\n    52→        file_path: Path to the call file\n    53→        call_type: Type of call (decision, action, information, escalation)\n    54→        priority: Priority level\n    55→        status: Current status\n    56→        created: Creation timestamp\n    57→        source: Source component (e.g., collab-orchestrator, worker)\n    58→        title: Call title/subject\n    59→        context: Call context/description\n    60→        response: Human response content\n    61→        response_timestamp: When response was received\n    62→        metadata: Additional metadata\n    63→    \"\"\"\n    64→    id: str\n    65→    file_path: Path\n    66→    call_type: CallType = CallType.ACTION\n    67→    priority: CallPriority = CallPriority.MEDIUM\n    68→    status: CallStatus = CallStatus.PENDING\n    69→    created: datetime = field(default_factory=datetime.now)\n    70→    source: str = \"unknown\"\n    71→    title: str = \"\"\n    72→    context: str = \"\"\n    73→    response: str = \"\"\n    74→    response_timestamp: Optional[datetime] = None\n    75→    metadata: Dict[str, Any] = field(default_factory=dict)\n    76→\n    77→    def to_dict(self) -> Dict[str, Any]:\n    78→        \"\"\"Convert to dictionary for serialization.\"\"\"\n    79→        return {\n    80→            \"id\": self.id,\n    81→            \"file_path\": str(self.file_path),\n    82→            \"type\": self.call_type.value,\n    83→            \"priority\": self.priority.value,\n    84→            \"status\": self.status.value,\n    85→            \"created\": self.created.isoformat(),\n    86→            \"source\": self.source,\n    87→            \"title\": self.title,\n    88→            \"context\": self.context,\n    89→            \"response\": self.response,\n    90→            \"response_timestamp\": self.response_timestamp.isoformat() if self.response_timestamp else None,\n    91→            \"metadata\": self.metadata,\n    92→        }\n    93→\n    94→    @classmethod\n    95→    def from_dict(cls, data: Dict[str, Any]) -> \"HumanCall\":\n    96→        \"\"\"Create from dictionary.\"\"\"\n    97→        return cls(\n    98→            id=data[\"id\"],\n    99→            file_path=Path(data[\"file_path\"]),\n   100→            call_type=CallType(data.get(\"type\", \"action\")),\n   101→            priority=CallPriority(data.get(\"priority\", \"medium\")),\n   102→            status=CallStatus(data.get(\"status\", \"pending\")),\n   103→            created=datetime.fromisoformat(data[\"created\"]) if \"created\" in data else datetime.now(),\n   104→            source=data.get(\"source\", \"unknown\"),\n   105→            title=data.get(\"title\", \"\"),\n   106→            context=data.get(\"context\", \"\"),\n   107→            response=data.get(\"response\", \"\"),\n   108→            response_timestamp=datetime.fromisoformat(data[\"response_timestamp\"]) if data.get(\"response_timestamp\") else None,\n   109→            metadata=data.get(\"metadata\", {}),\n   110→        )\n   111→\n   112→\n   113→class HumanCallStore:\n   114→    \"\"\"Manages human call files with optimized detection.\n   115→\n   116→    Features:\n   117→    - Efficient change detection using file system events and caching\n   118→    - Structured frontmatter format\n   119→    - Comprehensive response integrity validation\n   120→    - Multi-language support\n   121→    - Batch processing capabilities\n   122→    \"\"\"\n   123→\n   124→    # File patterns\n   125→    CALL_FILE_PATTERN = \"*.md\"\n   126→    RESPONDED_SUFFIX = \".responded\"\n   127→    PROCESSING_SUFFIX = \".processing\"\n   128→    COMPLETED_SUFFIX = \".completed\"\n   129→\n   130→    # Response section headers (multi-language)\n   131→    RESPONSE_HEADERS = [\"### Response\", \"### 回复\", \"### Réponse\"]\n   132→    CONTEXT_HEADERS = [\"### Context\", \"### 上下文\", \"### Contexte\"]\n   133→\n   134→    # Default prompt markers that indicate no response yet\n   135→    DEFAULT_PROMPT_MARKERS = [\n   136→        \"<!-- Human: write your response below -->\",\n   137→        \"<!-- 人类：请在下方输入您的回复 -->\",\n   138→        \"<!-- Humain: écrivez votre réponse ci-dessous -->\",\n   139→    ]\n   140→\n   141→    # Minimum response requirements\n   142→    MIN_RESPONSE_LENGTH = 10\n   143→    MIN_MEANINGFUL_CHARS = 5\n   144→    MAX_RESPONSE_LENGTH = 10000\n   145→\n   146→    def __init__(self, calls_dir: Path):\n   147→        \"\"\"Initialize the store.\n   148→\n   149→        Args:\n   150→            calls_dir: Directory containing human call files\n   151→        \"\"\"\n   152→        self.calls_dir = Path(calls_dir)\n   153→        self.calls_dir.mkdir(parents=True, exist_ok=True)\n   154→\n   155→        # State tracking for efficient change detection\n   156→        self._last_scan_time: Optional[datetime] = None\n   157→        self._file_hashes: Dict[str, str] = {}\n   158→        self._file_mtimes: Dict[str, float] = {}\n   159→        self._call_cache: Dict[str, HumanCall] = {}\n   160→\n   161→        # Pre-scan to populate initial state\n   162→        self._initialize_cache()\n   163→\n   164→    def _initialize_cache(self):\n   165→        \"\"\"Initialize cache with existing call files.\"\"\"\n   166→        for filepath in self.calls_dir.glob(self.CALL_FILE_PATTERN):\n   167→            if filepath.is_file():\n   168→                path_str = str(filepath)\n   169→                self._file_mtimes[path_str] = filepath.stat().st_mtime\n   170→                self._file_hashes[path_str] = self._compute_file_hash(filepath)\n   171→                call = self.parse_call_file(filepath)\n   172→                if call:\n   173→                    self._call_cache[path_str] = call\n   174→        self._last_scan_time = datetime.now()\n   175→\n   176→    def _compute_file_hash(self, filepath: Path) -> str:\n   177→        \"\"\"Compute hash of file content for change detection.\n   178→\n   179→        Optimized to read only first 1KB for faster hash computation\n   180→        \"\"\"\n   181→        with open(filepath, 'rb') as f:\n   182→            content = f.read(1024)  # Read first 1KB for faster hashing\n   183→            return hashlib.sha256(content).hexdigest()[:16]\n   184→\n   185→    def _parse_frontmatter(self, content: str) -> Tuple[Dict[str, Any], str]:\n   186→        \"\"\"Parse YAML-like frontmatter from markdown content.\n   187→\n   188→        Returns:\n   189→            Tuple of (frontmatter dict, body content)\n   190→        \"\"\"\n   191→        frontmatter = {}\n   192→        body = content\n   193→\n   194→        # Match frontmatter between --- markers\n   195→        match = re.match(r'^---\\s*\\n(.*?)\\n---\\s*\\n(.*)', content, re.DOTALL)\n   196→        if match:\n   197→            fm_text = match.group(1)\n   198→            body = match.group(2)\n   199→\n   200→            # Parse key: value pairs\n   201→            for line in fm_text.strip().split('\\n'):\n   202→                if ':' in line:\n   203→                    key, value = line.split(':', 1)\n   204→                    frontmatter[key.strip()] = value.strip()\n   205→\n   206→        return frontmatter, body\n   207→\n   208→    def _extract_section(self, content: str, headers: List[str]) -> str:\n   209→        \"\"\"Extract content under a section header.\n   210→\n   211→        Args:\n   212→            content: Full markdown content\n   213→            headers: List of possible section headers to match\n   214→\n   215→        Returns:\n   216→            Section content or empty string if not found\n   217→        \"\"\"\n   218→        lines = content.split('\\n')\n   219→        in_section = False\n   220→        section_lines = []\n   221→\n   222→        for line in lines:\n   223→            # Check if this is the target section header\n   224→            if any(line.strip().startswith(header) for header in headers):\n   225→                in_section = True\n   226→                continue\n   227→\n   228→            # Check if we've reached the next section\n   229→            if in_section and line.strip().startswith('### '):\n   230→                break\n   231→\n   232→            if in_section:\n   233→                section_lines.append(line)\n   234→\n   235→        return '\\n'.join(section_lines).strip()\n   236→\n   237→    def _has_meaningful_response(self, content: str) -> bool:\n   238→        \"\"\"Check if content contains a meaningful human response.\n   239→\n   240→        Args:\n   241→            content: Response section content\n   242→\n   243→        Returns:\n   244→            True if response appears meaningful, False otherwise\n   245→        \"\"\"\n   246→        if not content:\n   247→            return False\n   248→\n   249→        # Check for default prompt markers (indicates no real response)\n   250→        for marker in self.DEFAULT_PROMPT_MARKERS:\n   251→            if marker in content:\n   252→                return False\n   253→\n   254→        # Check for HTML comments only (empty response)\n   255→        cleaned = re.sub(r'<!--.*?-->', '', content, flags=re.DOTALL).strip()\n   256→        if not cleaned:\n   257→            return False\n   258→\n   259→        # Check minimum meaningful content length (at least 10 chars)\n   260→        if len(cleaned) < 10:\n   261→            return False\n   262→\n   263→        return True\n   264→\n   265→    def _generate_call_id(self, title: str, timestamp: Optional[datetime] = None) -> str:\n   266→        \"\"\"Generate a unique call ID.\n   267→\n   268→        Format: {YYYYMMDD}-{HHmmss}-{short-description}\n   269→        \"\"\"\n   270→        ts = timestamp or datetime.now()\n   271→        # Clean title for filename\n   272→        clean_title = re.sub(r'[^\\w\\s-]', '', title.lower())\n   273→        clean_title = re.sub(r'[-\\s]+', '-', clean_title).strip('-')[:30]\n   274→        return f\"{ts.strftime('%Y%m%d-%H%M%S')}-{clean_title}\"\n   275→\n   276→    def create_call(\n   277→        self,\n   278→        title: str,\n   279→        context: str,\n   280→        call_type: CallType = CallType.ACTION,\n   281→        priority: CallPriority = CallPriority.MEDIUM,\n   282→        source: str = \"unknown\",\n   283→        language: str = \"en\",\n   284→        metadata: Optional[Dict[str, Any]] = None,\n   285→    ) -> HumanCall:\n   286→        \"\"\"Create a new human call file.\n   287→\n   288→        Args:\n   289→            title: Call title\n   290→            context: Call context/description\n   291→            call_type: Type of call\n   292→            priority: Priority level\n   293→            source: Source component\n   294→            language: Language code (en, zh, etc.)\n   295→            metadata: Additional metadata\n   296→\n   297→        Returns:\n   298→            Created HumanCall object\n   299→        \"\"\"\n   300→        call_id = self._generate_call_id(title)\n   301→        filepath = self.calls_dir / f\"{call_id}.md\"\n   302→\n   303→        # Load language labels from config module\n   304→        from .config import get_language_labels, is_chinese_language\n   305→        t = get_language_labels(language)\n   306→\n   307→        # Add language guidance for context content\n   308→        if is_chinese_language(language):\n   309→            language_note = \"\\n\\n**注意**：请用中文回复。\"\n   310→        else:\n   311→            language_note = \"\"\n   312→\n   313→        # Build frontmatter and content\n   314→        content = f\"\"\"---\n   315→id: {call_id}\n   316→type: {call_type.value}\n   317→priority: {priority.value}\n   318→status: pending\n   319→created: {datetime.now().isoformat()}\n   320→source: {source}\n   321→language: {language}\n   322→---\n   323→\n   324→## Request: {title}\n   325→\n   326→**{t['type']}**: {call_type.value}\n   327→**{t['urgency']}**: {priority.value}\n   328→**{t['source']}**: {source}\n   329→\n   330→### {t['context']}\n   331→{context}{language_note}\n   332→\n   333→### {t['response']}\n   334→{t['prompt']}\n   335→\"\"\"\n   336→\n   337→        filepath.write_text(content, encoding=\"utf-8\")\n   338→\n   339→        call = HumanCall(\n   340→            id=call_id,\n   341→            file_path=filepath,\n   342→            call_type=call_type,\n   343→            priority=priority,\n   344→            status=CallStatus.PENDING,\n   345→            created=datetime.now(),\n   346→            source=source,\n   347→            title=title,\n   348→            context=context,\n   349→            metadata=metadata or {},\n   350→        )\n   351→\n   352→        # Update tracking\n   353→        self._file_hashes[str(filepath)] = self._compute_file_hash(filepath)\n   354→        self._file_mtimes[str(filepath)] = filepath.stat().st_mtime\n   355→\n   356→        return call\n   357→\n   358→    def parse_call_file(self, filepath: Path) -> Optional[HumanCall]:\n   359→        \"\"\"Parse a human call file.\n   360→\n   361→        Args:\n   362→            filepath: Path to the call file\n   363→\n   364→        Returns:\n   365→            HumanCall object or None if parsing fails\n   366→        \"\"\"\n   367→        try:\n   368→            content = filepath.read_text(encoding=\"utf-8\")\n   369→            frontmatter, body = self._parse_frontmatter(content)\n   370→\n   371→            call_id = frontmatter.get(\"id\") or filepath.stem\n   372→\n   373→            # Determine status from file suffix or frontmatter\n   374→            status = CallStatus(frontmatter.get(\"status\", \"pending\"))\n   375→            if filepath.suffix == \".responded\" or filepath.name.endswith(\".responded.md\"):\n   376→                status = CallStatus.RESPONDED\n   377→            elif filepath.suffix == \".processing\" or filepath.name.endswith(\".processing.md\"):\n   378→                status = CallStatus.PROCESSING\n   379→            elif filepath.suffix == \".completed\" or filepath.name.endswith(\".completed.md\"):\n   380→                status = CallStatus.COMPLETED\n   381→\n   382→            # Extract response if present\n   383→            response = self._extract_section(body, self.RESPONSE_HEADERS)\n   384→            response_timestamp = None\n   385→\n   386→            # If we have a meaningful response, update status\n   387→            if self._has_meaningful_response(response):\n   388→                status = CallStatus.RESPONDED\n   389→                # Try to get response timestamp from file mtime\n   390→                stat = filepath.stat()\n   391→                response_timestamp = datetime.fromtimestamp(stat.st_mtime, tz=timezone.utc)\n   392→\n   393→            # Parse created timestamp\n   394→            created_str = frontmatter.get(\"created\", \"\")\n   395→            try:\n   396→                if created_str:\n   397→                    created = datetime.fromisoformat(created_str)\n   398→                    # Ensure timezone-aware (default to UTC if naive)\n   399→                    if created.tzinfo is None:\n   400→                        created = created.replace(tzinfo=timezone.utc)\n   401→                else:\n   402→                    created = datetime.fromtimestamp(filepath.stat().st_ctime, tz=timezone.utc)\n   403→            except ValueError:\n   404→                created = datetime.fromtimestamp(filepath.stat().st_ctime, tz=timezone.utc)\n   405→\n   406→            return HumanCall(\n   407→                id=call_id,\n   408→                file_path=filepath,\n   409→                call_type=CallType(frontmatter.get(\"type\", \"action\")),\n   410→                priority=CallPriority(frontmatter.get(\"priority\", \"medium\")),\n   411→                status=status,\n   412→                created=created,\n   413→                source=frontmatter.get(\"source\", \"unknown\"),\n   414→                title=self._extract_title(body) or filepath.stem,\n   415→                context=self._extract_section(body, self.CONTEXT_HEADERS),\n   416→                response=response,\n   417→                response_timestamp=response_timestamp,\n   418→                metadata={k: v for k, v in frontmatter.items() if k not in [\"id\", \"type\", \"priority\", \"status\", \"created\", \"source\", \"language\"]},\n   419→            )\n   420→        except (IOError, ValueError, KeyError) as e:\n   421→            return None\n   422→\n   423→    def _extract_title(self, body: str) -> str:\n   424→        \"\"\"Extract title from markdown body.\"\"\"\n   425→        match = re.search(r'^## Request:\\s*(.+)$', body, re.MULTILINE)\n   426→        if match:\n   427→            return match.group(1).strip()\n   428→        # Fallback: look for any level 2 heading\n   429→        match = re.search(r'^##\\s*(.+)$', body, re.MULTILINE)\n   430→        if match:\n   431→            return match.group(1).strip()\n   432→        return \"\"\n   433→\n   434→    def get_all_calls(self, include_completed: bool = False) -> List[HumanCall]:\n   435→        \"\"\"Get all human calls.\n   436→\n   437→        Args:\n   438→            include_completed: Whether to include completed calls\n   439→\n   440→        Returns:\n   441→            List of HumanCall objects\n   442→        \"\"\"\n   443→        calls = []\n   444→\n   445→        for filepath in self.calls_dir.glob(self.CALL_FILE_PATTERN):\n   446→            # Skip non-call files\n   447→            if not filepath.is_file():\n   448→                continue\n   449→\n   450→            call = self.parse_call_file(filepath)\n   451→            if call:\n   452→                if not include_completed and call.status in (CallStatus.COMPLETED, CallStatus.EXPIRED):\n   453→                    continue\n   454→                calls.append(call)\n   455→\n   456→        return sorted(calls, key=lambda c: c.created, reverse=True)\n   457→\n   458→    def get_pending_calls(self) -> List[HumanCall]:\n   459→        \"\"\"Get all pending calls (no response yet).\"\"\"\n   460→        return [c for c in self.get_all_calls() if c.status == CallStatus.PENDING]\n   461→\n   462→    def get_responded_calls(self) -> List[HumanCall]:\n   463→        \"\"\"Get all calls with responses waiting to be processed.\"\"\"\n   464→        return [c for c in self.get_all_calls() if c.status == CallStatus.RESPONDED]\n   465→\n   466→    def get_changed_calls(self, force_rescan: bool = False) -> List[HumanCall]:\n   467→        \"\"\"Get calls that have changed since last scan.\n   468→\n   469→        Optimized change detection using:\n   470→        - File system metadata (mtime) for fast checks\n   471→        - Caching parsed calls for repeated access\n   472→        - Batch processing for efficiency\n   473→\n   474→        Args:\n   475→            force_rescan: Force a full rescan even if no changes detected\n   476→\n   477→        Returns:\n   478→            List of changed HumanCall objects\n   479→        \"\"\"\n   480→        changed = []\n   481→        current_files = set()\n   482→\n   483→        for filepath in self.calls_dir.glob(self.CALL_FILE_PATTERN):\n   484→            if not filepath.is_file():\n   485→                continue\n   486→\n   487→            path_str = str(filepath)\n   488→            current_files.add(path_str)\n   489→            current_mtime = filepath.stat().st_mtime\n   490→\n   491→            # Check if file is new or changed\n   492→            is_new = path_str not in self._file_mtimes\n   493→            is_modified = (\n   494→                path_str in self._file_mtimes and\n   495→                self._file_mtimes[path_str] != current_mtime\n   496→            )\n   497→\n   498→            if is_new or is_modified or force_rescan:\n   499→                # Compute hash only if mtime changed (optimization)\n   500→                current_hash = self._compute_file_hash(filepath)\n   501→                content_changed = (\n   502→                    path_str in self._file_hashes and\n   503→                    self._file_hashes[path_str] != current_hash\n   504→                )\n   505→\n   506→                if is_new or content_changed or force_rescan:\n   507→                    call = self.parse_call_file(filepath)\n   508→                    if call:\n   509→                        changed.append(call)\n   510→                        self._call_cache[path_str] = call\n   511→                self._file_hashes[path_str] = current_hash\n   512→\n   513→            # Update tracking\n   514→            self._file_mtimes[path_str] = current_mtime\n   515→\n   516→        # Handle deleted files\n   517→        for path_str in list(self._file_mtimes.keys()):\n   518→            if path_str not in current_files:\n   519→                del self._file_mtimes[path_str]\n   520→                if path_str in self._file_hashes:\n   521→                    del self._file_hashes[path_str]\n   522→                if path_str in self._call_cache:\n   523→                    del self._call_cache[path_str]\n   524→\n   525→        self._last_scan_time = datetime.now()\n   526→        return changed\n   527→\n   528→    def get_cached_call(self, filepath: Path) -> Optional[HumanCall]:\n   529→        \"\"\"Get a call from cache or parse it if not cached.\n   530→\n   531→        Args:\n   532→            filepath: Path to the call file\n   533→\n   534→        Returns:\n   535→            Cached or parsed HumanCall object\n   536→        \"\"\"\n   537→        path_str = str(filepath)\n   538→        if path_str in self._call_cache:\n   539→            # Check if file has been modified since last cache\n   540→            current_mtime = filepath.stat().st_mtime\n   541→            if self._file_mtimes.get(path_str, 0) == current_mtime:\n   542→                return self._call_cache[path_str]\n   543→\n   544→        # Parse and cache\n   545→        call = self.parse_call_file(filepath)\n   546→        if call:\n   547→            self._call_cache[path_str] = call\n   548→            self._file_mtimes[path_str] = filepath.stat().st_mtime\n   549→            self._file_hashes[path_str] = self._compute_file_hash(filepath)\n   550→        return call\n   551→\n   552→    def mark_processing(self, call: HumanCall) -> None:\n   553→        \"\"\"Mark a call as being processed.\n   554→\n   555→        Args:\n   556→            call: The call to mark\n   557→        \"\"\"\n   558→        call.status = CallStatus.PROCESSING\n   559→        new_path = call.file_path.with_suffix(\".processing.md\")\n   560→\n   561→        # Rename file to indicate processing state\n   562→        if call.file_path.exists():\n   563→            call.file_path.rename(new_path)\n   564→            call.file_path = new_path\n   565→\n   566→        # Update tracking\n   567→        old_path_str = str(call.file_path.with_suffix(\".md\"))\n   568→        if old_path_str in self._file_hashes:\n   569→            del self._file_hashes[old_path_str]\n   570→        if old_path_str in self._file_mtimes:\n   571→            del self._file_mtimes[old_path_str]\n   572→        if old_path_str in self._call_cache:\n   573→            del self._call_cache[old_path_str]\n   574→\n   575→        self._file_hashes[str(new_path)] = self._compute_file_hash(new_path)\n   576→        self._file_mtimes[str(new_path)] = new_path.stat().st_mtime\n   577→        self._call_cache[str(new_path)] = call\n   578→\n   579→    def mark_completed(self, call: HumanCall) -> None:\n   580→        \"\"\"Mark a call as completed.\n   581→\n   582→        Args:\n   583→            call: The call to mark\n   584→        \"\"\"\n   585→        call.status = CallStatus.COMPLETED\n   586→        new_path = call.file_path.with_suffix(\".completed.md\")\n   587→\n   588→        # Rename file to indicate completed state\n   589→        if call.file_path.exists():\n   590→            call.file_path.rename(new_path)\n   591→            call.file_path = new_path\n   592→\n   593→        # Update tracking\n   594→        old_path_str = str(call.file_path.with_suffix(\".processing.md\"))\n   595→        if old_path_str in self._file_hashes:\n   596→            del self._file_hashes[old_path_str]\n   597→        if old_path_str in self._file_mtimes:\n   598→            del self._file_mtimes[old_path_str]\n   599→        if old_path_str in self._call_cache:\n   600→            del self._call_cache[old_path_str]\n   601→\n   602→        self._call_cache[str(new_path)] = call\n   603→\n   604→    def process_responded_calls(self, processor: Callable[[HumanCall], bool]) -> List[HumanCall]:\n   605→        \"\"\"Process all responded calls with a custom processor.\n   606→\n   607→        Args:\n   608→            processor: Function to process each call. Returns True if processing succeeded.\n   609→\n   610→        Returns:\n   611→            List of calls that were successfully processed\n   612→        \"\"\"\n   613→        processed = []\n   614→        responded_calls = self.get_responded_calls()\n   615→\n   616→        for call in responded_calls:\n   617→            self.mark_processing(call)\n   618→            try:\n   619→                success = processor(call)\n   620→                if success:\n   621→                    self.mark_completed(call)\n   622→                    processed.append(call)\n   623→                else:\n   624→                    # Revert to responded state if processing failed\n   625→                    self._revert_to_responded(call)\n   626→            except Exception as e:\n   627→                self._revert_to_responded(call)\n   628→                raise e\n   629→\n   630→        return processed\n   631→\n   632→    def _revert_to_responded(self, call: HumanCall) -> None:\n   633→        \"\"\"Revert a call from processing state to responded state.\n   634→\n   635→        Args:\n   636→            call: The call to revert\n   637→        \"\"\"\n   638→        call.status = CallStatus.RESPONDED\n   639→        new_path = call.file_path.with_suffix(\".md\")\n   640→\n   641→        if call.file_path.exists():\n   642→            call.file_path.rename(new_path)\n   643→            call.file_path = new_path\n   644→\n   645→        # Update tracking\n   646→        self._file_hashes[str(new_path)] = self._compute_file_hash(new_path)\n   647→        self._file_mtimes[str(new_path)] = new_path.stat().st_mtime\n   648→        self._call_cache[str(new_path)] = call\n   649→\n   650→    def batch_validate_responses(self, calls: List[HumanCall]) -> List[Tuple[HumanCall, bool, str]]:\n   651→        \"\"\"Validate multiple responses in batch.\n   652→\n   653→        Args:\n   654→            calls: List of calls to validate\n   655→\n   656→        Returns:\n   657→            List of (call, is_valid, reason) tuples\n   658→        \"\"\"\n   659→        results = []\n   660→        for call in calls:\n   661→            is_valid, reason = self.validate_response(call)\n   662→            results.append((call, is_valid, reason))\n   663→        return results\n   664→\n   665→    def validate_response(self, call: HumanCall) -> Tuple[bool, str]:\n   666→        \"\"\"Validate a human response for completeness and accuracy.\n   667→\n   668→        Comprehensive validation including:\n   669→        - Presence of response content\n   670→        - Absence of default prompt markers\n   671→        - Length checks (minimum and maximum)\n   672→        - Content quality checks\n   673→        - Structural validity\n   674→\n   675→        Args:\n   676→            call: The call to validate\n   677→\n   678→        Returns:\n   679→            Tuple of (is_valid, reason)\n   680→        \"\"\"\n   681→        if not call.response:\n   682→            return False, \"No response content\"\n   683→\n   684→        # Check for default prompt markers\n   685→        for marker in self.DEFAULT_PROMPT_MARKERS:\n   686→            if marker in call.response:\n   687→                return False, \"Response contains default prompt marker\"\n   688→\n   689→        # Clean response by removing comments\n   690→        cleaned = re.sub(r'<!--.*?-->', '', call.response, flags=re.DOTALL).strip()\n   691→\n   692→        # Check minimum length\n   693→        if len(cleaned) < self.MIN_RESPONSE_LENGTH:\n   694→            return False, f\"Response too short ({len(cleaned)} chars, minimum {self.MIN_RESPONSE_LENGTH})\"\n   695→\n   696→        # Check maximum length\n   697→        if len(cleaned) > self.MAX_RESPONSE_LENGTH:\n   698→            return False, f\"Response too long ({len(cleaned)} chars, maximum {self.MAX_RESPONSE_LENGTH})\"\n   699→\n   700→        # Check for meaningful content (not just whitespace or punctuation)\n   701→        meaningful_chars = re.sub(r'[\\s\\W]', '', cleaned)\n   702→        if len(meaningful_chars) < self.MIN_MEANINGFUL_CHARS:\n   703→            return False, \"Response lacks meaningful content\"\n   704→\n   705→        # Check for repetitive content\n   706→        if self._is_repetitive(cleaned):\n   707→            return False, \"Response contains repetitive or boilerplate content\"\n   708→\n   709→        # Check for valid response structure\n   710→        if not self._has_valid_structure(cleaned):\n   711→            return False, \"Response has invalid structure\"\n   712→\n   713→        return True, \"Response is valid\"\n   714→\n   715→    def _is_repetitive(self, content: str) -> bool:\n   716→        \"\"\"Check if content is repetitive or boilerplate.\n   717→\n   718→        Args:\n   719→            content: Response content to check\n   720→\n   721→        Returns:\n   722→            True if content is repetitive\n   723→        \"\"\"\n   724→        # Check for repeated patterns\n   725→        patterns = [\n   726→            r'(\\w+)(\\s+\\1){3,}',  # Same word repeated 4+ times\n   727→            r'(.{5,})(\\1){2,}',    # 5+ char sequence repeated 3+ times\n   728→        ]\n   729→\n   730→        for pattern in patterns:\n   731→            if re.search(pattern, content, re.IGNORECASE):\n   732→                return True\n   733→\n   734→        # Check for excessive punctuation\n   735→        punctuation_ratio = sum(1 for c in content if c in '.,!?;:') / len(content)\n   736→        if punctuation_ratio > 0.3:\n   737→            return True\n   738→\n   739→        return False\n   740→\n   741→    def _has_valid_structure(self, content: str) -> bool:\n   742→        \"\"\"Check if response has a valid structure.\n   743→\n   744→        Args:\n   745→            content: Response content to check\n   746→\n   747→        Returns:\n   748→            True if content has valid structure\n   749→        \"\"\"\n   750→        # At least one sentence with subject and verb structure\n   751→        # Simple check for common sentence patterns\n   752→        has_sentence = re.search(r'[A-Za-z]\\w*.*?[.!?]', content)\n   753→        if has_sentence:\n   754→            return True\n   755→\n   756→        # For non-English responses, check for basic structure\n   757→        if len(re.sub(r'[\\s\\W]', '', content)) >= 10:\n   758→            return True\n   759→\n   760→        return False\n   761→\n   762→    def get_stale_calls(self, timeout_days: int = 7) -> List[HumanCall]:\n   763→        \"\"\"Get calls that have been pending for too long.\n   764→\n   765→        Args:\n   766→            timeout_days: Days after which a call is considered stale\n   767→\n   768→        Returns:\n   769→            List of stale HumanCall objects\n   770→        \"\"\"\n   771→        cutoff = datetime.now(timezone.utc) - timedelta(days=timeout_days)\n   772→        return [\n   773→            c for c in self.get_all_calls()\n   774→            if c.status == CallStatus.PENDING and c.created < cutoff\n   775→        ]\n   776→\n   777→    def export_to_json(self, output_path: Path, include_completed: bool = False) -> None:\n   778→        \"\"\"Export all calls to JSON.\n   779→\n   780→        Args:\n   781→            output_path: Path to write JSON file\n   782→            include_completed: Whether to include completed calls\n   783→        \"\"\"\n   784→        calls = [c.to_dict() for c in self.get_all_calls(include_completed)]\n   785→        output_path.write_text(json.dumps(calls, indent=2, default=str), encoding=\"utf-8\")\n   786→\n   787→    def _get_archive_dir(self) -> Path:\n   788→        \"\"\"Get the archive directory path.\n   789→\n   790→        Returns:\n   791→            Path to the archive directory\n   792→        \"\"\"\n   793→        archive_dir = self.calls_dir / \"archive\"\n   794→        archive_dir.mkdir(parents=True, exist_ok=True)\n   795→        return archive_dir\n   796→\n   797→    def archive_completed_calls(\n   798→        self,\n   799→        days_old: int = 30,\n   800→        dry_run: bool = False,\n   801→        all_completed: bool = False\n   802→    ) -> List[Dict[str, Any]]:\n   803→        \"\"\"Archive completed/expired calls older than N days.\n   804→\n   805→        Args:\n   806→            days_old: Minimum age in days for calls to be archived (default 30)\n   807→            dry_run: If True, only preview what would be archived without moving files\n   808→            all_completed: If True, archive all completed calls regardless of age\n   809→\n   810→        Returns:\n   811→            List of archived call info dicts with keys: id, title, file_path, archive_path\n   812→        \"\"\"\n   813→        archived = []\n   814→        archive_dir = self._get_archive_dir()\n   815→\n   816→        # Calculate cutoff date for age-based archiving\n   817→        if not all_completed:\n   818→            cutoff = datetime.now(timezone.utc) - timedelta(days=days_old)\n   819→        else:\n   820→            cutoff = datetime.now(timezone.utc)  # All completed calls will pass\n   821→\n   822→        # Get all calls including completed\n   823→        all_calls = self.get_all_calls(include_completed=True)\n   824→\n   825→        for call in all_calls:\n   826→            # Archive completed, expired, or responded calls\n   827→            if call.status not in (CallStatus.COMPLETED, CallStatus.EXPIRED, CallStatus.RESPONDED):\n   828→                continue\n   829→\n   830→            # Check age unless all_completed is True\n   831→            if not all_completed:\n   832→                # Use response_timestamp if available, otherwise use created\n   833→                check_time = call.response_timestamp or call.created\n   834→                if check_time and check_time.tzinfo is None:\n   835→                    check_time = check_time.replace(tzinfo=timezone.utc)\n   836→                if check_time and check_time >= cutoff:\n   837→                    continue\n   838→\n   839→            # Determine archive path\n   840→            archive_path = archive_dir / call.file_path.name\n   841→\n   842→            # Handle name collisions\n   843→            counter = 1\n   844→            original_archive_path = archive_path\n   845→            while archive_path.exists() and not dry_run:\n   846→                stem = original_archive_path.stem\n   847→                suffix = original_archive_path.suffix\n   848→                archive_path = archive_dir / f\"{stem}_{counter}{suffix}\"\n   849→                counter += 1\n   850→\n   851→            archived_info = {\n   852→                \"id\": call.id,\n   853→                \"title\": call.title,\n   854→                \"status\": call.status.value,\n   855→                \"file_path\": str(call.file_path),\n   856→                \"archive_path\": str(archive_path),\n   857→                \"created\": call.created.isoformat() if call.created else None,\n   858→                \"response_timestamp\": call.response_timestamp.isoformat() if call.response_timestamp else None,\n   859→            }\n   860→\n   861→            if not dry_run:\n   862→                # Move the file to archive\n   863→                if call.file_path.exists():\n   864→                    call.file_path.rename(archive_path)\n   865→\n   866→                    # Update tracking - remove from active tracking\n   867→                    path_str = str(call.file_path)\n   868→                    if path_str in self._file_hashes:\n   869→                        del self._file_hashes[path_str]\n   870→                    if path_str in self._file_mtimes:\n   871→                        del self._file_mtimes[path_str]\n   872→                    if path_str in self._call_cache:\n   873→                        del self._call_cache[path_str]\n   874→\n   875→                    # Add to archive tracking\n   876→                    self._file_hashes[str(archive_path)] = self._compute_file_hash(archive_path)\n   877→                    self._file_mtimes[str(archive_path)] = archive_path.stat().st_mtime\n   878→\n   879→            archived.append(archived_info)\n   880→\n   881→        return archived\n   882→\n   883→    def get_archive_stats(self) -> Dict[str, Any]:\n   884→        \"\"\"Get statistics about archived calls.\n   885→\n   886→        Returns:\n   887→            Dict with archive statistics including:\n   888→            - total_archived: Total number of archived calls\n   889→            - by_status: Count by status (completed, expired)\n   890→            - by_month: Count by month archived\n   891→            - oldest_archive: Date of oldest archived call\n   892→            - newest_archive: Date of newest archived call\n   893→            - archive_dir: Path to archive directory\n   894→        \"\"\"\n   895→        archive_dir = self._get_archive_dir()\n   896→        archived_calls = []\n   897→\n   898→        # Parse all archived call files\n   899→        for filepath in archive_dir.glob(\"*.md\"):\n   900→            if not filepath.is_file():\n   901→                continue\n   902→            call = self.parse_call_file(filepath)\n   903→            if call:\n   904→                archived_calls.append(call)\n   905→\n   906→        # Calculate statistics\n   907→        stats = {\n   908→            \"total_archived\": len(archived_calls),\n   909→            \"by_status\": {\"completed\": 0, \"expired\": 0, \"other\": 0},\n   910→            \"by_month\": {},\n   911→            \"oldest_archive\": None,\n   912→            \"newest_archive\": None,\n   913→            \"archive_dir\": str(archive_dir),\n   914→        }\n   915→\n   916→        if not archived_calls:\n   917→            return stats\n   918→\n   919→        timestamps = []\n   920→        for call in archived_calls:\n   921→            # Count by status\n   922→            if call.status == CallStatus.COMPLETED:\n   923→                stats[\"by_status\"][\"completed\"] += 1\n   924→            elif call.status == CallStatus.EXPIRED:\n   925→                stats[\"by_status\"][\"expired\"] += 1\n   926→            else:\n   927→                stats[\"by_status\"][\"other\"] += 1\n   928→\n   929→            # Get timestamp for date calculations\n   930→            check_time = call.response_timestamp or call.created\n   931→            if check_time:\n   932→                if check_time.tzinfo is None:\n   933→                    check_time = check_time.replace(tzinfo=timezone.utc)\n   934→                timestamps.append(check_time)\n   935→\n   936→                # Count by month (use response_timestamp or created)\n   937→                month_key = check_time.strftime(\"%Y-%m\")\n   938→                stats[\"by_month\"][month_key] = stats[\"by_month\"].get(month_key, 0) + 1\n   939→\n   940→        if timestamps:\n   941→            stats[\"oldest_archive\"] = min(timestamps).isoformat()\n   942→            stats[\"newest_archive\"] = max(timestamps).isoformat()\n   943→\n   944→        return stats\n   945→\n   946→    def restore_from_archive(self, call_id: str) -> Optional[HumanCall]:\n   947→        \"\"\"Restore a call from archive back to active calls.\n   948→\n   949→        Args:\n   950→            call_id: The ID of the call to restore\n   951→\n   952→        Returns:\n   953→            Restored HumanCall or None if not found\n   954→        \"\"\"\n   955→        archive_dir = self._get_archive_dir()\n   956→\n   957→        # Find the archived file by call_id\n   958→        for filepath in archive_dir.glob(\"*.md\"):\n   959→            if not filepath.is_file():\n   960→                continue\n   961→\n   962→            # Check if this file matches the call_id\n   963→            if filepath.stem.startswith(call_id) or call_id in filepath.stem:\n   964→                # Move back to calls directory\n   965→                restore_path = self.calls_dir / filepath.name\n   966→\n   967→                # Handle name collisions\n   968→                counter = 1\n   969→                original_restore_path = restore_path\n   970→                while restore_path.exists():\n   971→                    stem = original_restore_path.stem\n   972→                    suffix = original_restore_path.suffix\n   973→                    restore_path = self.calls_dir / f\"{stem}_{counter}{suffix}\"\n   974→                    counter += 1\n   975→\n   976→                filepath.rename(restore_path)\n   977→\n   978→                # Parse and cache the restored call\n   979→                call = self.parse_call_file(restore_path)\n   980→                if call:\n   981→                    self._file_hashes[str(restore_path)] = self._compute_file_hash(restore_path)\n   982→                    self._file_mtimes[str(restore_path)] = restore_path.stat().st_mtime\n   983→                    self._call_cache[str(restore_path)] = call\n   984→                    return call\n   985→\n   986→        return None\n   987→\n   988→\n   989→# Backwards compatibility: maintain the old discover_human_calls function\n   990→def discover_human_calls(path: str = \"human-calls\") -> List[Dict[str, Any]]:\n   991→    \"\"\"Discover all human call files and their status.\n   992→\n   993→    Legacy compatibility function. Uses the new HumanCallStore internally.\n   994→\n   995→    Args:\n   996→        path: Path to human-calls directory\n   997→\n   998→    Returns:\n   999→        List of dicts with file info and parsed frontmatter\n  1000→    \"\"\"\n  1001→    store = HumanCallStore(Path(path))\n  1002→    calls = store.get_all_calls(include_completed=True)\n  1003→\n  1004→    result = []\n  1005→    for call in calls:\n  1006→        result.append({\n  1007→            'file': call.file_path.name,\n  1008→            'path': str(call.file_path),\n  1009→            'type': call.call_type.value,\n  1010→            'priority': call.priority.value,\n  1011→            'status': call.status.value,\n  1012→            'created': call.created.strftime('%Y-%m-%d'),\n  1013→            'title': call.title,\n  1014→        })\n  1015→\n  1016→    return result\n  1017→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"8924aa60-cb07-4b2b-b7ff-204f57b06f02","uuid":"c579f176-ed8a-490b-9760-cce1a4b91bfd","tool_use_result":{"type":"text","file":{"filePath":"/data/cre/workspace/se3.0/tools/se3_tools/human_calls.py","content":"\"\"\"Human calls detection and processing module for SE 3.0.\n\nProvides optimized human call file handling with:\n- Structured storage format with frontmatter\n- Efficient change-based detection using file timestamps\n- Response integrity validation\n- Multi-language support\n\"\"\"\n\nimport re\nimport os\nimport json\nfrom dataclasses import dataclass, field, asdict\nfrom datetime import datetime, timedelta, timezone\nfrom enum import Enum\nfrom pathlib import Path\nfrom typing import Dict, List, Optional, Any, Callable, Set, Tuple\nimport hashlib\n\n\nclass CallStatus(Enum):\n    \"\"\"Human call status states.\"\"\"\n    PENDING = \"pending\"\n    RESPONDED = \"responded\"\n    PROCESSING = \"processing\"\n    COMPLETED = \"completed\"\n    EXPIRED = \"expired\"\n\n\nclass CallType(Enum):\n    \"\"\"Human call types.\"\"\"\n    DECISION = \"decision\"\n    ACTION = \"action\"\n    INFORMATION = \"information\"\n    ESCALATION = \"escalation\"\n\n\nclass CallPriority(Enum):\n    \"\"\"Human call priority levels.\"\"\"\n    LOW = \"low\"\n    MEDIUM = \"medium\"\n    HIGH = \"high\"\n    CRITICAL = \"critical\"\n\n\n@dataclass\nclass HumanCall:\n    \"\"\"Represents a human call with metadata and content.\n\n    Attributes:\n        id: Unique identifier for the call\n        file_path: Path to the call file\n        call_type: Type of call (decision, action, information, escalation)\n        priority: Priority level\n        status: Current status\n        created: Creation timestamp\n        source: Source component (e.g., collab-orchestrator, worker)\n        title: Call title/subject\n        context: Call context/description\n        response: Human response content\n        response_timestamp: When response was received\n        metadata: Additional metadata\n    \"\"\"\n    id: str\n    file_path: Path\n    call_type: CallType = CallType.ACTION\n    priority: CallPriority = CallPriority.MEDIUM\n    status: CallStatus = CallStatus.PENDING\n    created: datetime = field(default_factory=datetime.now)\n    source: str = \"unknown\"\n    title: str = \"\"\n    context: str = \"\"\n    response: str = \"\"\n    response_timestamp: Optional[datetime] = None\n    metadata: Dict[str, Any] = field(default_factory=dict)\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Convert to dictionary for serialization.\"\"\"\n        return {\n            \"id\": self.id,\n            \"file_path\": str(self.file_path),\n            \"type\": self.call_type.value,\n            \"priority\": self.priority.value,\n            \"status\": self.status.value,\n            \"created\": self.created.isoformat(),\n            \"source\": self.source,\n            \"title\": self.title,\n            \"context\": self.context,\n            \"response\": self.response,\n            \"response_timestamp\": self.response_timestamp.isoformat() if self.response_timestamp else None,\n            \"metadata\": self.metadata,\n        }\n\n    @classmethod\n    def from_dict(cls, data: Dict[str, Any]) -> \"HumanCall\":\n        \"\"\"Create from dictionary.\"\"\"\n        return cls(\n            id=data[\"id\"],\n            file_path=Path(data[\"file_path\"]),\n            call_type=CallType(data.get(\"type\", \"action\")),\n            priority=CallPriority(data.get(\"priority\", \"medium\")),\n            status=CallStatus(data.get(\"status\", \"pending\")),\n            created=datetime.fromisoformat(data[\"created\"]) if \"created\" in data else datetime.now(),\n            source=data.get(\"source\", \"unknown\"),\n            title=data.get(\"title\", \"\"),\n            context=data.get(\"context\", \"\"),\n            response=data.get(\"response\", \"\"),\n            response_timestamp=datetime.fromisoformat(data[\"response_timestamp\"]) if data.get(\"response_timestamp\") else None,\n            metadata=data.get(\"metadata\", {}),\n        )\n\n\nclass HumanCallStore:\n    \"\"\"Manages human call files with optimized detection.\n\n    Features:\n    - Efficient change detection using file system events and caching\n    - Structured frontmatter format\n    - Comprehensive response integrity validation\n    - Multi-language support\n    - Batch processing capabilities\n    \"\"\"\n\n    # File patterns\n    CALL_FILE_PATTERN = \"*.md\"\n    RESPONDED_SUFFIX = \".responded\"\n    PROCESSING_SUFFIX = \".processing\"\n    COMPLETED_SUFFIX = \".completed\"\n\n    # Response section headers (multi-language)\n    RESPONSE_HEADERS = [\"### Response\", \"### 回复\", \"### Réponse\"]\n    CONTEXT_HEADERS = [\"### Context\", \"### 上下文\", \"### Contexte\"]\n\n    # Default prompt markers that indicate no response yet\n    DEFAULT_PROMPT_MARKERS = [\n        \"<!-- Human: write your response below -->\",\n        \"<!-- 人类：请在下方输入您的回复 -->\",\n        \"<!-- Humain: écrivez votre réponse ci-dessous -->\",\n    ]\n\n    # Minimum response requirements\n    MIN_RESPONSE_LENGTH = 10\n    MIN_MEANINGFUL_CHARS = 5\n    MAX_RESPONSE_LENGTH = 10000\n\n    def __init__(self, calls_dir: Path):\n        \"\"\"Initialize the store.\n\n        Args:\n            calls_dir: Directory containing human call files\n        \"\"\"\n        self.calls_dir = Path(calls_dir)\n        self.calls_dir.mkdir(parents=True, exist_ok=True)\n\n        # State tracking for efficient change detection\n        self._last_scan_time: Optional[datetime] = None\n        self._file_hashes: Dict[str, str] = {}\n        self._file_mtimes: Dict[str, float] = {}\n        self._call_cache: Dict[str, HumanCall] = {}\n\n        # Pre-scan to populate initial state\n        self._initialize_cache()\n\n    def _initialize_cache(self):\n        \"\"\"Initialize cache with existing call files.\"\"\"\n        for filepath in self.calls_dir.glob(self.CALL_FILE_PATTERN):\n            if filepath.is_file():\n                path_str = str(filepath)\n                self._file_mtimes[path_str] = filepath.stat().st_mtime\n                self._file_hashes[path_str] = self._compute_file_hash(filepath)\n                call = self.parse_call_file(filepath)\n                if call:\n                    self._call_cache[path_str] = call\n        self._last_scan_time = datetime.now()\n\n    def _compute_file_hash(self, filepath: Path) -> str:\n        \"\"\"Compute hash of file content for change detection.\n\n        Optimized to read only first 1KB for faster hash computation\n        \"\"\"\n        with open(filepath, 'rb') as f:\n            content = f.read(1024)  # Read first 1KB for faster hashing\n            return hashlib.sha256(content).hexdigest()[:16]\n\n    def _parse_frontmatter(self, content: str) -> Tuple[Dict[str, Any], str]:\n        \"\"\"Parse YAML-like frontmatter from markdown content.\n\n        Returns:\n            Tuple of (frontmatter dict, body content)\n        \"\"\"\n        frontmatter = {}\n        body = content\n\n        # Match frontmatter between --- markers\n        match = re.match(r'^---\\s*\\n(.*?)\\n---\\s*\\n(.*)', content, re.DOTALL)\n        if match:\n            fm_text = match.group(1)\n            body = match.group(2)\n\n            # Parse key: value pairs\n            for line in fm_text.strip().split('\\n'):\n                if ':' in line:\n                    key, value = line.split(':', 1)\n                    frontmatter[key.strip()] = value.strip()\n\n        return frontmatter, body\n\n    def _extract_section(self, content: str, headers: List[str]) -> str:\n        \"\"\"Extract content under a section header.\n\n        Args:\n            content: Full markdown content\n            headers: List of possible section headers to match\n\n        Returns:\n            Section content or empty string if not found\n        \"\"\"\n        lines = content.split('\\n')\n        in_section = False\n        section_lines = []\n\n        for line in lines:\n            # Check if this is the target section header\n            if any(line.strip().startswith(header) for header in headers):\n                in_section = True\n                continue\n\n            # Check if we've reached the next section\n            if in_section and line.strip().startswith('### '):\n                break\n\n            if in_section:\n                section_lines.append(line)\n\n        return '\\n'.join(section_lines).strip()\n\n    def _has_meaningful_response(self, content: str) -> bool:\n        \"\"\"Check if content contains a meaningful human response.\n\n        Args:\n            content: Response section content\n\n        Returns:\n            True if response appears meaningful, False otherwise\n        \"\"\"\n        if not content:\n            return False\n\n        # Check for default prompt markers (indicates no real response)\n        for marker in self.DEFAULT_PROMPT_MARKERS:\n            if marker in content:\n                return False\n\n        # Check for HTML comments only (empty response)\n        cleaned = re.sub(r'<!--.*?-->', '', content, flags=re.DOTALL).strip()\n        if not cleaned:\n            return False\n\n        # Check minimum meaningful content length (at least 10 chars)\n        if len(cleaned) < 10:\n            return False\n\n        return True\n\n    def _generate_call_id(self, title: str, timestamp: Optional[datetime] = None) -> str:\n        \"\"\"Generate a unique call ID.\n\n        Format: {YYYYMMDD}-{HHmmss}-{short-description}\n        \"\"\"\n        ts = timestamp or datetime.now()\n        # Clean title for filename\n        clean_title = re.sub(r'[^\\w\\s-]', '', title.lower())\n        clean_title = re.sub(r'[-\\s]+', '-', clean_title).strip('-')[:30]\n        return f\"{ts.strftime('%Y%m%d-%H%M%S')}-{clean_title}\"\n\n    def create_call(\n        self,\n        title: str,\n        context: str,\n        call_type: CallType = CallType.ACTION,\n        priority: CallPriority = CallPriority.MEDIUM,\n        source: str = \"unknown\",\n        language: str = \"en\",\n        metadata: Optional[Dict[str, Any]] = None,\n    ) -> HumanCall:\n        \"\"\"Create a new human call file.\n\n        Args:\n            title: Call title\n            context: Call context/description\n            call_type: Type of call\n            priority: Priority level\n            source: Source component\n            language: Language code (en, zh, etc.)\n            metadata: Additional metadata\n\n        Returns:\n            Created HumanCall object\n        \"\"\"\n        call_id = self._generate_call_id(title)\n        filepath = self.calls_dir / f\"{call_id}.md\"\n\n        # Load language labels from config module\n        from .config import get_language_labels, is_chinese_language\n        t = get_language_labels(language)\n\n        # Add language guidance for context content\n        if is_chinese_language(language):\n            language_note = \"\\n\\n**注意**：请用中文回复。\"\n        else:\n            language_note = \"\"\n\n        # Build frontmatter and content\n        content = f\"\"\"---\nid: {call_id}\ntype: {call_type.value}\npriority: {priority.value}\nstatus: pending\ncreated: {datetime.now().isoformat()}\nsource: {source}\nlanguage: {language}\n---\n\n## Request: {title}\n\n**{t['type']}**: {call_type.value}\n**{t['urgency']}**: {priority.value}\n**{t['source']}**: {source}\n\n### {t['context']}\n{context}{language_note}\n\n### {t['response']}\n{t['prompt']}\n\"\"\"\n\n        filepath.write_text(content, encoding=\"utf-8\")\n\n        call = HumanCall(\n            id=call_id,\n            file_path=filepath,\n            call_type=call_type,\n            priority=priority,\n            status=CallStatus.PENDING,\n            created=datetime.now(),\n            source=source,\n            title=title,\n            context=context,\n            metadata=metadata or {},\n        )\n\n        # Update tracking\n        self._file_hashes[str(filepath)] = self._compute_file_hash(filepath)\n        self._file_mtimes[str(filepath)] = filepath.stat().st_mtime\n\n        return call\n\n    def parse_call_file(self, filepath: Path) -> Optional[HumanCall]:\n        \"\"\"Parse a human call file.\n\n        Args:\n            filepath: Path to the call file\n\n        Returns:\n            HumanCall object or None if parsing fails\n        \"\"\"\n        try:\n            content = filepath.read_text(encoding=\"utf-8\")\n            frontmatter, body = self._parse_frontmatter(content)\n\n            call_id = frontmatter.get(\"id\") or filepath.stem\n\n            # Determine status from file suffix or frontmatter\n            status = CallStatus(frontmatter.get(\"status\", \"pending\"))\n            if filepath.suffix == \".responded\" or filepath.name.endswith(\".responded.md\"):\n                status = CallStatus.RESPONDED\n            elif filepath.suffix == \".processing\" or filepath.name.endswith(\".processing.md\"):\n                status = CallStatus.PROCESSING\n            elif filepath.suffix == \".completed\" or filepath.name.endswith(\".completed.md\"):\n                status = CallStatus.COMPLETED\n\n            # Extract response if present\n            response = self._extract_section(body, self.RESPONSE_HEADERS)\n            response_timestamp = None\n\n            # If we have a meaningful response, update status\n            if self._has_meaningful_response(response):\n                status = CallStatus.RESPONDED\n                # Try to get response timestamp from file mtime\n                stat = filepath.stat()\n                response_timestamp = datetime.fromtimestamp(stat.st_mtime, tz=timezone.utc)\n\n            # Parse created timestamp\n            created_str = frontmatter.get(\"created\", \"\")\n            try:\n                if created_str:\n                    created = datetime.fromisoformat(created_str)\n                    # Ensure timezone-aware (default to UTC if naive)\n                    if created.tzinfo is None:\n                        created = created.replace(tzinfo=timezone.utc)\n                else:\n                    created = datetime.fromtimestamp(filepath.stat().st_ctime, tz=timezone.utc)\n            except ValueError:\n                created = datetime.fromtimestamp(filepath.stat().st_ctime, tz=timezone.utc)\n\n            return HumanCall(\n                id=call_id,\n                file_path=filepath,\n                call_type=CallType(frontmatter.get(\"type\", \"action\")),\n                priority=CallPriority(frontmatter.get(\"priority\", \"medium\")),\n                status=status,\n                created=created,\n                source=frontmatter.get(\"source\", \"unknown\"),\n                title=self._extract_title(body) or filepath.stem,\n                context=self._extract_section(body, self.CONTEXT_HEADERS),\n                response=response,\n                response_timestamp=response_timestamp,\n                metadata={k: v for k, v in frontmatter.items() if k not in [\"id\", \"type\", \"priority\", \"status\", \"created\", \"source\", \"language\"]},\n            )\n        except (IOError, ValueError, KeyError) as e:\n            return None\n\n    def _extract_title(self, body: str) -> str:\n        \"\"\"Extract title from markdown body.\"\"\"\n        match = re.search(r'^## Request:\\s*(.+)$', body, re.MULTILINE)\n        if match:\n            return match.group(1).strip()\n        # Fallback: look for any level 2 heading\n        match = re.search(r'^##\\s*(.+)$', body, re.MULTILINE)\n        if match:\n            return match.group(1).strip()\n        return \"\"\n\n    def get_all_calls(self, include_completed: bool = False) -> List[HumanCall]:\n        \"\"\"Get all human calls.\n\n        Args:\n            include_completed: Whether to include completed calls\n\n        Returns:\n            List of HumanCall objects\n        \"\"\"\n        calls = []\n\n        for filepath in self.calls_dir.glob(self.CALL_FILE_PATTERN):\n            # Skip non-call files\n            if not filepath.is_file():\n                continue\n\n            call = self.parse_call_file(filepath)\n            if call:\n                if not include_completed and call.status in (CallStatus.COMPLETED, CallStatus.EXPIRED):\n                    continue\n                calls.append(call)\n\n        return sorted(calls, key=lambda c: c.created, reverse=True)\n\n    def get_pending_calls(self) -> List[HumanCall]:\n        \"\"\"Get all pending calls (no response yet).\"\"\"\n        return [c for c in self.get_all_calls() if c.status == CallStatus.PENDING]\n\n    def get_responded_calls(self) -> List[HumanCall]:\n        \"\"\"Get all calls with responses waiting to be processed.\"\"\"\n        return [c for c in self.get_all_calls() if c.status == CallStatus.RESPONDED]\n\n    def get_changed_calls(self, force_rescan: bool = False) -> List[HumanCall]:\n        \"\"\"Get calls that have changed since last scan.\n\n        Optimized change detection using:\n        - File system metadata (mtime) for fast checks\n        - Caching parsed calls for repeated access\n        - Batch processing for efficiency\n\n        Args:\n            force_rescan: Force a full rescan even if no changes detected\n\n        Returns:\n            List of changed HumanCall objects\n        \"\"\"\n        changed = []\n        current_files = set()\n\n        for filepath in self.calls_dir.glob(self.CALL_FILE_PATTERN):\n            if not filepath.is_file():\n                continue\n\n            path_str = str(filepath)\n            current_files.add(path_str)\n            current_mtime = filepath.stat().st_mtime\n\n            # Check if file is new or changed\n            is_new = path_str not in self._file_mtimes\n            is_modified = (\n                path_str in self._file_mtimes and\n                self._file_mtimes[path_str] != current_mtime\n            )\n\n            if is_new or is_modified or force_rescan:\n                # Compute hash only if mtime changed (optimization)\n                current_hash = self._compute_file_hash(filepath)\n                content_changed = (\n                    path_str in self._file_hashes and\n                    self._file_hashes[path_str] != current_hash\n                )\n\n                if is_new or content_changed or force_rescan:\n                    call = self.parse_call_file(filepath)\n                    if call:\n                        changed.append(call)\n                        self._call_cache[path_str] = call\n                self._file_hashes[path_str] = current_hash\n\n            # Update tracking\n            self._file_mtimes[path_str] = current_mtime\n\n        # Handle deleted files\n        for path_str in list(self._file_mtimes.keys()):\n            if path_str not in current_files:\n                del self._file_mtimes[path_str]\n                if path_str in self._file_hashes:\n                    del self._file_hashes[path_str]\n                if path_str in self._call_cache:\n                    del self._call_cache[path_str]\n\n        self._last_scan_time = datetime.now()\n        return changed\n\n    def get_cached_call(self, filepath: Path) -> Optional[HumanCall]:\n        \"\"\"Get a call from cache or parse it if not cached.\n\n        Args:\n            filepath: Path to the call file\n\n        Returns:\n            Cached or parsed HumanCall object\n        \"\"\"\n        path_str = str(filepath)\n        if path_str in self._call_cache:\n            # Check if file has been modified since last cache\n            current_mtime = filepath.stat().st_mtime\n            if self._file_mtimes.get(path_str, 0) == current_mtime:\n                return self._call_cache[path_str]\n\n        # Parse and cache\n        call = self.parse_call_file(filepath)\n        if call:\n            self._call_cache[path_str] = call\n            self._file_mtimes[path_str] = filepath.stat().st_mtime\n            self._file_hashes[path_str] = self._compute_file_hash(filepath)\n        return call\n\n    def mark_processing(self, call: HumanCall) -> None:\n        \"\"\"Mark a call as being processed.\n\n        Args:\n            call: The call to mark\n        \"\"\"\n        call.status = CallStatus.PROCESSING\n        new_path = call.file_path.with_suffix(\".processing.md\")\n\n        # Rename file to indicate processing state\n        if call.file_path.exists():\n            call.file_path.rename(new_path)\n            call.file_path = new_path\n\n        # Update tracking\n        old_path_str = str(call.file_path.with_suffix(\".md\"))\n        if old_path_str in self._file_hashes:\n            del self._file_hashes[old_path_str]\n        if old_path_str in self._file_mtimes:\n            del self._file_mtimes[old_path_str]\n        if old_path_str in self._call_cache:\n            del self._call_cache[old_path_str]\n\n        self._file_hashes[str(new_path)] = self._compute_file_hash(new_path)\n        self._file_mtimes[str(new_path)] = new_path.stat().st_mtime\n        self._call_cache[str(new_path)] = call\n\n    def mark_completed(self, call: HumanCall) -> None:\n        \"\"\"Mark a call as completed.\n\n        Args:\n            call: The call to mark\n        \"\"\"\n        call.status = CallStatus.COMPLETED\n        new_path = call.file_path.with_suffix(\".completed.md\")\n\n        # Rename file to indicate completed state\n        if call.file_path.exists():\n            call.file_path.rename(new_path)\n            call.file_path = new_path\n\n        # Update tracking\n        old_path_str = str(call.file_path.with_suffix(\".processing.md\"))\n        if old_path_str in self._file_hashes:\n            del self._file_hashes[old_path_str]\n        if old_path_str in self._file_mtimes:\n            del self._file_mtimes[old_path_str]\n        if old_path_str in self._call_cache:\n            del self._call_cache[old_path_str]\n\n        self._call_cache[str(new_path)] = call\n\n    def process_responded_calls(self, processor: Callable[[HumanCall], bool]) -> List[HumanCall]:\n        \"\"\"Process all responded calls with a custom processor.\n\n        Args:\n            processor: Function to process each call. Returns True if processing succeeded.\n\n        Returns:\n            List of calls that were successfully processed\n        \"\"\"\n        processed = []\n        responded_calls = self.get_responded_calls()\n\n        for call in responded_calls:\n            self.mark_processing(call)\n            try:\n                success = processor(call)\n                if success:\n                    self.mark_completed(call)\n                    processed.append(call)\n                else:\n                    # Revert to responded state if processing failed\n                    self._revert_to_responded(call)\n            except Exception as e:\n                self._revert_to_responded(call)\n                raise e\n\n        return processed\n\n    def _revert_to_responded(self, call: HumanCall) -> None:\n        \"\"\"Revert a call from processing state to responded state.\n\n        Args:\n            call: The call to revert\n        \"\"\"\n        call.status = CallStatus.RESPONDED\n        new_path = call.file_path.with_suffix(\".md\")\n\n        if call.file_path.exists():\n            call.file_path.rename(new_path)\n            call.file_path = new_path\n\n        # Update tracking\n        self._file_hashes[str(new_path)] = self._compute_file_hash(new_path)\n        self._file_mtimes[str(new_path)] = new_path.stat().st_mtime\n        self._call_cache[str(new_path)] = call\n\n    def batch_validate_responses(self, calls: List[HumanCall]) -> List[Tuple[HumanCall, bool, str]]:\n        \"\"\"Validate multiple responses in batch.\n\n        Args:\n            calls: List of calls to validate\n\n        Returns:\n            List of (call, is_valid, reason) tuples\n        \"\"\"\n        results = []\n        for call in calls:\n            is_valid, reason = self.validate_response(call)\n            results.append((call, is_valid, reason))\n        return results\n\n    def validate_response(self, call: HumanCall) -> Tuple[bool, str]:\n        \"\"\"Validate a human response for completeness and accuracy.\n\n        Comprehensive validation including:\n        - Presence of response content\n        - Absence of default prompt markers\n        - Length checks (minimum and maximum)\n        - Content quality checks\n        - Structural validity\n\n        Args:\n            call: The call to validate\n\n        Returns:\n            Tuple of (is_valid, reason)\n        \"\"\"\n        if not call.response:\n            return False, \"No response content\"\n\n        # Check for default prompt markers\n        for marker in self.DEFAULT_PROMPT_MARKERS:\n            if marker in call.response:\n                return False, \"Response contains default prompt marker\"\n\n        # Clean response by removing comments\n        cleaned = re.sub(r'<!--.*?-->', '', call.response, flags=re.DOTALL).strip()\n\n        # Check minimum length\n        if len(cleaned) < self.MIN_RESPONSE_LENGTH:\n            return False, f\"Response too short ({len(cleaned)} chars, minimum {self.MIN_RESPONSE_LENGTH})\"\n\n        # Check maximum length\n        if len(cleaned) > self.MAX_RESPONSE_LENGTH:\n            return False, f\"Response too long ({len(cleaned)} chars, maximum {self.MAX_RESPONSE_LENGTH})\"\n\n        # Check for meaningful content (not just whitespace or punctuation)\n        meaningful_chars = re.sub(r'[\\s\\W]', '', cleaned)\n        if len(meaningful_chars) < self.MIN_MEANINGFUL_CHARS:\n            return False, \"Response lacks meaningful content\"\n\n        # Check for repetitive content\n        if self._is_repetitive(cleaned):\n            return False, \"Response contains repetitive or boilerplate content\"\n\n        # Check for valid response structure\n        if not self._has_valid_structure(cleaned):\n            return False, \"Response has invalid structure\"\n\n        return True, \"Response is valid\"\n\n    def _is_repetitive(self, content: str) -> bool:\n        \"\"\"Check if content is repetitive or boilerplate.\n\n        Args:\n            content: Response content to check\n\n        Returns:\n            True if content is repetitive\n        \"\"\"\n        # Check for repeated patterns\n        patterns = [\n            r'(\\w+)(\\s+\\1){3,}',  # Same word repeated 4+ times\n            r'(.{5,})(\\1){2,}',    # 5+ char sequence repeated 3+ times\n        ]\n\n        for pattern in patterns:\n            if re.search(pattern, content, re.IGNORECASE):\n                return True\n\n        # Check for excessive punctuation\n        punctuation_ratio = sum(1 for c in content if c in '.,!?;:') / len(content)\n        if punctuation_ratio > 0.3:\n            return True\n\n        return False\n\n    def _has_valid_structure(self, content: str) -> bool:\n        \"\"\"Check if response has a valid structure.\n\n        Args:\n            content: Response content to check\n\n        Returns:\n            True if content has valid structure\n        \"\"\"\n        # At least one sentence with subject and verb structure\n        # Simple check for common sentence patterns\n        has_sentence = re.search(r'[A-Za-z]\\w*.*?[.!?]', content)\n        if has_sentence:\n            return True\n\n        # For non-English responses, check for basic structure\n        if len(re.sub(r'[\\s\\W]', '', content)) >= 10:\n            return True\n\n        return False\n\n    def get_stale_calls(self, timeout_days: int = 7) -> List[HumanCall]:\n        \"\"\"Get calls that have been pending for too long.\n\n        Args:\n            timeout_days: Days after which a call is considered stale\n\n        Returns:\n            List of stale HumanCall objects\n        \"\"\"\n        cutoff = datetime.now(timezone.utc) - timedelta(days=timeout_days)\n        return [\n            c for c in self.get_all_calls()\n            if c.status == CallStatus.PENDING and c.created < cutoff\n        ]\n\n    def export_to_json(self, output_path: Path, include_completed: bool = False) -> None:\n        \"\"\"Export all calls to JSON.\n\n        Args:\n            output_path: Path to write JSON file\n            include_completed: Whether to include completed calls\n        \"\"\"\n        calls = [c.to_dict() for c in self.get_all_calls(include_completed)]\n        output_path.write_text(json.dumps(calls, indent=2, default=str), encoding=\"utf-8\")\n\n    def _get_archive_dir(self) -> Path:\n        \"\"\"Get the archive directory path.\n\n        Returns:\n            Path to the archive directory\n        \"\"\"\n        archive_dir = self.calls_dir / \"archive\"\n        archive_dir.mkdir(parents=True, exist_ok=True)\n        return archive_dir\n\n    def archive_completed_calls(\n        self,\n        days_old: int = 30,\n        dry_run: bool = False,\n        all_completed: bool = False\n    ) -> List[Dict[str, Any]]:\n        \"\"\"Archive completed/expired calls older than N days.\n\n        Args:\n            days_old: Minimum age in days for calls to be archived (default 30)\n            dry_run: If True, only preview what would be archived without moving files\n            all_completed: If True, archive all completed calls regardless of age\n\n        Returns:\n            List of archived call info dicts with keys: id, title, file_path, archive_path\n        \"\"\"\n        archived = []\n        archive_dir = self._get_archive_dir()\n\n        # Calculate cutoff date for age-based archiving\n        if not all_completed:\n            cutoff = datetime.now(timezone.utc) - timedelta(days=days_old)\n        else:\n            cutoff = datetime.now(timezone.utc)  # All completed calls will pass\n\n        # Get all calls including completed\n        all_calls = self.get_all_calls(include_completed=True)\n\n        for call in all_calls:\n            # Archive completed, expired, or responded calls\n            if call.status not in (CallStatus.COMPLETED, CallStatus.EXPIRED, CallStatus.RESPONDED):\n                continue\n\n            # Check age unless all_completed is True\n            if not all_completed:\n                # Use response_timestamp if available, otherwise use created\n                check_time = call.response_timestamp or call.created\n                if check_time and check_time.tzinfo is None:\n                    check_time = check_time.replace(tzinfo=timezone.utc)\n                if check_time and check_time >= cutoff:\n                    continue\n\n            # Determine archive path\n            archive_path = archive_dir / call.file_path.name\n\n            # Handle name collisions\n            counter = 1\n            original_archive_path = archive_path\n            while archive_path.exists() and not dry_run:\n                stem = original_archive_path.stem\n                suffix = original_archive_path.suffix\n                archive_path = archive_dir / f\"{stem}_{counter}{suffix}\"\n                counter += 1\n\n            archived_info = {\n                \"id\": call.id,\n                \"title\": call.title,\n                \"status\": call.status.value,\n                \"file_path\": str(call.file_path),\n                \"archive_path\": str(archive_path),\n                \"created\": call.created.isoformat() if call.created else None,\n                \"response_timestamp\": call.response_timestamp.isoformat() if call.response_timestamp else None,\n            }\n\n            if not dry_run:\n                # Move the file to archive\n                if call.file_path.exists():\n                    call.file_path.rename(archive_path)\n\n                    # Update tracking - remove from active tracking\n                    path_str = str(call.file_path)\n                    if path_str in self._file_hashes:\n                        del self._file_hashes[path_str]\n                    if path_str in self._file_mtimes:\n                        del self._file_mtimes[path_str]\n                    if path_str in self._call_cache:\n                        del self._call_cache[path_str]\n\n                    # Add to archive tracking\n                    self._file_hashes[str(archive_path)] = self._compute_file_hash(archive_path)\n                    self._file_mtimes[str(archive_path)] = archive_path.stat().st_mtime\n\n            archived.append(archived_info)\n\n        return archived\n\n    def get_archive_stats(self) -> Dict[str, Any]:\n        \"\"\"Get statistics about archived calls.\n\n        Returns:\n            Dict with archive statistics including:\n            - total_archived: Total number of archived calls\n            - by_status: Count by status (completed, expired)\n            - by_month: Count by month archived\n            - oldest_archive: Date of oldest archived call\n            - newest_archive: Date of newest archived call\n            - archive_dir: Path to archive directory\n        \"\"\"\n        archive_dir = self._get_archive_dir()\n        archived_calls = []\n\n        # Parse all archived call files\n        for filepath in archive_dir.glob(\"*.md\"):\n            if not filepath.is_file():\n                continue\n            call = self.parse_call_file(filepath)\n            if call:\n                archived_calls.append(call)\n\n        # Calculate statistics\n        stats = {\n            \"total_archived\": len(archived_calls),\n            \"by_status\": {\"completed\": 0, \"expired\": 0, \"other\": 0},\n            \"by_month\": {},\n            \"oldest_archive\": None,\n            \"newest_archive\": None,\n            \"archive_dir\": str(archive_dir),\n        }\n\n        if not archived_calls:\n            return stats\n\n        timestamps = []\n        for call in archived_calls:\n            # Count by status\n            if call.status == CallStatus.COMPLETED:\n                stats[\"by_status\"][\"completed\"] += 1\n            elif call.status == CallStatus.EXPIRED:\n                stats[\"by_status\"][\"expired\"] += 1\n            else:\n                stats[\"by_status\"][\"other\"] += 1\n\n            # Get timestamp for date calculations\n            check_time = call.response_timestamp or call.created\n            if check_time:\n                if check_time.tzinfo is None:\n                    check_time = check_time.replace(tzinfo=timezone.utc)\n                timestamps.append(check_time)\n\n                # Count by month (use response_timestamp or created)\n                month_key = check_time.strftime(\"%Y-%m\")\n                stats[\"by_month\"][month_key] = stats[\"by_month\"].get(month_key, 0) + 1\n\n        if timestamps:\n            stats[\"oldest_archive\"] = min(timestamps).isoformat()\n            stats[\"newest_archive\"] = max(timestamps).isoformat()\n\n        return stats\n\n    def restore_from_archive(self, call_id: str) -> Optional[HumanCall]:\n        \"\"\"Restore a call from archive back to active calls.\n\n        Args:\n            call_id: The ID of the call to restore\n\n        Returns:\n            Restored HumanCall or None if not found\n        \"\"\"\n        archive_dir = self._get_archive_dir()\n\n        # Find the archived file by call_id\n        for filepath in archive_dir.glob(\"*.md\"):\n            if not filepath.is_file():\n                continue\n\n            # Check if this file matches the call_id\n            if filepath.stem.startswith(call_id) or call_id in filepath.stem:\n                # Move back to calls directory\n                restore_path = self.calls_dir / filepath.name\n\n                # Handle name collisions\n                counter = 1\n                original_restore_path = restore_path\n                while restore_path.exists():\n                    stem = original_restore_path.stem\n                    suffix = original_restore_path.suffix\n                    restore_path = self.calls_dir / f\"{stem}_{counter}{suffix}\"\n                    counter += 1\n\n                filepath.rename(restore_path)\n\n                # Parse and cache the restored call\n                call = self.parse_call_file(restore_path)\n                if call:\n                    self._file_hashes[str(restore_path)] = self._compute_file_hash(restore_path)\n                    self._file_mtimes[str(restore_path)] = restore_path.stat().st_mtime\n                    self._call_cache[str(restore_path)] = call\n                    return call\n\n        return None\n\n\n# Backwards compatibility: maintain the old discover_human_calls function\ndef discover_human_calls(path: str = \"human-calls\") -> List[Dict[str, Any]]:\n    \"\"\"Discover all human call files and their status.\n\n    Legacy compatibility function. Uses the new HumanCallStore internally.\n\n    Args:\n        path: Path to human-calls directory\n\n    Returns:\n        List of dicts with file info and parsed frontmatter\n    \"\"\"\n    store = HumanCallStore(Path(path))\n    calls = store.get_all_calls(include_completed=True)\n\n    result = []\n    for call in calls:\n        result.append({\n            'file': call.file_path.name,\n            'path': str(call.file_path),\n            'type': call.call_type.value,\n            'priority': call.priority.value,\n            'status': call.status.value,\n            'created': call.created.strftime('%Y-%m-%d'),\n            'title': call.title,\n        })\n\n    return result\n","numLines":1017,"startLine":1,"totalLines":1017}}}
