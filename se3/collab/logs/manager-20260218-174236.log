{"type":"user","message":{"role":"user","content":[{"tool_use_id":"tool_yEVJcWWTy0L2CWDWOn6m3lWT","type":"tool_result","content":"     1→\"\"\"SE 3.0 CLI - Main entry point for se3 commands.\"\"\"\n     2→\n     3→import json\n     4→from pathlib import Path\n     5→from typing import Optional\n     6→\n     7→import typer\n     8→\n     9→from . import __version__, SE3_FRAMEWORK_VERSION\n    10→\n    11→def get_framework_version() -> str:\n    12→    \"\"\"Get current framework version from single source of truth (direct file read for git worktree compatibility).\"\"\"\n    13→    import os\n    14→    from pathlib import Path\n    15→    import re\n    16→\n    17→    # Get the path to __init__.py in the current working tree\n    18→    init_file = Path(__file__).parent / \"__init__.py\"\n    19→    if not init_file.exists():\n    20→        raise FileNotFoundError(f\"Cannot find se3_tools __init__.py at {init_file}\")\n    21→\n    22→    with open(init_file, \"r\", encoding=\"utf-8\") as f:\n    23→        content = f.read()\n    24→\n    25→    match = re.search(r'SE3_FRAMEWORK_VERSION\\s*=\\s*\"([\\d]+\\.[\\d]+\\.[\\d]+)\"', content)\n    26→    if not match:\n    27→        raise ValueError(\"Cannot find SE3_FRAMEWORK_VERSION definition in __init__.py\")\n    28→\n    29→    return match.group(1)\n    30→from .commands import lint, status, sync, verify, update, collab, commit, openspec, human_calls_cmd\n    31→from .commands.update import get_installed_se3_version\n    32→from .commands.init import initialize_project\n    33→\n    34→app = typer.Typer(\n    35→    name=\"se3\",\n    36→    help=\"SE 3.0 framework CLI tools\",\n    37→    invoke_without_command=True,\n    38→)\n    39→\n    40→def _version_callback(value: bool):\n    41→    \"\"\"Handle --version flag.\"\"\"\n    42→    if value:\n    43→        typer.echo(f\"se3 CLI version: {__version__}\")\n    44→        typer.echo(f\"SE3 Framework version: {get_framework_version()}\")\n    45→        try: