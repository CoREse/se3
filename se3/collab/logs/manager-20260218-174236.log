{"type":"user","message":{"role":"user","content":[{"tool_use_id":"tool_pg8tYdauF1PvG7HReejNh1At","type":"tool_result","content":"     1→\"\"\"Git Worktree Collaboration command for SE 3.0.\n     2→\n     3→Independent Entry Mode Architecture:\n     4→- Orchestrator runs as daemon (pure bash, no AI)\n     5→- Manager and workers are launched as independent Claude sessions\n     6→- Communication via file system (.collab/) and MCP\n     7→\n     8→Usage modes:\n     9→1. --daemon: Start orchestrator daemon (runs in background)\n    10→2. --manual: Generate task files, print commands for manual execution\n    11→3. --launch-manager: Launch manager for a task (internal use)\n    12→4. --launch-worker: Launch worker for a task (internal use)\n    13→\"\"\"\n    14→\n    15→import json\n    16→import os\n    17→import subprocess\n    18→import sys\n    19→import time\n    20→from pathlib import Path\n    21→from datetime import datetime\n    22→from typing import Optional, List\n    23→\n    24→import typer\n    25→\n    26→app = typer.Typer(invoke_without_command=True)\n    27→\n    28→\n    29→\n    30→def find_project_root() -> Path:\n    31→    \"\"\"Find the project root by looking for .claude/ directory.\"\"\"\n    32→    current = Path.cwd()\n    33→    while current != current.parent:\n    34→        if (current / \".claude\").is_dir():\n    35→            return current\n    36→        current = current.parent\n    37→    return Path.cwd()\n    38→\n    39→\n    40→def get_collab_dir(project_root: Path) -> Path:\n    41→    return project_root / \".collab\"\n    42→\n    43→\n    44→def load_config(project_root: Path) -> dict:\n    45→    \"\"\"Load se3.config.yaml if exists.\"\"\"\n    46→    config_file = project_root / \"se3.config.yaml\"\n    47→    if config_file.exists():\n    48→        try:\n    49→            import yaml\n    50→            with open(config_file) as f:\n    51→                return yaml.safe_load(f) or {}\n    52→        except Exception:\n    53→            pass\n    54→    return {}\n    55→\n    56→\n    57→def ensure_collab_structure(project_root: Path):\n    58→    \"\"\"Ensure .collab directory structure exists.\"\"\"\n    59→    collab_dir = get_collab_dir(project_root)\n    60→    for subdir in [\"tasks\", \"logs\", \"events\", \"pending\", \"completed\"]:\n    61→        (collab_dir / subdir).mkdir(parents=True, exist_ok=True)\n    62→\n    63→\n    64→def print_status(project_root: Path):\n    65→    \"\"\"Print current collaboration status.\"\"\"\n    66→    collab_dir = get_collab_dir(project_root)\n    67→\n    68→    config_file = collab_dir / \"config.json\"\n    69→    if not config_file.exists():\n    70→        typer.echo(\"No active collaboration session.\")\n    71→        raise typer.Exit(0)\n    72→\n    73→    config = json.loads(config_file.read_text())\n    74→\n    75→    # Get human calls counts\n    76→    from .human_calls_cmd import get_pending_calls_count, get_responded_calls_count\n    77→    pending_calls = get_pending_calls_count(project_root)\n    78→    responded_calls = get_responded_calls_count(project_root)\n    79→\n    80→    typer.echo(f\"\\n{'=' * 60}\")\n    81→    typer.echo(\"SE3 Collaboration Status\")\n    82→    typer.echo(f\"{'=' * 60}\")\n    83→    typer.echo(f\"  Session:    {config.get('session_id', 'unknown')}\")\n    84→    typer.echo(f\"  Objective:  {config.get('objective', 'unknown')}\")\n    85→    typer.echo(f\"  Base:       {config.get('base_branch', 'unknown')}\")\n    86→    typer.echo(f\"  Status:     {config.get('status', 'unknown')}\")\n    87→    typer.echo(f\"  Created:    {config.get('created_at', 'unknown')}\")\n    88→    typer.echo(f\"  Workers:    max {config.get('max_parallel_workers', 3)}\")\n    89→\n    90→    # Show human calls summary\n    91→    if pending_calls > 0 or responded_calls > 0:\n    92→        typer.echo(f\"\\n  Human Calls:\")\n    93→        if pending_calls > 0:\n    94→            typer.echo(f\"    ○ Pending:   {pending_calls}\")\n    95→        if responded_calls > 0:\n    96→            typer.echo(f\"    ◉ Responded: {responded_calls} (waiting to be processed)\")\n    97→\n    98→    # List tasks\n    99→    tasks_dir = collab_dir / \"tasks\"\n   100→    if tasks_dir.exists():\n   101→        task_files = sorted(tasks_dir.glob(\"task-*.json\"))\n   102→        if task_files:\n   103→            typer.echo(f\"\\n  Tasks:\")\n   104→            for tf in task_files:\n   105→                task = json.loads(tf.read_text())\n   106→                status_icon = {\n   107→                    \"pending\": \"○\",\n   108→                    \"in_progress\": \"◉\",\n   109→                    \"done\": \"●\",\n   110→                    \"failed\": \"✗\",\n   111→                    \"timeout\": \"⏱\",\n   112→                    \"blocked\": \"◫\",\n   113→                    \"escalated\": \"⚠\",\n   114→                }.get(task.get(\"status\", \"\"), \"?\")\n   115→                attempts = task.get(\"health\", {}).get(\"attempts\", 0)\n   116→                max_att = task.get(\"health\", {}).get(\"max_attempts\", 3)\n   117→                typer.echo(\n   118→                    f\"    {status_icon} {task['id']}: [{task['status']}] \"\n   119→                    f\"{task.get('title', '')} \"\n   120→                    f\"(attempts: {attempts}/{max_att})\"\n   121→                )\n   122→\n   123→    # Check orchestrator\n   124→    pid_file = collab_dir / \"orchestrator.pid\"\n   125→    if pid_file.exists():\n   126→        pid = pid_file.read_text().strip()\n   127→        try:\n   128→            subprocess.run(\n   129→                [\"kill\", \"-0\", pid],\n   130→                capture_output=True,\n   131→                check=True,\n   132→            )\n   133→            typer.echo(f\"\\n  Orchestrator: running (PID {pid})\")\n   134→        except subprocess.CalledProcessError:\n   135→            typer.echo(f\"\\n  Orchestrator: dead (stale PID {pid})\")\n   136→    else:\n   137→        typer.echo(f\"\\n  Orchestrator: not running\")\n   138→\n   139→    typer.echo(f\"{'=' * 60}\\n\")\n   140→\n   141→\n   142→def abort_session(project_root: Path):\n   143→    \"\"\"Abort the current collaboration session.\"\"\"\n   144→    collab_dir = get_collab_dir(project_root)\n   145→\n   146→    if not collab_dir.exists():\n   147→        typer.echo(\"No active collaboration session.\")\n   148→        raise typer.Exit(0)\n   149→\n   150→    # Kill orchestrator\n   151→    pid_file = collab_dir / \"orchestrator.pid\"\n   152→    if pid_file.exists():\n   153→        pid = pid_file.read_text().strip()\n   154→        subprocess.run([\"kill\", \"-TERM\", pid], capture_output=True)\n   155→        typer.echo(f\"Killed orchestrator (PID {pid})\")\n   156→\n   157→    # Kill workers\n   158→    tasks_dir = collab_dir / \"tasks\"\n   159→    if tasks_dir.exists():\n   160→        for tf in tasks_dir.glob(\"task-*.json\"):\n   161→            task = json.loads(tf.read_text())\n   162→            wpid = task.get(\"worker_pid\")\n   163→            if wpid and str(wpid) != \"null\" and str(wpid) != \"0\":\n   164→                subprocess.run(\n   165→                    [\"kill\", \"-TERM\", str(wpid)], capture_output=True\n   166→                )\n   167→                typer.echo(f\"Killed worker {task['id']} (PID {wpid})\")\n   168→\n   169→    # Cleanup worktrees\n   170→    worktree_dir = project_root / \".worktrees\"\n   171→    if worktree_dir.exists():\n   172→        for wt in worktree_dir.iterdir():\n   173→            if wt.is_dir():\n   174→                subprocess.run(\n   175→                    [\"git\", \"worktree\", \"remove\", str(wt), \"--force\"],\n   176→                    cwd=project_root,\n   177→                    capture_output=True,\n   178→                )\n   179→                typer.echo(f\"Removed worktree: {wt.name}\")\n   180→\n   181→    # Update config\n   182→    config_file = collab_dir / \"config.json\"\n   183→    if config_file.exists():\n   184→        config = json.loads(config_file.read_text())\n   185→        config[\"status\"] = \"aborted\"\n   186→        config_file.write_text(json.dumps(config, indent=2))\n   187→\n   188→    pid_file.unlink(missing_ok=True)\n   189→    typer.echo(\"Collaboration session aborted.\")\n   190→\n   191→\n   192→def generate_manager_prompt(project_root: Path, event_type: str, context: str) -> str:\n   193→    \"\"\"Generate prompt for manager agent.\"\"\"\n   194→    collab_dir = get_collab_dir(project_root)\n   195→\n   196→    # Load manager rules\n   197→    rules_file = project_root / \"scripts\" / \"rules-manager.md\"\n   198→    if rules_file.exists():\n   199→        rules = rules_file.read_text()\n   200→    else:\n   201→        rules = \"You are a manager agent. Respond with valid JSON.\"\n   202→\n   203→    # Load current tasks summary\n   204→    tasks_summary = []\n   205→    tasks_dir = collab_dir / \"tasks\"\n   206→    if tasks_dir.exists():\n   207→        for tf in sorted(tasks_dir.glob(\"task-*.json\")):\n   208→            task = json.loads(tf.read_text())\n   209→            tasks_summary.append(\n   210→                f\"- {task['id']}: [{task['status']}] {task.get('title', '')}\"\n   211→            )\n   212→\n   213→    config_file = collab_dir / \"config.json\"\n   214→    base_branch = \"master\"\n   215→    if config_file.exists():\n   216→        config = json.loads(config_file.read_text())\n   217→        base_branch = config.get(\"base_branch\", \"master\")\n   218→\n   219→    return f\"\"\"{rules}\n   220→\n   221→---\n   222→\n   223→## Current State\n   224→Project root: {project_root}\n   225→Base branch: {base_branch}\n   226→\n   227→## All Tasks\n   228→{chr(10).join(tasks_summary) if tasks_summary else \"(no tasks yet)\"}\n   229→\n   230→## Event\n   231→Type: {event_type}\n   232→Context:\n   233→{context}\n   234→\n   235→## Instructions\n   236→Analyze the event and decide the next action. Respond ONLY with valid JSON matching this schema:\n   237→{{\n   238→  \"action\": \"plan|merge|reject|retry|split|escalate|complete\",\n   239→  \"tasks\": [...],\n   240→  \"target_task\": \"task-id\",\n   241→  \"merge_branch\": \"branch-name\",\n   242→  \"retry_prompt\": \"adjusted prompt for retry\",\n   243→  \"reason\": \"explanation\",\n   244→  \"summary\": \"human-readable summary of decision\"\n   245→}}\n   246→\n   247→Rules:\n   248→- For 'plan': include full task definitions in 'tasks' array\n   249→- For 'merge': set target_task and merge_branch\n   250→- For 'reject': set target_task and reason (becomes feedback for worker retry)\n   251→- For 'retry': set target_task and retry_prompt\n   252→- For 'split': set target_task and new sub-tasks in 'tasks'\n   253→- For 'escalate': set reason (will be sent to human)\n   254→- For 'complete': when all tasks are merged and done\n   255→- If unsure, use 'escalate' rather than guessing\n   256→\"\"\"\n   257→\n   258→\n   259→def generate_worker_prompt(project_root: Path, task_id: str) -> str:\n   260→    \"\"\"Generate prompt for worker agent.\"\"\"\n   261→    collab_dir = get_collab_dir(project_root)\n   262→    task_file = collab_dir / \"tasks\" / f\"{task_id}.json\"\n   263→\n   264→    # Load worker rules\n   265→    rules_file = project_root / \"scripts\" / \"rules-worker.md\"\n   266→    if rules_file.exists():\n   267→        rules = rules_file.read_text()\n   268→    else:\n   269→        rules = \"You are a worker agent. Implement the task, run tests, commit.\"\n   270→\n   271→    task = json.loads(task_file.read_text())\n   272→    task_prompt = task.get(\"prompt\", \"\")\n   273→\n   274→    return f\"\"\"{rules}\n   275→\n   276→---\n   277→\n   278→## Your Task (ID: {task_id})\n   279→\n   280→{task_prompt}\n   281→\n   282→## Important\n   283→- Work in the provided worktree directory\n   284→- Commit your changes when done\n   285→- Exit with code 0 on success, non-zero on failure\n   286→\"\"\"\n   287→\n   288→\n   289→def launch_manager(project_root: Path, event_type: str, context: str) -> subprocess.Popen:\n   290→    \"\"\"Launch manager as independent Claude process.\n   291→\n   292→    Uses ClaudeRunner for priority-based command selection.\n   293→    \"\"\"\n   294→    from ..claude_runner import ClaudeRunner\n   295→\n   296→    prompt = generate_manager_prompt(project_root, event_type, context)\n   297→\n   298→    # Write prompt to file for reference and use @file syntax to avoid CLI parsing issues\n   299→    collab_dir = get_collab_dir(project_root)\n   300→    prompt_file = collab_dir / \"logs\" / f\"manager-{event_type}-{datetime.now().strftime('%Y%m%d-%H%M%S')}.prompt\"\n   301→    prompt_file.write_text(prompt)\n   302→\n   303→    args = [\"--dangerously-skip-permissions\", \"--print\", \"--output-format\", \"text\", \"--max-turns\", \"0\", f\"@{prompt_file}\"]\n   304→    env = {**dict(os.environ), \"SE3_AGENT_ROLE\": \"manager\", \"SE3_PROJECT_ROOT\": str(project_root)}\n   305→    env.pop(\"CLAUDECODE\", None)  # Avoid nested session detection\n   306→\n   307→    runner = ClaudeRunner(project_root)\n   308→    proc, _ = runner.popen(\n   309→        args=args,\n   310→        cwd=project_root,\n   311→        env=env,\n   312→        stdout=subprocess.PIPE,\n   313→        stderr=subprocess.STDOUT,\n   314→        bufsize=1,\n   315→        universal_newlines=True,\n   316→    )\n   317→    return proc\n   318→\n   319→\n   320→def launch_worker(project_root: Path, task_id: str) -> subprocess.Popen:\n   321→    \"\"\"Launch worker as independent Claude process in worktree.\n   322→\n   323→    Uses ClaudeRunner for priority-based command selection with activity monitoring.\n   324→\n   325→    Returns a Popen-like object with wait() and returncode for compatibility.\n   326→    \"\"\"\n   327→    from ..claude_runner import ClaudeRunner, MonitoredResult\n   328→\n   329→    collab_dir = get_collab_dir(project_root)\n   330→    task_file = collab_dir / \"tasks\" / f\"{task_id}.json\"\n   331→    task = json.loads(task_file.read_text())\n   332→\n   333→    worktree = task.get(\"worktree\", f\".worktrees/{task_id}\")\n   334→    if not worktree.startswith(\"/\"):\n   335→        worktree = str(project_root / worktree)\n   336→\n   337→    # Ensure worktree exists\n   338→    if not Path(worktree).exists():\n   339→        branch = task.get(\"branch\", f\"collab/{task_id}\")\n   340→        base_branch = task.get(\"base_branch\", \"master\")\n   341→        subprocess.run(\n   342→            [\"git\", \"worktree\", \"add\", worktree, \"-b\", branch, base_branch],\n   343→            cwd=project_root,\n   344→            capture_output=True\n   345→        )\n   346→\n   347→    prompt = generate_worker_prompt(project_root, task_id)\n   348→\n   349→    # Write prompt to file and use @file syntax to avoid CLI parsing issues\n   350→    collab_dir = get_collab_dir(project_root)\n   351→    prompt_file = collab_dir / \"logs\" / f\"worker-{task_id}-{datetime.now().strftime('%Y%m%d-%H%M%S')}.prompt\"\n   352→    prompt_file.write_text(prompt)\n   353→\n   354→    args = [\"--dangerously-skip-permissions\", \"--print\", \"--max-turns\", \"0\", f\"@{prompt_file}\"]\n   355→    env = {\n   356→        **dict(os.environ),\n   357→        \"SE3_TASK_ID\": task_id,\n   358→        \"SE3_AGENT_ROLE\": \"worker\",\n   359→        \"SE3_PROJECT_ROOT\": str(project_root)\n   360→    }\n   361→    env.pop(\"CLAUDECODE\", None)  # Avoid nested session detection\n   362→\n   363→    log_file = collab_dir / \"logs\" / f\"worker-{task_id}-{datetime.now().strftime('%Y%m%d-%H%M%S')}.log\"\n   364→    timeout_min = task.get(\"health\", {}).get(\"timeout_minutes\", 60)\n   365→\n   366→    # Initialize last_activity if not present\n   367→    if \"last_activity\" not in task.get(\"health\", {}):\n   368→        task[\"health\"][\"last_activity\"] = datetime.now().isoformat()\n   369→        task_file.write_text(json.dumps(task, indent=2))\n   370→\n   371→    # Activity callback: update task's last_activity timestamp whenever output is received\n   372→    def on_activity():\n   373→        try:\n   374→            with open(task_file, \"r\", encoding=\"utf-8\") as f:\n   375→                current_task = json.load(f)\n   376→            current_task[\"health\"][\"last_activity\"] = datetime.now().isoformat()\n   377→            with open(task_file, \"w\", encoding=\"utf-8\") as f:\n   378→                json.dump(current_task, f, indent=2)\n   379→        except Exception as e:\n   380→            print(f\"[collab] Failed to update last_activity: {e}\", file=sys.stderr)\n   381→\n   382→    runner = ClaudeRunner(project_root)\n   383→\n   384→    # Use run_with_monitor for activity-based monitoring and command fallback\n   385→    result = runner.run_with_monitor(\n   386→        args=args,\n   387→        log_file=log_file,\n   388→        wall_timeout=timeout_min * 60,\n   389→        inactivity_timeout=300,  # 5 minutes without output = stuck\n   390→        cwd=Path(worktree),\n   391→        env=env,\n   392→        on_activity=on_activity,\n   393→    )\n   394→\n   395→    # Create a simple wrapper object for compatibility\n   396→    class WorkerResult:\n   397→        def __init__(self, returncode: int):\n   398→            self.returncode = returncode\n   399→\n   400→        def wait(self) -> int:\n   401→            return self.returncode\n   402→\n   403→        def communicate(self, timeout=None) -> tuple:\n   404→            return (b\"\", b\"\")\n   405→\n   406→        def poll(self) -> int:\n   407→            return self.returncode\n   408→\n   409→    return WorkerResult(result.returncode)\n   410→\n   411→\n   412→def start_daemon(project_root: Path, objective: str, resume: bool = False):\n   413→    \"\"\"Start orchestrator daemon mode.\"\"\"\n   414→    ensure_collab_structure(project_root)\n   415→    collab_dir = get_collab_dir(project_root)\n   416→\n   417→    if not resume:\n   418→        # Clean up old tasks from previous sessions\n   419→        tasks_dir = collab_dir / \"tasks\"\n   420→        if tasks_dir.exists():\n   421→            for f in tasks_dir.glob(\"task-*.json\"):\n   422→                f.unlink()\n   423→            for f in tasks_dir.glob(\".exitcode-*\"):\n   424→                f.unlink()\n   425→\n   426→        # Create session config\n   427→        result = subprocess.run(\n   428→            [\"git\", \"branch\", \"--show-current\"],\n   429→            cwd=project_root,\n   430→            capture_output=True,\n   431→            text=True\n   432→        )\n   433→        base_branch = result.stdout.strip() or \"master\"\n   434→\n   435→        config = {\n   436→            \"session_id\": f\"collab-{datetime.now().strftime('%Y%m%d-%H%M%S')}\",\n   437→            \"objective\": objective,\n   438→            \"base_branch\": base_branch,\n   439→            \"created_at\": datetime.now().isoformat(),\n   440→            \"max_parallel_workers\": 3,\n   441→            \"status\": \"active\"\n   442→        }\n   443→        (collab_dir / \"config.json\").write_text(json.dumps(config, indent=2))\n   444→\n   445→        typer.echo(f\"Created collaboration session: {config['session_id']}\")\n   446→        typer.echo(f\"Objective: {objective}\")\n   447→\n   448→    # Start the orchestrator daemon\n   449→    script = project_root / \"scripts\" / \"collab-orchestrator.sh\"\n   450→    if not script.exists():\n   451→        typer.echo(f\"Error: orchestrator script not found at {script}\")\n   452→        raise typer.Exit(1)\n   453→\n   454→    cmd = [\"bash\", str(script), \"--daemon\"]\n   455→    if resume:\n   456→        cmd.append(\"--resume\")\n   457→    elif objective:\n   458→        cmd.append(objective)\n   459→\n   460→    # Start in background - MUST clear CLAUDECODE to avoid nested session detection\n   461→    env = {**dict(os.environ), \"PROJECT_ROOT\": str(project_root)}\n   462→    env.pop(\"CLAUDECODE\", None)  # Clear to allow manager/worker to run Claude\n   463→\n   464→    subprocess.Popen(\n   465→        cmd,\n   466→        stdout=open(collab_dir / \"logs\" / \"orchestrator.log\", \"w\"),\n   467→        stderr=subprocess.STDOUT,\n   468→        env=env,\n   469→        cwd=project_root,\n   470→        start_new_session=True  # Detach from terminal\n   471→    )\n   472→\n   473→    typer.echo(f\"Orchestrator daemon started.\")\n   474→    typer.echo(f\"Use 'se3 collab --status' to check progress\")\n   475→    typer.echo(f\"Use 'se3 collab --abort' to stop\")\n   476→\n   477→\n   478→def run_manual_mode(project_root: Path, objective: str):\n   479→    \"\"\"Manual mode: generate initial plan, print commands for user to execute.\"\"\"\n   480→    ensure_collab_structure(project_root)\n   481→    collab_dir = get_collab_dir(project_root)\n   482→\n   483→    # Get base branch\n   484→    result = subprocess.run(\n   485→        [\"git\", \"branch\", \"--show-current\"],\n   486→        cwd=project_root,\n   487→        capture_output=True,\n   488→        text=True\n   489→    )\n   490→    base_branch = result.stdout.strip() or \"master\"\n   491→\n   492→    # Create session config\n   493→    config = {\n   494→        \"session_id\": f\"collab-{datetime.now().strftime('%Y%m%d-%H%M%S')}\",\n   495→        \"objective\": objective,\n   496→        \"base_branch\": base_branch,\n   497→        \"created_at\": datetime.now().isoformat(),\n   498→        \"max_parallel_workers\": 3,\n   499→        \"status\": \"manual\"\n   500→    }\n   501→    (collab_dir / \"config.json\").write_text(json.dumps(config, indent=2))\n   502→\n   503→    typer.echo(f\"\\n{'=' * 60}\")\n   504→    typer.echo(\"SE3 Collaboration - Manual Mode\")\n   505→    typer.echo(f\"{'=' * 60}\")\n   506→    typer.echo(f\"\\nObjective: {objective}\")\n   507→    typer.echo(f\"Base branch: {base_branch}\")\n   508→    typer.echo(f\"\\nStep 1: Launch Manager to create plan\")\n   509→    typer.echo(f\"  se3 collab --launch-manager plan\")\n   510→    typer.echo(f\"\\nStep 2: After manager creates tasks, launch workers:\")\n   511→    typer.echo(f\"  se3 collab --launch-worker task-001\")\n   512→    typer.echo(f\"\\nStep 3: When worker completes, review with manager:\")\n   513→    typer.echo(f\"  se3 collab --launch-manager review\")\n   514→    typer.echo(f\"\\nOr use daemon mode for automatic execution:\")\n   515→    typer.echo(f\"  se3 collab --daemon \\\"{objective}\\\"\")\n   516→    typer.echo(f\"{'=' * 60}\\n\")\n   517→\n   518→\n   519→@app.callback()\n   520→def collab(\n   521→    objective: str = typer.Argument(None, help=\"Collaboration objective\"),\n   522→    resume: bool = typer.Option(False, \"--resume\", help=\"Resume a previous session\"),\n   523→    status: bool = typer.Option(False, \"--status\", help=\"Show collaboration status\"),\n   524→    abort: bool = typer.Option(False, \"--abort\", help=\"Abort and cleanup\"),\n   525→    daemon: bool = typer.Option(False, \"--daemon\", help=\"Start orchestrator daemon (auto mode)\"),\n   526→    manual: bool = typer.Option(False, \"--manual\", help=\"Manual mode: generate plan, print commands\"),\n   527→    launch_manager_flag: bool = typer.Option(False, \"--launch-manager\", help=\"Launch manager for event type (internal)\"),\n   528→    launch_worker_flag: bool = typer.Option(False, \"--launch-worker\", help=\"Launch worker for task (internal)\"),\n   529→    event_type: str = typer.Option(\"plan\", \"--event\", help=\"Event type for manager\"),\n   530→    task_id: str = typer.Option(None, \"--task\", help=\"Task ID for worker\"),\n   531→    mock: bool = typer.Option(False, \"--mock\", help=\"Use mock for testing\"),\n   532→    project_root: str = typer.Option(None, \"--project-root\", \"-p\", help=\"Project root directory\"),\n   533→):\n   534→    \"\"\"Manage git-worktree based multi-agent collaboration.\n   535→\n   536→    Independent Entry Mode:\n   537→    - Use --daemon for automatic execution (orchestrator manages everything)\n   538→    - Use --manual to generate plan and execute manually\n   539→    \"\"\"\n   540→    root = Path(project_root) if project_root else find_project_root()\n   541→\n   542→    if status:\n   543→        print_status(root)\n   544→        raise typer.Exit(0)\n   545→\n   546→    if abort:\n   547→        abort_session(root)\n   548→        raise typer.Exit(0)\n   549→\n   550→    if launch_manager_flag:\n   551→        # Internal: launch manager process\n   552→        context = objective if objective else \"\"\n   553→        proc = launch_manager(root, event_type, context)\n   554→        stdout, _ = proc.communicate(timeout=900)  # 15 min timeout\n   555→        if proc.returncode == 0 and stdout:\n   556→            print(stdout.decode() if isinstance(stdout, bytes) else stdout)\n   557→        raise typer.Exit(proc.returncode)\n   558→\n   559→    if launch_worker_flag:\n   560→        # Internal: launch worker process with activity monitoring\n   561→        if not task_id:\n   562→            typer.echo(\"Error: --task required for --launch-worker\")\n   563→            raise typer.Exit(1)\n   564→        result = launch_worker(root, task_id)\n   565→        raise typer.Exit(result.returncode)\n   566→\n   567→    if daemon:\n   568→        if not resume and not objective:\n   569→            typer.echo(\"Error: provide an objective or use --resume\")\n   570→            raise typer.Exit(1)\n   571→        start_daemon(root, objective or \"\", resume)\n   572→        raise typer.Exit(0)\n   573→\n   574→    if manual:\n   575→        if not objective:\n   576→            typer.echo(\"Error: provide an objective\")\n   577→            raise typer.Exit(1)\n   578→        run_manual_mode(root, objective)\n   579→        raise typer.Exit(0)\n   580→\n   581→    # Default: run orchestrator directly (legacy mode, for testing)\n   582→    if not resume and not objective:\n   583→        typer.echo(\"Error: provide an objective, use --daemon, --manual, or --resume\")\n   584→        raise typer.Exit(1)\n   585→\n   586→    script = root / \"scripts\" / \"collab-orchestrator.sh\"\n   587→    if not script.exists():\n   588→        typer.echo(f\"Error: orchestrator script not found at {script}\")\n   589→        raise typer.Exit(1)\n   590→\n   591→    cmd = [\"bash\", str(script)]\n   592→    if resume:\n   593→        cmd.append(\"--resume\")\n   594→    if mock:\n   595→        cmd.append(\"--mock\")\n   596→    if objective:\n   597→        cmd.append(objective)\n   598→\n   599→    env = {**dict(os.environ), \"PROJECT_ROOT\": str(root)}\n   600→\n   601→    try:\n   602→        result = subprocess.run(cmd, env=env, cwd=root)\n   603→        raise typer.Exit(result.returncode)\n   604→    except KeyboardInterrupt:\n   605→        typer.echo(\"\\nInterrupted. Use 'se3 collab --abort' to cleanup.\")\n   606→        raise typer.Exit(130)\n   607→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"8924aa60-cb07-4b2b-b7ff-204f57b06f02","uuid":"039bdc6e-6943-4931-a83d-dfeedd097677","tool_use_result":{"type":"text","file":{"filePath":"/data/cre/workspace/se3.0/tools/se3_tools/commands/collab.py","content":"\"\"\"Git Worktree Collaboration command for SE 3.0.\n\nIndependent Entry Mode Architecture:\n- Orchestrator runs as daemon (pure bash, no AI)\n- Manager and workers are launched as independent Claude sessions\n- Communication via file system (.collab/) and MCP\n\nUsage modes:\n1. --daemon: Start orchestrator daemon (runs in background)\n2. --manual: Generate task files, print commands for manual execution\n3. --launch-manager: Launch manager for a task (internal use)\n4. --launch-worker: Launch worker for a task (internal use)\n\"\"\"\n\nimport json\nimport os\nimport subprocess\nimport sys\nimport time\nfrom pathlib import Path\nfrom datetime import datetime\nfrom typing import Optional, List\n\nimport typer\n\napp = typer.Typer(invoke_without_command=True)\n\n\n\ndef find_project_root() -> Path:\n    \"\"\"Find the project root by looking for .claude/ directory.\"\"\"\n    current = Path.cwd()\n    while current != current.parent:\n        if (current / \".claude\").is_dir():\n            return current\n        current = current.parent\n    return Path.cwd()\n\n\ndef get_collab_dir(project_root: Path) -> Path:\n    return project_root / \".collab\"\n\n\ndef load_config(project_root: Path) -> dict:\n    \"\"\"Load se3.config.yaml if exists.\"\"\"\n    config_file = project_root / \"se3.config.yaml\"\n    if config_file.exists():\n        try:\n            import yaml\n            with open(config_file) as f:\n                return yaml.safe_load(f) or {}\n        except Exception:\n            pass\n    return {}\n\n\ndef ensure_collab_structure(project_root: Path):\n    \"\"\"Ensure .collab directory structure exists.\"\"\"\n    collab_dir = get_collab_dir(project_root)\n    for subdir in [\"tasks\", \"logs\", \"events\", \"pending\", \"completed\"]:\n        (collab_dir / subdir).mkdir(parents=True, exist_ok=True)\n\n\ndef print_status(project_root: Path):\n    \"\"\"Print current collaboration status.\"\"\"\n    collab_dir = get_collab_dir(project_root)\n\n    config_file = collab_dir / \"config.json\"\n    if not config_file.exists():\n        typer.echo(\"No active collaboration session.\")\n        raise typer.Exit(0)\n\n    config = json.loads(config_file.read_text())\n\n    # Get human calls counts\n    from .human_calls_cmd import get_pending_calls_count, get_responded_calls_count\n    pending_calls = get_pending_calls_count(project_root)\n    responded_calls = get_responded_calls_count(project_root)\n\n    typer.echo(f\"\\n{'=' * 60}\")\n    typer.echo(\"SE3 Collaboration Status\")\n    typer.echo(f\"{'=' * 60}\")\n    typer.echo(f\"  Session:    {config.get('session_id', 'unknown')}\")\n    typer.echo(f\"  Objective:  {config.get('objective', 'unknown')}\")\n    typer.echo(f\"  Base:       {config.get('base_branch', 'unknown')}\")\n    typer.echo(f\"  Status:     {config.get('status', 'unknown')}\")\n    typer.echo(f\"  Created:    {config.get('created_at', 'unknown')}\")\n    typer.echo(f\"  Workers:    max {config.get('max_parallel_workers', 3)}\")\n\n    # Show human calls summary\n    if pending_calls > 0 or responded_calls > 0:\n        typer.echo(f\"\\n  Human Calls:\")\n        if pending_calls > 0:\n            typer.echo(f\"    ○ Pending:   {pending_calls}\")\n        if responded_calls > 0:\n            typer.echo(f\"    ◉ Responded: {responded_calls} (waiting to be processed)\")\n\n    # List tasks\n    tasks_dir = collab_dir / \"tasks\"\n    if tasks_dir.exists():\n        task_files = sorted(tasks_dir.glob(\"task-*.json\"))\n        if task_files:\n            typer.echo(f\"\\n  Tasks:\")\n            for tf in task_files:\n                task = json.loads(tf.read_text())\n                status_icon = {\n                    \"pending\": \"○\",\n                    \"in_progress\": \"◉\",\n                    \"done\": \"●\",\n                    \"failed\": \"✗\",\n                    \"timeout\": \"⏱\",\n                    \"blocked\": \"◫\",\n                    \"escalated\": \"⚠\",\n                }.get(task.get(\"status\", \"\"), \"?\")\n                attempts = task.get(\"health\", {}).get(\"attempts\", 0)\n                max_att = task.get(\"health\", {}).get(\"max_attempts\", 3)\n                typer.echo(\n                    f\"    {status_icon} {task['id']}: [{task['status']}] \"\n                    f\"{task.get('title', '')} \"\n                    f\"(attempts: {attempts}/{max_att})\"\n                )\n\n    # Check orchestrator\n    pid_file = collab_dir / \"orchestrator.pid\"\n    if pid_file.exists():\n        pid = pid_file.read_text().strip()\n        try:\n            subprocess.run(\n                [\"kill\", \"-0\", pid],\n                capture_output=True,\n                check=True,\n            )\n            typer.echo(f\"\\n  Orchestrator: running (PID {pid})\")\n        except subprocess.CalledProcessError:\n            typer.echo(f\"\\n  Orchestrator: dead (stale PID {pid})\")\n    else:\n        typer.echo(f\"\\n  Orchestrator: not running\")\n\n    typer.echo(f\"{'=' * 60}\\n\")\n\n\ndef abort_session(project_root: Path):\n    \"\"\"Abort the current collaboration session.\"\"\"\n    collab_dir = get_collab_dir(project_root)\n\n    if not collab_dir.exists():\n        typer.echo(\"No active collaboration session.\")\n        raise typer.Exit(0)\n\n    # Kill orchestrator\n    pid_file = collab_dir / \"orchestrator.pid\"\n    if pid_file.exists():\n        pid = pid_file.read_text().strip()\n        subprocess.run([\"kill\", \"-TERM\", pid], capture_output=True)\n        typer.echo(f\"Killed orchestrator (PID {pid})\")\n\n    # Kill workers\n    tasks_dir = collab_dir / \"tasks\"\n    if tasks_dir.exists():\n        for tf in tasks_dir.glob(\"task-*.json\"):\n            task = json.loads(tf.read_text())\n            wpid = task.get(\"worker_pid\")\n            if wpid and str(wpid) != \"null\" and str(wpid) != \"0\":\n                subprocess.run(\n                    [\"kill\", \"-TERM\", str(wpid)], capture_output=True\n                )\n                typer.echo(f\"Killed worker {task['id']} (PID {wpid})\")\n\n    # Cleanup worktrees\n    worktree_dir = project_root / \".worktrees\"\n    if worktree_dir.exists():\n        for wt in worktree_dir.iterdir():\n            if wt.is_dir():\n                subprocess.run(\n                    [\"git\", \"worktree\", \"remove\", str(wt), \"--force\"],\n                    cwd=project_root,\n                    capture_output=True,\n                )\n                typer.echo(f\"Removed worktree: {wt.name}\")\n\n    # Update config\n    config_file = collab_dir / \"config.json\"\n    if config_file.exists():\n        config = json.loads(config_file.read_text())\n        config[\"status\"] = \"aborted\"\n        config_file.write_text(json.dumps(config, indent=2))\n\n    pid_file.unlink(missing_ok=True)\n    typer.echo(\"Collaboration session aborted.\")\n\n\ndef generate_manager_prompt(project_root: Path, event_type: str, context: str) -> str:\n    \"\"\"Generate prompt for manager agent.\"\"\"\n    collab_dir = get_collab_dir(project_root)\n\n    # Load manager rules\n    rules_file = project_root / \"scripts\" / \"rules-manager.md\"\n    if rules_file.exists():\n        rules = rules_file.read_text()\n    else:\n        rules = \"You are a manager agent. Respond with valid JSON.\"\n\n    # Load current tasks summary\n    tasks_summary = []\n    tasks_dir = collab_dir / \"tasks\"\n    if tasks_dir.exists():\n        for tf in sorted(tasks_dir.glob(\"task-*.json\")):\n            task = json.loads(tf.read_text())\n            tasks_summary.append(\n                f\"- {task['id']}: [{task['status']}] {task.get('title', '')}\"\n            )\n\n    config_file = collab_dir / \"config.json\"\n    base_branch = \"master\"\n    if config_file.exists():\n        config = json.loads(config_file.read_text())\n        base_branch = config.get(\"base_branch\", \"master\")\n\n    return f\"\"\"{rules}\n\n---\n\n## Current State\nProject root: {project_root}\nBase branch: {base_branch}\n\n## All Tasks\n{chr(10).join(tasks_summary) if tasks_summary else \"(no tasks yet)\"}\n\n## Event\nType: {event_type}\nContext:\n{context}\n\n## Instructions\nAnalyze the event and decide the next action. Respond ONLY with valid JSON matching this schema:\n{{\n  \"action\": \"plan|merge|reject|retry|split|escalate|complete\",\n  \"tasks\": [...],\n  \"target_task\": \"task-id\",\n  \"merge_branch\": \"branch-name\",\n  \"retry_prompt\": \"adjusted prompt for retry\",\n  \"reason\": \"explanation\",\n  \"summary\": \"human-readable summary of decision\"\n}}\n\nRules:\n- For 'plan': include full task definitions in 'tasks' array\n- For 'merge': set target_task and merge_branch\n- For 'reject': set target_task and reason (becomes feedback for worker retry)\n- For 'retry': set target_task and retry_prompt\n- For 'split': set target_task and new sub-tasks in 'tasks'\n- For 'escalate': set reason (will be sent to human)\n- For 'complete': when all tasks are merged and done\n- If unsure, use 'escalate' rather than guessing\n\"\"\"\n\n\ndef generate_worker_prompt(project_root: Path, task_id: str) -> str:\n    \"\"\"Generate prompt for worker agent.\"\"\"\n    collab_dir = get_collab_dir(project_root)\n    task_file = collab_dir / \"tasks\" / f\"{task_id}.json\"\n\n    # Load worker rules\n    rules_file = project_root / \"scripts\" / \"rules-worker.md\"\n    if rules_file.exists():\n        rules = rules_file.read_text()\n    else:\n        rules = \"You are a worker agent. Implement the task, run tests, commit.\"\n\n    task = json.loads(task_file.read_text())\n    task_prompt = task.get(\"prompt\", \"\")\n\n    return f\"\"\"{rules}\n\n---\n\n## Your Task (ID: {task_id})\n\n{task_prompt}\n\n## Important\n- Work in the provided worktree directory\n- Commit your changes when done\n- Exit with code 0 on success, non-zero on failure\n\"\"\"\n\n\ndef launch_manager(project_root: Path, event_type: str, context: str) -> subprocess.Popen:\n    \"\"\"Launch manager as independent Claude process.\n\n    Uses ClaudeRunner for priority-based command selection.\n    \"\"\"\n    from ..claude_runner import ClaudeRunner\n\n    prompt = generate_manager_prompt(project_root, event_type, context)\n\n    # Write prompt to file for reference and use @file syntax to avoid CLI parsing issues\n    collab_dir = get_collab_dir(project_root)\n    prompt_file = collab_dir / \"logs\" / f\"manager-{event_type}-{datetime.now().strftime('%Y%m%d-%H%M%S')}.prompt\"\n    prompt_file.write_text(prompt)\n\n    args = [\"--dangerously-skip-permissions\", \"--print\", \"--output-format\", \"text\", \"--max-turns\", \"0\", f\"@{prompt_file}\"]\n    env = {**dict(os.environ), \"SE3_AGENT_ROLE\": \"manager\", \"SE3_PROJECT_ROOT\": str(project_root)}\n    env.pop(\"CLAUDECODE\", None)  # Avoid nested session detection\n\n    runner = ClaudeRunner(project_root)\n    proc, _ = runner.popen(\n        args=args,\n        cwd=project_root,\n        env=env,\n        stdout=subprocess.PIPE,\n        stderr=subprocess.STDOUT,\n        bufsize=1,\n        universal_newlines=True,\n    )\n    return proc\n\n\ndef launch_worker(project_root: Path, task_id: str) -> subprocess.Popen:\n    \"\"\"Launch worker as independent Claude process in worktree.\n\n    Uses ClaudeRunner for priority-based command selection with activity monitoring.\n\n    Returns a Popen-like object with wait() and returncode for compatibility.\n    \"\"\"\n    from ..claude_runner import ClaudeRunner, MonitoredResult\n\n    collab_dir = get_collab_dir(project_root)\n    task_file = collab_dir / \"tasks\" / f\"{task_id}.json\"\n    task = json.loads(task_file.read_text())\n\n    worktree = task.get(\"worktree\", f\".worktrees/{task_id}\")\n    if not worktree.startswith(\"/\"):\n        worktree = str(project_root / worktree)\n\n    # Ensure worktree exists\n    if not Path(worktree).exists():\n        branch = task.get(\"branch\", f\"collab/{task_id}\")\n        base_branch = task.get(\"base_branch\", \"master\")\n        subprocess.run(\n            [\"git\", \"worktree\", \"add\", worktree, \"-b\", branch, base_branch],\n            cwd=project_root,\n            capture_output=True\n        )\n\n    prompt = generate_worker_prompt(project_root, task_id)\n\n    # Write prompt to file and use @file syntax to avoid CLI parsing issues\n    collab_dir = get_collab_dir(project_root)\n    prompt_file = collab_dir / \"logs\" / f\"worker-{task_id}-{datetime.now().strftime('%Y%m%d-%H%M%S')}.prompt\"\n    prompt_file.write_text(prompt)\n\n    args = [\"--dangerously-skip-permissions\", \"--print\", \"--max-turns\", \"0\", f\"@{prompt_file}\"]\n    env = {\n        **dict(os.environ),\n        \"SE3_TASK_ID\": task_id,\n        \"SE3_AGENT_ROLE\": \"worker\",\n        \"SE3_PROJECT_ROOT\": str(project_root)\n    }\n    env.pop(\"CLAUDECODE\", None)  # Avoid nested session detection\n\n    log_file = collab_dir / \"logs\" / f\"worker-{task_id}-{datetime.now().strftime('%Y%m%d-%H%M%S')}.log\"\n    timeout_min = task.get(\"health\", {}).get(\"timeout_minutes\", 60)\n\n    # Initialize last_activity if not present\n    if \"last_activity\" not in task.get(\"health\", {}):\n        task[\"health\"][\"last_activity\"] = datetime.now().isoformat()\n        task_file.write_text(json.dumps(task, indent=2))\n\n    # Activity callback: update task's last_activity timestamp whenever output is received\n    def on_activity():\n        try:\n            with open(task_file, \"r\", encoding=\"utf-8\") as f:\n                current_task = json.load(f)\n            current_task[\"health\"][\"last_activity\"] = datetime.now().isoformat()\n            with open(task_file, \"w\", encoding=\"utf-8\") as f:\n                json.dump(current_task, f, indent=2)\n        except Exception as e:\n            print(f\"[collab] Failed to update last_activity: {e}\", file=sys.stderr)\n\n    runner = ClaudeRunner(project_root)\n\n    # Use run_with_monitor for activity-based monitoring and command fallback\n    result = runner.run_with_monitor(\n        args=args,\n        log_file=log_file,\n        wall_timeout=timeout_min * 60,\n        inactivity_timeout=300,  # 5 minutes without output = stuck\n        cwd=Path(worktree),\n        env=env,\n        on_activity=on_activity,\n    )\n\n    # Create a simple wrapper object for compatibility\n    class WorkerResult:\n        def __init__(self, returncode: int):\n            self.returncode = returncode\n\n        def wait(self) -> int:\n            return self.returncode\n\n        def communicate(self, timeout=None) -> tuple:\n            return (b\"\", b\"\")\n\n        def poll(self) -> int:\n            return self.returncode\n\n    return WorkerResult(result.returncode)\n\n\ndef start_daemon(project_root: Path, objective: str, resume: bool = False):\n    \"\"\"Start orchestrator daemon mode.\"\"\"\n    ensure_collab_structure(project_root)\n    collab_dir = get_collab_dir(project_root)\n\n    if not resume:\n        # Clean up old tasks from previous sessions\n        tasks_dir = collab_dir / \"tasks\"\n        if tasks_dir.exists():\n            for f in tasks_dir.glob(\"task-*.json\"):\n                f.unlink()\n            for f in tasks_dir.glob(\".exitcode-*\"):\n                f.unlink()\n\n        # Create session config\n        result = subprocess.run(\n            [\"git\", \"branch\", \"--show-current\"],\n            cwd=project_root,\n            capture_output=True,\n            text=True\n        )\n        base_branch = result.stdout.strip() or \"master\"\n\n        config = {\n            \"session_id\": f\"collab-{datetime.now().strftime('%Y%m%d-%H%M%S')}\",\n            \"objective\": objective,\n            \"base_branch\": base_branch,\n            \"created_at\": datetime.now().isoformat(),\n            \"max_parallel_workers\": 3,\n            \"status\": \"active\"\n        }\n        (collab_dir / \"config.json\").write_text(json.dumps(config, indent=2))\n\n        typer.echo(f\"Created collaboration session: {config['session_id']}\")\n        typer.echo(f\"Objective: {objective}\")\n\n    # Start the orchestrator daemon\n    script = project_root / \"scripts\" / \"collab-orchestrator.sh\"\n    if not script.exists():\n        typer.echo(f\"Error: orchestrator script not found at {script}\")\n        raise typer.Exit(1)\n\n    cmd = [\"bash\", str(script), \"--daemon\"]\n    if resume:\n        cmd.append(\"--resume\")\n    elif objective:\n        cmd.append(objective)\n\n    # Start in background - MUST clear CLAUDECODE to avoid nested session detection\n    env = {**dict(os.environ), \"PROJECT_ROOT\": str(project_root)}\n    env.pop(\"CLAUDECODE\", None)  # Clear to allow manager/worker to run Claude\n\n    subprocess.Popen(\n        cmd,\n        stdout=open(collab_dir / \"logs\" / \"orchestrator.log\", \"w\"),\n        stderr=subprocess.STDOUT,\n        env=env,\n        cwd=project_root,\n        start_new_session=True  # Detach from terminal\n    )\n\n    typer.echo(f\"Orchestrator daemon started.\")\n    typer.echo(f\"Use 'se3 collab --status' to check progress\")\n    typer.echo(f\"Use 'se3 collab --abort' to stop\")\n\n\ndef run_manual_mode(project_root: Path, objective: str):\n    \"\"\"Manual mode: generate initial plan, print commands for user to execute.\"\"\"\n    ensure_collab_structure(project_root)\n    collab_dir = get_collab_dir(project_root)\n\n    # Get base branch\n    result = subprocess.run(\n        [\"git\", \"branch\", \"--show-current\"],\n        cwd=project_root,\n        capture_output=True,\n        text=True\n    )\n    base_branch = result.stdout.strip() or \"master\"\n\n    # Create session config\n    config = {\n        \"session_id\": f\"collab-{datetime.now().strftime('%Y%m%d-%H%M%S')}\",\n        \"objective\": objective,\n        \"base_branch\": base_branch,\n        \"created_at\": datetime.now().isoformat(),\n        \"max_parallel_workers\": 3,\n        \"status\": \"manual\"\n    }\n    (collab_dir / \"config.json\").write_text(json.dumps(config, indent=2))\n\n    typer.echo(f\"\\n{'=' * 60}\")\n    typer.echo(\"SE3 Collaboration - Manual Mode\")\n    typer.echo(f\"{'=' * 60}\")\n    typer.echo(f\"\\nObjective: {objective}\")\n    typer.echo(f\"Base branch: {base_branch}\")\n    typer.echo(f\"\\nStep 1: Launch Manager to create plan\")\n    typer.echo(f\"  se3 collab --launch-manager plan\")\n    typer.echo(f\"\\nStep 2: After manager creates tasks, launch workers:\")\n    typer.echo(f\"  se3 collab --launch-worker task-001\")\n    typer.echo(f\"\\nStep 3: When worker completes, review with manager:\")\n    typer.echo(f\"  se3 collab --launch-manager review\")\n    typer.echo(f\"\\nOr use daemon mode for automatic execution:\")\n    typer.echo(f\"  se3 collab --daemon \\\"{objective}\\\"\")\n    typer.echo(f\"{'=' * 60}\\n\")\n\n\n@app.callback()\ndef collab(\n    objective: str = typer.Argument(None, help=\"Collaboration objective\"),\n    resume: bool = typer.Option(False, \"--resume\", help=\"Resume a previous session\"),\n    status: bool = typer.Option(False, \"--status\", help=\"Show collaboration status\"),\n    abort: bool = typer.Option(False, \"--abort\", help=\"Abort and cleanup\"),\n    daemon: bool = typer.Option(False, \"--daemon\", help=\"Start orchestrator daemon (auto mode)\"),\n    manual: bool = typer.Option(False, \"--manual\", help=\"Manual mode: generate plan, print commands\"),\n    launch_manager_flag: bool = typer.Option(False, \"--launch-manager\", help=\"Launch manager for event type (internal)\"),\n    launch_worker_flag: bool = typer.Option(False, \"--launch-worker\", help=\"Launch worker for task (internal)\"),\n    event_type: str = typer.Option(\"plan\", \"--event\", help=\"Event type for manager\"),\n    task_id: str = typer.Option(None, \"--task\", help=\"Task ID for worker\"),\n    mock: bool = typer.Option(False, \"--mock\", help=\"Use mock for testing\"),\n    project_root: str = typer.Option(None, \"--project-root\", \"-p\", help=\"Project root directory\"),\n):\n    \"\"\"Manage git-worktree based multi-agent collaboration.\n\n    Independent Entry Mode:\n    - Use --daemon for automatic execution (orchestrator manages everything)\n    - Use --manual to generate plan and execute manually\n    \"\"\"\n    root = Path(project_root) if project_root else find_project_root()\n\n    if status:\n        print_status(root)\n        raise typer.Exit(0)\n\n    if abort:\n        abort_session(root)\n        raise typer.Exit(0)\n\n    if launch_manager_flag:\n        # Internal: launch manager process\n        context = objective if objective else \"\"\n        proc = launch_manager(root, event_type, context)\n        stdout, _ = proc.communicate(timeout=900)  # 15 min timeout\n        if proc.returncode == 0 and stdout:\n            print(stdout.decode() if isinstance(stdout, bytes) else stdout)\n        raise typer.Exit(proc.returncode)\n\n    if launch_worker_flag:\n        # Internal: launch worker process with activity monitoring\n        if not task_id:\n            typer.echo(\"Error: --task required for --launch-worker\")\n            raise typer.Exit(1)\n        result = launch_worker(root, task_id)\n        raise typer.Exit(result.returncode)\n\n    if daemon:\n        if not resume and not objective:\n            typer.echo(\"Error: provide an objective or use --resume\")\n            raise typer.Exit(1)\n        start_daemon(root, objective or \"\", resume)\n        raise typer.Exit(0)\n\n    if manual:\n        if not objective:\n            typer.echo(\"Error: provide an objective\")\n            raise typer.Exit(1)\n        run_manual_mode(root, objective)\n        raise typer.Exit(0)\n\n    # Default: run orchestrator directly (legacy mode, for testing)\n    if not resume and not objective:\n        typer.echo(\"Error: provide an objective, use --daemon, --manual, or --resume\")\n        raise typer.Exit(1)\n\n    script = root / \"scripts\" / \"collab-orchestrator.sh\"\n    if not script.exists():\n        typer.echo(f\"Error: orchestrator script not found at {script}\")\n        raise typer.Exit(1)\n\n    cmd = [\"bash\", str(script)]\n    if resume:\n        cmd.append(\"--resume\")\n    if mock:\n        cmd.append(\"--mock\")\n    if objective:\n        cmd.append(objective)\n\n    env = {**dict(os.environ), \"PROJECT_ROOT\": str(root)}\n\n    try:\n        result = subprocess.run(cmd, env=env, cwd=root)\n        raise typer.Exit(result.returncode)\n    except KeyboardInterrupt:\n        typer.echo(\"\\nInterrupted. Use 'se3 collab --abort' to cleanup.\")\n        raise typer.Exit(130)\n","numLines":607,"startLine":1,"totalLines":607}}}
