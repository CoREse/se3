led = get_installed_se3_version()\n    47→            if installed != \"0.0.0\":\n    48→                typer.echo(f\"Project SE3 version: {installed}\")\n    49→        except Exception:\n    50→            pass\n    51→        raise typer.Exit()\n    52→\n    53→@app.callback()\n    54→def main(\n    55→    ctx: typer.Context,\n    56→    version: bool = typer.Option(\n    57→        False, \"--version\", \"-v\", help=\"Show version information\", callback=_version_callback, is_eager=True\n    58→    ),\n    59→):\n    60→    \"\"\"SE 3.0 framework CLI tools.\"\"\"\n    61→    if ctx.invoked_subcommand is None:\n    62→        typer.echo(ctx.get_help())\n    63→        raise typer.Exit()\n    64→\n    65→\n    66→# Register direct commands\n    67→@app.command(name=\"init\")\n    68→def init_cmd(\n    69→    force: bool = typer.Option(False, \"--force\", \"-f\", help=\"Reinitialize even if already initialized\"),\n    70→    offline: bool = typer.Option(False, \"--offline\", \"-o\", help=\"Use local templates without network\"),\n    71→    with_config: bool = typer.Option(False, \"--with-config\", \"-c\", help=\"Create se3.config.yaml\"),\n    72→    se3_version: str = typer.Option(SE3_FRAMEWORK_VERSION, \"--se3-version\", \"-v\", help=\"Specify SE3 version to use\"),\n    73→):\n    74→    \"\"\"Initialize a new SE 3.0 project.\"\"\"\n    75→    try:\n    76→        initialize_project(force, offline, with_config, se3_version)\n    77→    except Exception as e:\n    78→        typer.echo(\n    79→            typer.style(\n    80→                f\"Error during initialization: {str(e)}\",\n    81→                fg=typer.colors.RED,\n    82→            )\n    83→        )\n    84→        raise typer.Exit(1)\n    85→\n    86→# Register sub-typer commands (complex multi-command tools)\n    87→app.add_typer(lint.app, name=\"lint\", help=\"Lint OpenSpec files\")\n    88→app.add_typer(status.app, name=\"status\", help=\"Check project status\")\n    89→app.add_typer(sync.app, name=\"sync\", help=\"Sync output files\")\n    90→app.add_typer(verify.app, name=\"verify\", help=\"Verify spec coverage\")\n    91→app.add_typer(update.app, name=\"update\", help=\"Update SE 3.0 framework to latest version\")\n    92→app.add_typer(collab.app, name=\"collab\", help=\"Manage git-worktree multi-agent collaboration\")\n    93→app.add_typer(commit.app, name=\"commit\", help=\"Commit changes with SE3 verification\")\n    94→\n    95→# Register direct commands (simple single-command tools with positional args)\n    96→# These are registered as direct commands to avoid sub-typer nesting issues\n    97→@app.command(name=\"start\")\n    98→def start_cmd(\n    99→    format: str = typer.Option(\"text\", \"--format\", \"-f\", help=\"Output format (text or json)\"),\n   100→    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n   101→):\n   102→    \"\"\"Start an SE3 session — compute state and return actions for the agent.\"\"\"\n   103→    from .commands.start import run_session_start, print_text_report, print_json_report\n   104→    import json\n   105→    state = run_session_start(project_root)\n   106→    if format == \"json\":\n   107→        print_json_report(state)\n   108→    else:\n   109→        print_text_report(state)\n   110→    raise typer.Exit(code=0 if not state.get(\"actions\") else 1)\n   111→\n   112→@app.command(name=\"work\")\n   113→def work_cmd(\n   114→    change_name: Optional[str] = typer.Argument(None, help=\"Name of the change to work on\"),\n   115→    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n   116→    new: Optional[str] = typer.Option(None, \"--new\", help=\"Create new change with workflow type (bugfix/feature/review/directive)\"),\n   117→    advance: bool = typer.Option(False, \"--advance\", \"-a\", help=\"Mark current step complete and advance to next\"),\n   118→    format: str = typer.Opti