{"type":"user","message":{"role":"user","content":[{"tool_use_id":"tool_VtSixC37seVEDEmEpbZX5f5a","type":"tool_result","content":"     1→\"\"\"Tests for the human calls archive functionality.\n     2→\n     3→Tests cover:\n     4→- Archive command (with and without dry-run)\n     5→- List command (various status filters)\n     6→- Archive directory creation\n     7→- Filename collision handling\n     8→\"\"\"\n     9→\n    10→import os\n    11→import sys\n    12→import tempfile\n    13→from pathlib import Path\n    14→\n    15→import pytest\n    16→\n    17→# Add tools to path for imports\n    18→sys.path.insert(0, str(Path(__file__).parent.parent / \"tools\"))\n    19→\n    20→from se3_tools.commands.human_calls_cmd import (\n    21→    find_project_root,\n    22→    get_archive_dir,\n    23→    ensure_archive_dir,\n    24→    is_call_completed,\n    25→    get_pending_calls_count,\n    26→    get_responded_calls_count,\n    27→)\n    28→from se3_tools.human_calls import (\n    29→    HumanCall,\n    30→    HumanCallStore,\n    31→    CallStatus,\n    32→    CallType,\n    33→    CallPriority,\n    34→)\n    35→\n    36→\n    37→class TestArchiveDirectory:\n    38→    \"\"\"Test archive directory operations.\"\"\"\n    39→\n    40→    def test_ensure_archive_dir_creates_directory(self):\n    41→        \"\"\"Should create archive directory if it doesn't exist.\"\"\"\n    42→        with tempfile.TemporaryDirectory() as tmpdir:\n    43→            root = Path(tmpdir)\n    44→            archive_dir = ensure_archive_dir(root)\n    45→\n    46→            assert archive_dir.exists()\n    47→            assert archive_dir.name == \"archive\"\n    48→            assert archive_dir.parent.name == \"human-calls\"\n    49→\n    50→    def test_ensure_archive_dir_existing(self):\n    51→        \"\"\"Should return existing archive directory.\"\"\"\n    52→        with tempfile.TemporaryDirectory() as tmpdir:\n    53→            root = Path(tmpdir)\n    54→            existing = root / \"human-calls\" / \"archive\"\n    55→            existing.mkdir(parents=True)\n    56→\n    57→            archive_dir = ensure_archive_dir(root)\n    58→            assert archive_dir == existing\n    59→\n    60→\n    61→class TestIsCallCompleted:\n    62→    \"\"\"Test call completion detection.\"\"\"\n    63→\n    64→    def test_responded_status_is_completed(self):\n    65→        \"\"\"Should consider RESPONDED status as completed.\"\"\"\n    66→        call = HumanCall(\n    67→            id=\"test-001\",\n    68→            file_path=Path(\"/tmp/test.md\"),\n    69→            status=CallStatus.RESPONDED,\n    70→        )\n    71→        assert is_call_completed(call) is True\n    72→\n    73→    def test_completed_status_is_completed(self):\n    74→        \"\"\"Should consider COMPLETED status as completed.\"\"\"\n    75→        call = HumanCall(\n    76→            id=\"test-001\",\n    77→            file_path=Path(\"/tmp/test.md\"),\n    78→            status=CallStatus.COMPLETED,\n    79→        )\n    80→        assert is_call_completed(call) is True\n    81→\n    82→    def test_pending_status_not_completed(self):\n    83→        \"\"\"Should not consider PENDING status as completed.\"\"\"\n    84→        call = HumanCall(\n    85→            id=\"test-001\",\n    86→            file_path=Path(\"/tmp/test.md\"),\n    87→            status=CallStatus.PENDING,\n    88→        )\n    89→        assert is_call_completed(call) is False\n    90→\n    91→    def test_meaningful_response_considered_completed(self):\n    92→        \"\"\"Should consider call with meaningful response as completed.\"\"\"\n    93→        call = HumanCall(\n    94→            id=\"test-001\",\n    95→            file_path=Path(\"/tmp/test.md\"),\n    96→            status=CallStatus.PENDING,  # Even with pending status\n    97→            response=\"This is a meaningful response with enough content.\",\n    98→        )\n    99→        assert is_call_completed(call) is True\n   100→\n   101→    def test_default_prompt_response_not_completed(self):\n   102→        \"\"\"Should not consider default prompt marker as completed.\"\"\"\n   103→        call = HumanCall(\n   104→            id=\"test-001\",\n   105→            file_path=Path(\"/tmp/test.md\"),\n   106→            status=CallStatus.PENDING,\n   107→            response=\"<!-- Human: write your response below -->\",\n   108→        )\n   109→        assert is_call_completed(call) is False\n   110→\n   111→    def test_short_response_not_completed(self):\n   112→        \"\"\"Should not consider very short response as completed.\"\"\"\n   113→        call = HumanCall(\n   114→            id=\"test-001\",\n   115→            file_path=Path(\"/tmp/test.md\"),\n   116→            status=CallStatus.PENDING,\n   117→            response=\"Hi\",\n   118→        )\n   119→        assert is_call_completed(call) is False\n   120→\n   121→\n   122→class TestGetCallsCounts:\n   123→    \"\"\"Test getting call counts for status display.\"\"\"\n   124→\n   125→    def test_get_pending_calls_count(self):\n   126→        \"\"\"Should return correct count of pending calls.\"\"\"\n   127→        with tempfile.TemporaryDirectory() as tmpdir:\n   128→            root = Path(tmpdir)\n   129→            calls_dir = root / \"human-calls\"\n   130→            calls_dir.mkdir(parents=True)\n   131→\n   132→            store = HumanCallStore(calls_dir)\n   133→            store.create_call(\"Pending 1\", \"Context 1\")\n   134→            store.create_call(\"Pending 2\", \"Context 2\")\n   135→\n   136→            count = get_pending_calls_count(root)\n   137→            assert count == 2\n   138→\n   139→    def test_get_pending_calls_count_empty(self):\n   140→        \"\"\"Should return 0 when no pending calls.\"\"\"\n   141→        with tempfile.TemporaryDirectory() as tmpdir:\n   142→            root = Path(tmpdir)\n   143→            calls_dir = root / \"human-calls\"\n   144→            calls_dir.mkdir(parents=True)\n   145→\n   146→            count = get_pending_calls_count(root)\n   147→            assert count == 0\n   148→\n   149→    def test_get_pending_calls_count_no_directory(self):\n   150→        \"\"\"Should return 0 when human-calls directory doesn't exist.\"\"\"\n   151→        with tempfile.TemporaryDirectory() as tmpdir:\n   152→            root = Path(tmpdir)\n   153→\n   154→            count = get_pending_calls_count(root)\n   155→            assert count == 0\n   156→\n   157→    def test_get_responded_calls_count(self):\n   158→        \"\"\"Should return correct count of responded calls.\"\"\"\n   159→        with tempfile.TemporaryDirectory() as tmpdir:\n   160→            root = Path(tmpdir)\n   161→            calls_dir = root / \"human-calls\"\n   162→            calls_dir.mkdir(parents=True)\n   163→\n   164→            store = HumanCallStore(calls_dir)\n   165→\n   166→            # Create a call and simulate a response\n   167→            call = store.create_call(\"Test Call\", \"Test context\")\n   168→            content = call.file_path.read_text()\n   169→            content = content.replace(\n   170→                \"<!-- Human: write your response below -->\",\n   171→                \"This is a response with enough content to be valid.\"\n   172→            )\n   173→            call.file_path.write_text(content)\n   174→\n   175→            count = get_responded_calls_count(root)\n   176→            assert count == 1\n   177→\n   178→\n   179→class TestArchiveCommandIntegration:\n   180→    \"\"\"Integration tests for archive command.\"\"\"\n   181→\n   182→    def test_archive_moves_completed_calls(self):\n   183→        \"\"\"Should move completed calls to archive directory.\"\"\"\n   184→        with tempfile.TemporaryDirectory() as tmpdir:\n   185→            root = Path(tmpdir)\n   186→            calls_dir = root / \"human-calls\"\n   187→            calls_dir.mkdir(parents=True)\n   188→            archi