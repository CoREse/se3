→        try:\n    46→            installed = get_installed_se3_version()\n    47→            if installed != \"0.0.0\":\n    48→                typer.echo(f\"Project SE3 version: {installed}\")\n    49→        except Exception:\n    50→            pass\n    51→        raise typer.Exit()\n    52→\n    53→@app.callback()\n    54→def main(\n    55→    ctx: typer.Context,\n    56→    version: bool = typer.Option(\n    57→        False, \"--version\", \"-v\", help=\"Show version information\", callback=_version_callback, is_eager=True\n    58→    ),\n    59→):\n    60→    \"\"\"SE 3.0 framework CLI tools.\"\"\"\n    61→    if ctx.invoked_subcommand is None:\n    62→        typer.echo(ctx.get_help())\n    63→        raise typer.Exit()\n    64→\n    65→\n    66→# Register direct commands\n    67→@app.command(name=\"init\")\n    68→def init_cmd(\n    69→    force: bool = typer.Option(False, \"--force\", \"-f\", help=\"Reinitialize even if already initialized\"),\n    70→    offline: bool = typer.Option(False, \"--offline\", \"-o\", help=\"Use local templates without network\"),\n    71→    with_config: bool = typer.Option(False, \"--with-config\", \"-c\", help=\"Create se3.config.yaml\"),\n    72→    se3_version: str = typer.Option(SE3_FRAMEWORK_VERSION, \"--se3-version\", \"-v\", help=\"Specify SE3 version to use\"),\n    73→):\n    74→    \"\"\"Initialize a new SE 3.0 project.\"\"\"\n    75→    try:\n    76→        initialize_project(force, offline, with_config, se3_version)\n    77→    except Exception as e:\n    78→        typer.echo(\n    79→            typer.style(\n    80→                f\"Error during initialization: {str(e)}\",\n    81→                fg=typer.colors.RED,\n    82→            )\n    83→        )\n    84→        raise typer.Exit(1)\n    85→\n    86→# Register sub-typer commands (complex multi-command tools)\n    87→app.add_typer(lint.app, name=\"lint\", help=\"Lint OpenSpec files\")\n    88→app.add_typer(status.app, name=\"status\", help=\"Check project status\")\n    89→app.add_typer(sync.app, name=\"sync\", help=\"Sync output files\")\n    90→app.add_typer(verify.app, name=\"verify\", help=\"Verify spec coverage\")\n    91→app.add_typer(update.app, name=\"update\", help=\"Update SE 3.0 framework to latest version\")\n    92→app.add_typer(collab.app, name=\"collab\", help=\"Manage git-worktree multi-agent collaboration\")\n    93→app.add_typer(commit.app, name=\"commit\", help=\"Commit changes with SE3 verification\")\n    94→app.add_typer(openspec.app, name=\"openspec\", help=\"Manage OpenSpec directory and specs\")\n    95→app.add_typer(human_calls_cmd.app, name=\"human-calls\", help=\"Manage human calls\")\n    96→app.add_typer(human_input.app, name=\"human\", help=\"Manage human input\")\n    97→\n    98→# Register direct commands (simple single-command tools with positional args)\n    99→# These are registered as direct commands to avoid sub-typer nesting issues\n   100→@app.command(name=\"start\")\n   101→def start_cmd(\n   102→    format: str = typer.Option(\"text\", \"--format\", \"-f\", help=\"Output format (text or json)\"),\n   103→    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n   104→):\n   105→    \"\"\"Start an SE3 session — compute state and return actions for the agent.\"\"\"\n   106→    from .commands.start import run_session_start, print_text_report, print_json_report\n   107→    import json\n   108→    state = run_session_start(project_root)\n   109→    if format == \"json\":\n   110→        print_json_report(state)\n   111→    else:\n   112→        print_text_report(state)\n   113→    raise typer.Exit(code=0 if not state.get(\"actions\") else 1)\n   114→\n   115→@app.command(name=\"work\")\n   116→def work_cmd(\n   117→    change_name: Optional[str] = typer.Argument(None, help=\"Name of the change to work on\"),\n   118→    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n   119→    new: Optional[str] = typer.Option(None, \"--new\", help=\"Create new change with workflow type (bugfix/feature/review/directive)\"),\n   120→    advance: bool = typer.Option(False, \"--advance\", \"-a\", help=\"Mark current step complete and advance to next\"),\n   121→    format: str = typer.Option(\"text\", \"--format\", \"-f\", help=\"Output format (text or json)\"),\n   122→):\n   123→    \"\"\"Start or continue working on a change — the SDD workflow driver.\"\"\"\n   124→    from .commands.work import run_work, print_text_report, print_json_report\n   125→    result = run_work(project_root, change_name, new, advance)\n   126→    if format == \"json\":\n   127→        print_json_report(result)\n   128→    else:\n   129→        print_text_report(result)\n   130→    raise typer.Exit(code=0 if result.get(\"change\") else 1)\n   131→\n   132→@app.command(name=\"done\")\n   133→def done_cmd(\n   134→    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n   135→    format: str = typer.Option(\"text\", \"--format\", \"-f\", help=\"Output format (text or json)\"),\n   136→):\n   137→    \"\"\"End an SE3 session — compute shutdown actions for the agent.\"\"\"\n   138→    from .commands.done import run_session_done, print_text_report, print_json_report\n   139→    state = run_session_done(project_root)\n   140→    if format == \"json\":\n   141→        print_json_report(state)\n   142→    else:\n   143→        print_text_report(state)\n   144→    raise typer.Exit(code=0)\n   145→\n   146→def _full_cycle_cmd_impl(\n   147→    description: str,\n   148→    project_root: str,\n   149→    quick: bool,\n   150→    format: str,\n   151→):\n   152→    \"\"\"Implementation of full-cycle command.\"\"\"\n   153→    from .commands.fullcycle import run_full_cycle, print_text_report as fullcycle_print_text, print_json_report as fullcycle_print_json\n   154→    result = run_full_cycle(description, project_root, quick)\n   155→    if format == \"json\":\n   156→        fullcycle_print_json(result)\n   157→    else:\n   158→        fullcycle_print_text(result)\n   159→    raise typer.Exit(code=0 if result.get(\"success\") else 1)\n   160→\n   161→\n   162→@app.command(name=\"full-cycle\")\n   163→def full_cycle_cmd(\n   164→    description: str = typer.Argument(..., help=\"Description of the work to do\"),\n   165→    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n   166→    quick: bool = typer.Option(False, \"--quick\", \"-q\", help=\"Quick mode - skip formal change creation, use 'small' workflow\"),\n   167→    format: str = typer.Option(\"text\", \"--format\", \"-f\", help=\"Output format (text or json)\"),\n   168→):\n   169→    \"\"\"Run the complete start-work-done workflow in one command.\n   170→\n   171→    This command streamlines simple/quick tasks by combining:\n   172→    1. se3 start - Initialize the session\n   173→    2. se3 work --new - Create a change for the work\n   174→    3. Implementation (performed by agent)\n   175→    4. se3 done - Complete the session\n   176→\n   177→    Examples:\n   178→        se3 full-cycle \"fix login bug\"\n   179→        se3 full-cycle \"add user profile page\" --quick\n   180→        se3 full-cycle \"update documentation\" -q --json\n   181→    \"\"\"\n   182→    _full_cycle_cmd_impl(description, project_root, quick, format)\n   183→\n   184→\n   185→@app.command(name=\"fc\")\n   186→def fc_cmd(\n   187→    description: str = typer.Argument(..., help=\"Description of the work to do\"),\n   188→    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n   189→    quick: bool = typer.Option(False, \"--quick\", \"-q\", help=\"Quick mode - skip formal change creation, use 'small' workflow\"),\n   190→    format: str = typer.Option(\"text\", \"--format\", \"-f\", help=\"Output format (text or json)\"),\n   191→):\n   192→    \"\"\"Alias for 'full-cycle' - Run the complete start-work-done workflow in one command.\"\"\"\n   193→    _full_cycle_cmd_impl(description, project_root, quick, format)\n   194→\n   195→# Register handoff as a direct command (not a sub-typer)\n   196→@app.command(name=\"handoff\")\n   197→def handoff_cmd(\n   198→    message: Optional[str] = typer.Argument(None, help=\"Handoff message describing what was done\"),\n   199→    project_root: Optional[str] = typer.Option(None, \"--project-root\", \"-p\", help=\"Project root directory\"),\n   200→    dry_run: bool = typer.Option(False, \"--dry-run\", help=\"Preview what would happen without executing\"),\n   201→    skip_commit: bool = typer.Option(False, \"--skip-commit\", help=\"Skip automatic commit (use with caution)\"),\n   202→):\n   203→    \"\"\"Handoff control to human — enforcing SE3 commit-before-handoff rule.\"\"\"\n   204→    from .commands.handoff import handoff\n   205→    handoff(message=message, project_root=project_root, dry_run=dry_run, skip_commit=skip_commit)\n   206→\n   207→\n   208→@app.command(name=\"claude-cmd\")\n   209→def claude_cmd(\n   210→    all_cmds: bool = typer.Option(False, \"--all\", help=\"Output all commands as JSON sorted by priority\"),\n   211→    next_after: Optional[str] = typer.Option(None, \"--next\", help=\"Output the next command after the given one\"),\n   212→    project_root: Optional[str] = typer.Option(None, \"--project-root\", \"-p\", help=\"Project root directory\"),\n   213→):\n   214→    \"\"\"Show configured Claude commands by priority.\n   215→\n   216→    Used by bash scripts to resolve which Claude command to use.\n   217→    \"\"\"\n   218→    from .config import load_claude_commands\n   219→\n   220→    root = Path(project_root) if project_root else Path.cwd()\n   221→    commands = load_claude_commands(root)\n   222→\n   223→    if all_cmds:\n   224→        typer.echo(json.dumps(commands))\n   225→    elif next_after:\n   226→        found = False\n   227→        for i, entry in enumerate(commands):\n   228→            if entry[\"cmd\"] == next_after:\n   229→                if i + 1 < len(commands):\n   230→                    typer.echo(commands[i + 1][\"cmd\"])\n   231→                else:\n   232→                    typer.echo(\"\")  # No next command\n   233→                found = True\n   234→                break\n   235→        if not found:\n   236→            typer.echo(\"\")  # Command not in list\n   237→    else:\n   238→        # Default: output highest-priority command\n   239→        typer.echo(commands[0][\"cmd\"])\n   240→\n   241→\n   242→if __name__ == \"__main__\":\n   243→    app()\n   244→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"1f63c24c-7ab6-4686-be8c-0640fbd6608e","uuid":"ea996762-c1e4-4df8-a94f-75d9d7395665","tool_use_result":{"type":"text","file":{"filePath":"/data/cre/workspace/se3.0/.worktrees/verify-human-calls-archive/tools/se3_tools/cli.py","content":"\"\"\"SE 3.0 CLI - Main entry point for se3 commands.\"\"\"\n\nimport json\nfrom pathlib import Path\nfrom typing import Optional\n\nimport typer\n\nfrom . import __version__, SE3_FRAMEWORK_VERSION\n\ndef get_framework_version() -> str:\n    \"\"\"Get current framework version from single source of truth (direct file read for git worktree compatibility).\"\"\"\n    import os\n    from pathlib import Path\n    import re\n\n    # Get the path to __init__.py in the current working tree\n    init_file = Path(__file__).parent / \"__init__.py\"\n    if not init_file.exists():\n        raise FileNotFoundError(f\"Cannot find se3_tools __init__.py at {init_file}\")\n\n    with open(init_file, \"r\", encoding=\"utf-8\") as f:\n        content = f.read()\n\n    match = re.search(r'SE3_FRAMEWORK_VERSION\\s*=\\s*\"([\\d]+\\.[\\d]+\\.[\\d]+)\"', content)\n    if not match:\n        raise ValueError(\"Cannot find SE3_FRAMEWORK_VERSION definition in __init__.py\")\n\n    return match.group(1)\nfrom .commands import lint, status, sync, verify, update, collab, commit, openspec, human_calls_cmd, human_input\nfrom .commands.update import get_installed_se3_version\nfrom .commands.init import initialize_project\n\napp = typer.Typer(\n    name=\"se3\",\n    help=\"SE 3.0 framework CLI tools\",\n    invoke_without_command=True,\n)\n\ndef _version_callback(value: bool):\n    \"\"\"Handle --version flag.\"\"\"\n    if value:\n        typer.echo(f\"se3 CLI version: {__version__}\")\n        typer.echo(f\"SE3 Framework version: {get_framework_version()}\")\n        try:\n            installed = get_installed_se3_version()\n            if installed != \"0.0.0\":\n                typer.echo(f\"Project SE3 version: {installed}\")\n        except Exception:\n            pass\n        raise typer.Exit()\n\n@app.callback()\ndef main(\n    ctx: typer.Context,\n    version: bool = typer.Option(\n        False, \"--version\", \"-v\", help=\"Show version information\", callback=_version_callback, is_eager=True\n    ),\n):\n    \"\"\"SE 3.0 framework CLI tools.\"\"\"\n    if ctx.invoked_subcommand is None:\n        typer.echo(ctx.get_help())\n        raise typer.Exit()\n\n\n# Register direct commands\n@app.command(name=\"init\")\ndef init_cmd(\n    force: bool = typer.Option(False, \"--force\", \"-f\", help=\"Reinitialize even if already initialized\"),\n    offline: bool = typer.Option(False, \"--offline\", \"-o\", help=\"Use local templates without network\"),\n    with_config: bool = typer.Option(False, \"--with-config\", \"-c\", help=\"Create se3.config.yaml\"),\n    se3_version: str = typer.Option(SE3_FRAMEWORK_VERSION, \"--se3-version\", \"-v\", help=\"Specify SE3 version to use\"),\n):\n    \"\"\"Initialize a new SE 3.0 project.\"\"\"\n    try:\n        initialize_project(force, offline, with_config, se3_version)\n    except Exception as e:\n        typer.echo(\n            typer.style(\n                f\"Error during initialization: {str(e)}\",\n                fg=typer.colors.RED,\n            )\n        )\n        raise typer.Exit(1)\n\n# Register sub-typer commands (complex multi-command tools)\napp.add_typer(lint.app, name=\"lint\", help=\"Lint OpenSpec files\")\napp.add_typer(status.app, name=\"status\", help=\"Check project status\")\napp.add_typer(sync.app, name=\"sync\", help=\"Sync output files\")\napp.add_typer(verify.app, name=\"verify\", help=\"Verify spec coverage\")\napp.add_typer(update.app, name=\"update\", help=\"Update SE 3.0 framework to latest version\")\napp.add_typer(collab.app, name=\"collab\", help=\"Manage git-worktree multi-agent collaboration\")\napp.add_typer(commit.app, name=\"commit\", help=\"Commit changes with SE3 verification\")\napp.add_typer(openspec.app, name=\"openspec\", help=\"Manage OpenSpec directory and specs\")\napp.add_typer(human_calls_cmd.app, name=\"human-calls\", help=\"Manage human calls\")\napp.add_typer(human_input.app, name=\"human\", help=\"Manage human input\")\n\n# Register direct commands (simple single-command tools with positional args)\n# These are registered as direct commands to avoid sub-typer nesting issues\n@app.command(name=\"start\")\ndef start_cmd(\n    format: str = typer.Option(\"text\", \"--format\", \"-f\", help=\"Output format (text or json)\"),\n    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n):\n    \"\"\"Start an SE3 session — compute state and return actions for the agent.\"\"\"\n    from .commands.start import run_session_start, print_text_report, print_json_report\n    import json\n    state = run_session_start(project_root)\n    if format == \"json\":\n        print_json_report(state)\n    else:\n        print_text_report(state)\n    raise typer.Exit(code=0 if not state.get(\"actions\") else 1)\n\n@app.command(name=\"work\")\ndef work_cmd(\n    change_name: Optional[str] = typer.Argument(None, help=\"Name of the change to work on\"),\n    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n    new: Optional[str] = typer.Option(None, \"--new\", help=\"Create new change with workflow type (bugfix/feature/review/directive)\"),\n    advance: bool = typer.Option(False, \"--advance\", \"-a\", help=\"Mark current step complete and advance to next\"),\n    format: str = typer.Option(\"text\", \"--format\", \"-f\", help=\"Output format (text or json)\"),\n):\n    \"\"\"Start or continue working on a change — the SDD workflow driver.\"\"\"\n    from .commands.work import run_work, print_text_report, print_json_report\n    result = run_work(project_root, change_name, new, advance)\n    if format == \"json\":\n        print_json_report(result)\n    else:\n        print_text_report(result)\n    raise typer.Exit(code=0 if result.get(\"change\") else 1)\n\n@app.command(name=\"done\")\ndef done_cmd(\n    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n    format: str = typer.Option(\"text\", \"--format\", \"-f\", help=\"Output format (text or json)\"),\n):\n    \"\"\"End an SE3 session — compute shutdown actions for the agent.\"\"\"\n    from .commands.done import run_session_done, print_text_report, print_json_report\n    state = run_session_done(project_root)\n    if format == \"json\":\n        print_json_report(state)\n    else:\n        print_text_report(state)\n    raise typer.Exit(code=0)\n\ndef _full_cycle_cmd_impl(\n    description: str,\n    project_root: str,\n    quick: bool,\n    format: str,\n):\n    \"\"\"Implementation of full-cycle command.\"\"\"\n    from .commands.fullcycle import run_full_cycle, print_text_report as fullcycle_print_text, print_json_report as fullcycle_print_json\n    result = run_full_cycle(description, project_root, quick)\n    if format == \"json\":\n        fullcycle_print_json(result)\n    else:\n        fullcycle_print_text(result)\n    raise typer.Exit(code=0 if result.get(\"success\") else 1)\n\n\n@app.command(name=\"full-cycle\")\ndef full_cycle_cmd(\n    description: str = typer.Argument(..., help=\"Description of the work to do\"),\n    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n    quick: bool = typer.Option(False, \"--quick\", \"-q\", help=\"Quick mode - skip formal change creation, use 'small' workflow\"),\n    format: str = typer.Option(\"text\", \"--format\", \"-f\", help=\"Output format (text or json)\"),\n):\n    \"\"\"Run the complete start-work-done workflow in one command.\n\n    This command streamlines simple/quick tasks by combining:\n    1. se3 start - Initialize the session\n    2. se3 work --new - Create a change for the work\n    3. Implementation (performed by agent)\n    4. se3 done - Complete the session\n\n    Examples:\n        se3 full-cycle \"fix login bug\"\n        se3 full-cycle \"add user profile page\" --quick\n        se3 full-cycle \"update documentation\" -q --json\n    \"\"\"\n    _full_cycle_cmd_impl(description, project_root, quick, format)\n\n\n@app.command(name=\"fc\")\ndef fc_cmd(\n    description: str = typer.Argument(..., help=\"Description of the work to do\"),\n    project_root: str = typer.Option(\".\", \"--project-root\", \"-p\", help=\"Root directory of the project\"),\n    quick: bool = typer.Option(False, \"--quick\", \"-q\", help=\"Quick mode - skip formal change creation, use 'small' workflow\"),\n    format: str = typer.Option(\"text\", \"--format\", \"-f\", help=\"Output format (text or json)\"),\n):\n    \"\"\"Alias for 'full-cycle' - Run the complete start-work-done workflow in one command.\"\"\"\n    _full_cycle_cmd_impl(description, project_root, quick, format)\n\n# Register handoff as a direct command (not a sub-typer)\n@app.command(name=\"handoff\")\ndef handoff_cmd(\n    message: Optional[str] = typer.Argument(None, help=\"Handoff message describing what was done\"),\n    project_root: Optional[str] = typer.Option(None, \"--project-root\", \"-p\", help=\"Project root directory\"),\n    dry_run: bool = typer.Option(False, \"--dry-run\", help=\"Preview what would happen without executing\"),\n    skip_commit: bool = typer.Option(False, \"--skip-commit\", help=\"Skip automatic commit (use with caution)\"),\n):\n    \"\"\"Handoff control to human — enforcing SE3 commit-before-handoff rule.\"\"\"\n    from .commands.handoff import handoff\n    handoff(message=message, project_root=project_root, dry_run=dry_run, skip_commit=skip_commit)\n\n\n@app.command(name=\"claude-cmd\")\ndef claude_cmd(\n    all_cmds: bool = typer.Option(False, \"--all\", help=\"Output all commands as JSON sorted by priority\"),\n    next_after: Optional[str] = typer.Option(None, \"--next\", help=\"Output the next command after the given one\"),\n    project_root: Optional[str] = typer.Option(None, \"--project-root\", \"-p\", help=\"Project root directory\"),\n):\n    \"\"\"Show configured Claude commands by priority.\n\n    Used by bash scripts to resolve which Claude command to use.\n    \"\"\"\n    from .config import load_claude_commands\n\n    root = Path(project_root) if project_root else Path.cwd()\n    commands = load_claude_commands(root)\n\n    if all_cmds:\n        typer.echo(json.dumps(commands))\n    elif next_after:\n        found = False\n        for i, entry in enumerate(commands):\n            if entry[\"cmd\"] == next_after:\n                if i + 1 < len(commands):\n                    typer.echo(commands[i + 1][\"cmd\"])\n                else:\n                    typer.echo(\"\")  # No next command\n                found = True\n                break\n        if not found:\n            typer.echo(\"\")  # Command not in list\n    else:\n        # Default: output highest-priority command\n        typer.echo(commands[0][\"cmd\"])\n\n\nif __name__ == \"__main__\":\n    app()\n","numLines":244,"startLine":1,"totalLines":244}}}
