d to human-calls/archive/.\n    41→\n    42→    Examples:\n    43→        se3 archive-calls                    # Archive calls > 30 days old\n    44→        se3 archive-calls --days 7           # Archive calls > 7 days old\n    45→        se3 archive-calls --dry-run          # Preview what would be archived\n    46→        se3 archive-calls --all-completed    # Archive all completed calls\n    47→        se3 archive-calls --stats            # Show statistics after archiving\n    48→    \"\"\"\n    49→    root = Path(project_root).resolve()\n    50→    calls_dir = _get_calls_dir(root)\n    51→\n    52→    if not calls_dir.exists():\n    53→        typer.echo(\n    54→            typer.style(\n    55→                f\"Error: Human calls directory not found at {calls_dir}\",\n    56→                fg=typer.colors.RED,\n    57→            )\n    58→        )\n    59→        raise typer.Exit(1)\n    60→\n    61→    store = HumanCallStore(calls_dir)\n    62→\n    63→    # Show current archive stats if requested\n    64→    if show_stats:\n    65→        stats = store.get_archive_stats()\n    66→        typer.echo(typer.style(\"Current Archive Statistics:\", fg=typer.colors.BLUE, bold=True))\n    67→        typer.echo(f\"  Total archived: {stats['total_archived']}\")\n    68→        if stats['by_status']['completed'] > 0:\n    69→            typer.echo(f\"  Completed: {stats['by_status']['completed']}\")\n    70→        if stats['by_status']['expired'] > 0:\n    71→            typer.echo(f\"  Expired: {stats['by_status']['expired']}\")\n    72→        if stats['oldest_archive']:\n    73→            typer.echo(f\"  Oldest: {stats['oldest_archive'][:10]}\")\n    74→        typer.echo()\n    75→\n    76→    # Determine what to archive\n    77→    if all_completed:\n    78→        typer.echo(typer.style(\"Archiving all completed/expired calls...\", fg=typer.colors.YELLOW))\n    79→    else:\n    80→        typer.echo(typer.style(f\"Archiving calls completed more than {days} 