y","/data/cre/workspace/se3.0/.worktrees/openspec-cli-commands/tools/se3_tools/commands/commit.py","/data/cre/workspace/se3.0/.worktrees/openspec-cli-commands/tools/se3_tools/commands/fullcycle.py","/data/cre/workspace/se3.0/.worktrees/openspec-cli-commands/tools/se3_tools/commands/__init__.py","/data/cre/workspace/se3.0/.worktrees/openspec-cli-commands/tools/se3_tools/commands/test_fullcycle.py","/data/cre/workspace/se3.0/.worktrees/openspec-cli-commands/tools/se3_tools/commands/version.py","/data/cre/workspace/se3.0/.worktrees/openspec-cli-commands/tools/se3_tools/commands/init.py","/data/cre/workspace/se3.0/.worktrees/openspec-cli-commands/tools/se3_tools/commands/lint.py","/data/cre/workspace/se3.0/.worktrees/openspec-cli-commands/tools/se3_tools/commands/handoff.py","/data/cre/workspace/se3.0/.worktrees/openspec-cli-commands/tools/se3_tools/commands/start.py","/data/cre/workspace/se3.0/.worktrees/openspec-cli-commands/tools/se3_tools/commands/verify.py","/data/cre/workspace/se3.0/.worktrees/openspec-cli-commands/tools/se3_tools/commands/update.py","/data/cre/workspace/se3.0/.worktrees/openspec-cli-commands/tools/se3_tools/commands/status.py","/data/cre/workspace/se3.0/.worktrees/openspec-cli-commands/tools/se3_tools/commands/sync.py","/data/cre/workspace/se3.0/.worktrees/openspec-cli-commands/tools/se3_tools/commands/work.py"],"durationMs":181,"numFiles":16,"truncated":false}}
