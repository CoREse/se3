→        try:\n    46→            installed = get_installed_se3_version()\n    47→            if installed != \"0.0.0\":\n    48→                typer.echo(f\"Project SE3 version: {installed}\")\n    49→        except Exception:\n    50→            pass\n    51→        raise typer.Exit()\n    52→\n    53→@app.callback()\n    54→def main(\n    55→    ctx: typer.Context,\n    56→    version: bool = typer.Option(\n    57→        False, \"--version\", \"-v\", help=\"Show version information\", callback=_version_callback, is_eager=True\n    58→    ),\n    59→):\n    60→    \"\"\"SE 3.0 framework CLI tools.\"\"\"\n    61→    if ctx.invoked_subcommand is None:\n    62→        typer.echo(ctx.get_help())\n    63→        raise typer.Exit()\n    64→\n    65→\n    66→# Register direct commands\n    67→@app.command(name=\"init\")\n    68→def init_cmd(\n    69→    force: bool = typer.Option(False, \"--force\", \"-f\", help=\"Reinitialize even if already initialized\"),\n    70→    offline: bool = typer.Option(False, \"--offline\", \"-o\", help=\"Use local templates without network\"),\n    71→    with_config: bool = typer.Option(False, \"--with-config\", \"-c\", help=\"Create se3.config.yaml\"),\n    72→    se3_version: str = typer.Option(SE3_FRAMEWORK_VERSION, \"--se3-version\", \"-v\", help=\"Specify SE3 version to use\"),\n    73→):\n    74→    \"\"\"Initialize a new SE 3.0 project.\"\"\"\n    75→    try:\n    76→        initialize_project(force, offline, with_config, se3_version)\n    77→    except Exception as e:\n    78→        typer.echo(\n    79→            typer.style(\n    80→                f\"Error during initialization: {str(e)}\",\n    81→                fg=typer.colors.RED,\n    82→            )\n    83→        )\n    84→        raise typer.Exit(1)\n    85→\n    86→# Register sub-typer commands (complex multi-command tools)\n    87→app.add_typer(lint.app, name=\"lint\", help=\"Lint OpenSpec files\")\n    88→app.add_typer(status.app, name=\"status\", help=\"Check pr